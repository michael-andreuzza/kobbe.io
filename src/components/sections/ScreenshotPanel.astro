---
/**
 * Muted panel a product screenshot rises into from the bottom, cropped by the
 * panel edge with a progressive blur. Used full width on the 12 column grid.
 * An optional spot illustration stands on the screenshot's top edge; its
 * `wobble` layer, drawn on the same canvas, rocks gently on top of it.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Size and position classes go in `class`; it must fit the panel's top padding. */
  spot?: { src: ImageMetadata; class: string; wobble?: ImageMetadata };
  class?: string;
}

const { src, alt, spot, class: className = "" } = Astro.props;
const widths = [
  ...[768, 1280, 1920, 2560].filter((width) => width < src.width),
  src.width,
];
---

<div
  class:list={[
    "bg-muted-surface relative overflow-hidden rounded-lg px-4 pt-12 sm:pt-16",
    className,
  ]}
>
  <div class="relative mx-auto -mb-12 w-full max-w-5xl sm:-mb-16 lg:-mb-24">
    {
      spot && (
        <div class:list={["pointer-events-none absolute bottom-full", spot.class]}>
          <Image src={spot.src} alt="" widths={[160, 320]} sizes="80px" loading="lazy" class="block w-full" />
          {spot.wobble && (
            <Image
              src={spot.wobble}
              alt=""
              widths={[160, 320]}
              sizes="80px"
              loading="lazy"
              class="spot-wobble absolute inset-0 w-full"
            />
          )}
        </div>
      )
    }
    <Image
      src={src}
      alt={alt}
      class="shadow-panel-lifted block w-full rounded-t lg:rounded-t-lg"
      widths={widths}
      sizes="(min-width: 1024px) 1024px, 100vw"
      loading="lazy"
    />
  </div>
  <div class="progressive-blur-edge" aria-hidden="true">
    <div />
    <div />
    <div />
    <div />
    <div />
    <div />
  </div>
</div>

<style is:global>
  .spot-wobble {
    transform-origin: 87.8% 27.3%;
    animation: spot-wobble 3.6s ease-in-out infinite;
  }

  @keyframes spot-wobble {
    0%,
    100% {
      transform: rotate(-6deg);
    }
    50% {
      transform: rotate(6deg) translateX(1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spot-wobble {
      animation: none;
    }
  }
</style>
