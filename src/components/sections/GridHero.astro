---
/**
 * Page opener on the 12 column grid, after Carriera's intro: a two-tone
 * sentence on the left 4 columns (`lead` in ink, `title` muted), the h1 and
 * subtitle on the right 8. Extra content (logos, CTAs) goes in the default
 * slot under the subtitle; the `full` slot spans all 12 columns below.
 */
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";

interface Props {
  lead: string;
  title: string;
  heading: string;
  subtitle?: string;
  class?: string;
}

const { lead, title, heading, subtitle, class: className = "" } = Astro.props;
const bottom = Astro.slots.has("full") ? "pb-24" : "pb-12";
---

<section>
  <SectionGrid lead={lead} title={title} class={`pt-16 lg:pt-24 ${bottom} ${className}`.trim()}>
    <div class="flex flex-col gap-2">
      <Text
        tag="h1"
        variant="displayLG"
        class="font-medium tracking-tight leading-tight text-pretty lg:text-balance"
      >
        {heading}
      </Text>
      {
        subtitle && (
          <Text
            tag="p"
            variant="textBase"
            class="text-muted-foreground max-w-md leading-relaxed text-pretty"
          >
            {subtitle}
          </Text>
        )
      }
    </div>
    {Astro.slots.has("default") && <div><slot /></div>}
    <Fragment slot="full"><slot name="full" /></Fragment>
  </SectionGrid>
</section>
