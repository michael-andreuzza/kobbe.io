---
/**
 * The catalog on the 12 column grid: one section per group with a two-tone
 * sentence on the left 4 columns, the group heading and blurb on the right 8,
 * and the features below as a two column list, each linking to its docs page.
 */
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import { featureGroups } from "@/components/features/features";
---

{
  featureGroups.map((group) => (
    <section>
      <SectionGrid lead={group.lead} title={group.summary} sticky class="py-24">
        <div class="flex flex-col gap-2">
          <Text
            tag="h2"
            variant="displayMD"
            class="font-medium tracking-tight leading-tight text-pretty lg:text-balance"
          >
            {group.title}
          </Text>
          <Text
            tag="p"
            variant="textBase"
            class="text-muted-foreground max-w-md leading-relaxed text-pretty"
          >
            {group.blurb}
          </Text>
        </div>
        <ul class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2" role="list">
          {group.items.map((item) => (
            <li class="border-border border-t pt-6">
              <a href={item.href} class="group block">
                <span class="flex items-center justify-between gap-4">
                  <Text tag="h3" variant="textBase" class="text-foreground font-medium">
                    {item.title}
                  </Text>
                  <HugeiconsIcon
                    icon={ArrowDownRight01Icon}
                    size={16}
                    strokeWidth={1.8}
                    className="text-muted-foreground group-hover:text-foreground shrink-0 transition-colors"
                    aria-hidden="true"
                  />
                </span>
                <Text tag="p" variant="textSM" class="text-muted-foreground mt-2 max-w-xs text-pretty">
                  {item.description}
                </Text>
              </a>
            </li>
          ))}
        </ul>
      </SectionGrid>
    </section>
  ))
}
