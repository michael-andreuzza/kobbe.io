---
/**
 * The catalog in the landing language: one section per group with a sticky
 * intro (eyebrow, lead, blurb) on the left and stacked hairline rows on the
 * right, each linking to the matching docs page (same rows as the homepage).
 */
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import { featureGroups } from "@/components/features/features";
---

<Wrapper variant="default" class="py-12">
  <div class=" space-y-32">
    {
      featureGroups.map((group) => (
        <section class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
          <div class="lg:sticky lg:top-24 lg:self-start">
            <p class="text-muted-foreground text-xs font-medium uppercase">
              {group.eyebrow}
            </p>
            <div class="mt-4 max-w-md space-y-1">
              <p class="text-foreground text-base font-medium text-pretty">
                {group.title}
              </p>
              <p class="text-muted-foreground text-base text-pretty">
                {group.blurb}
              </p>
            </div>
          </div>
          <ul class="border-border border-t">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group border-border grid grid-cols-[1fr_auto] items-center gap-6 border-b py-5"
                >
                  <span class="transition-transform duration-300 group-hover:translate-x-3">
                    <span class="text-foreground block text-base text-pretty sm:text-lg">
                      {item.title}
                    </span>
                    <span class="text-muted-foreground mt-1 block text-base text-pretty">
                      {item.description}
                    </span>
                  </span>
                  <HugeiconsIcon
                    icon={ArrowDownRight01Icon}
                    size={20}
                    strokeWidth={1.8}
                    className="text-foreground"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Wrapper>
