---
/**
 * Plain-list counterpart of FeaturesGrid for feature pages: a sticky intro
 * (title, blurb) on the left and hairline rows on the right, without links.
 * Each group can carry a small label when a page lists more than one.
 */
import Wrapper from "@/components/foundations/containers/Wrapper.astro";

interface Props {
  title: string;
  blurb?: string;
  groups: { label?: string; items: string[] }[];
}

const { title, blurb, groups } = Astro.props;
---

<Wrapper variant="default">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <div class="max-w-md space-y-1">
        <h2 class="text-foreground text-base font-medium text-pretty">
          {title}
        </h2>
        {
          blurb && (
            <p class="text-muted-foreground text-base text-pretty">{blurb}</p>
          )
        }
      </div>
    </div>
    <div class="space-y-12">
      {
        groups.map((group) => (
          <div>
            {group.label && (
              <p class="text-muted-foreground text-sm font-medium">
                {group.label}
              </p>
            )}
            <ul class:list={["border-border border-t", group.label && "mt-3"]}>
              {group.items.map((item) => (
                <li class="border-border text-foreground border-b py-5 text-base font-medium text-pretty sm:text-lg">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</Wrapper>
