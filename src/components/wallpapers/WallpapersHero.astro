---
/**
 * Page opener for /wallpapers on the shared 12 column GridHero, with the
 * download CTA under the subtitle.
 */
import GridHero from "@/components/sections/GridHero.astro";
import { Button } from "@/components/ui/button";
import { WALLPAPERS_DOWNLOAD_URL } from "@/components/wallpapers/wallpapers";
---

<GridHero
  lead="Wallpapers,"
  title="four Åland scenes for your desktop."
  heading="The illustrations from this site, drawn out to 5K"
  subtitle="Each one is a dynamic HEIC that follows macOS light and dark mode, with flat PNGs for everything else. Free, in exchange for your email."
>
  <div class="mt-8 flex flex-wrap gap-3">
    <Button
      variant="muted"
      label="Download the set"
      href={WALLPAPERS_DOWNLOAD_URL}
      external
      arrow
    />
    <Button variant="muted" label="See the scenes" href="#scenes" />
  </div>
</GridHero>
