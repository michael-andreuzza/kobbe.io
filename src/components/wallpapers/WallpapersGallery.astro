---
/**
 * The four scenes with a Light / Dark switch. Both frames of every scene are
 * rendered and the switch only flips a data attribute, so the preview
 * changes instantly and the dark frames are already loaded.
 */
import { Image } from "astro:assets";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import { wallpapers } from "@/components/wallpapers/wallpapers";
const schemes = [
  { id: "light", label: "Light" },
  { id: "dark", label: "Dark" },
] as const;
---
<section data-wallpapers data-scheme="light" id="scenes">
  <SectionGrid
    lead="Day and night,"
    title="every scene in both, switched by macOS."
    class="py-24"
  >
    <div class="flex flex-col gap-2">
      <Text
        tag="h2"
        variant="displayMD"
        class="font-medium tracking-tight leading-tight text-pretty lg:text-balance"
      >
        Flip between them here
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="text-muted-foreground max-w-md leading-relaxed text-pretty"
      >
        The HEIC does it on its own, following your appearance setting,
        including Auto.
      </Text>
    </div>
    <div
      class="bg-muted-surface mt-2 inline-flex w-fit rounded-lg p-1"
      role="group"
      aria-label="Preview appearance"
    >
      {
        schemes.map((scheme) => (
          <button
            type="button"
            data-scheme-button={scheme.id}
            aria-pressed={scheme.id === "light" ? "true" : "false"}
            class="text-muted-foreground aria-pressed:bg-background aria-pressed:text-foreground aria-pressed:shadow-panel hover:text-foreground cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium transition-colors"
          >
            {scheme.label}
          </button>
        ))
      }
    </div>
    <ul
      slot="full"
      class="grid gap-x-8 gap-y-12 md:grid-cols-2 lg:col-span-full lg:grid-cols-subgrid"
      role="list"
    >
      {
        wallpapers.map((wallpaper, index) => (
          <li class="lg:col-span-6">
            <div class="shadow-panel relative aspect-video overflow-hidden rounded-lg">
              <Image
                src={wallpaper.light}
                alt={`${wallpaper.title} wallpaper, light`}
                data-frame="light"
                class="absolute inset-0 size-full object-cover"
                widths={[640, 960, 1280, 1920]}
                sizes="(min-width: 1280px) 608px, (min-width: 768px) 50vw, 100vw"
                loading={index < 2 ? "eager" : "lazy"}
              />
              <Image
                src={wallpaper.dark}
                alt={`${wallpaper.title} wallpaper, dark`}
                data-frame="dark"
                class="absolute inset-0 size-full object-cover"
                widths={[640, 960, 1280, 1920]}
                sizes="(min-width: 1280px) 608px, (min-width: 768px) 50vw, 100vw"
                loading="lazy"
              />
            </div>
            <Text tag="h3" variant="textBase" class="mt-6 font-medium">
              {wallpaper.title}
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="text-muted-foreground mt-1 max-w-lg text-pretty"
            >
              {wallpaper.blurb}
            </Text>
          </li>
        ))
      }
    </ul>
  </SectionGrid>
</section>
<style>
  [data-scheme="light"] [data-frame="dark"],
  [data-scheme="dark"] [data-frame="light"] {
    display: none;
  }
</style>
<script>
  function bindGallery() {
    const root = document.querySelector<HTMLElement>("[data-wallpapers]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";
    const set = (scheme: string) => {
      root.dataset.scheme = scheme;
      root
        .querySelectorAll<HTMLButtonElement>("[data-scheme-button]")
        .forEach((button) => {
          button.setAttribute(
            "aria-pressed",
            button.dataset.schemeButton === scheme ? "true" : "false",
          );
        });
    };
    // Start on whatever the visitor's own system is showing.
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      set("dark");
    }
    root
      .querySelectorAll<HTMLButtonElement>("[data-scheme-button]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          set(button.dataset.schemeButton ?? "light");
        });
      });
  }
  bindGallery();
  document.addEventListener("astro:page-load", bindGallery);
</script>
