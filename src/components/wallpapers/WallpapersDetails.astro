---
/**
 * What is in the download and how to install it, as two grid sections: the
 * file facts as a list, the install steps as three cards.
 */
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import {
  installSteps,
  wallpaperFacts,
} from "@/components/wallpapers/wallpapers";
---

<section>
  <SectionGrid
    lead="The download,"
    title="four scenes, twelve files, one zip."
    class="py-24"
  >
    <div class="flex flex-col gap-2">
      <Text
        tag="h2"
        variant="displayMD"
        class="font-medium tracking-tight leading-tight text-pretty lg:text-balance"
      >
        What comes in the zip
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="text-muted-foreground max-w-md leading-relaxed text-pretty"
      >
        Four dynamic HEICs and the light and dark PNG behind each one. No
        watermark, no account, use them wherever you like.
      </Text>
    </div>
    <ul class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2" role="list">
      {
        wallpaperFacts.map((fact) => (
          <li class="border-border border-t pt-6">
            <Text tag="h3" variant="textBase" class="font-medium">
              {fact.title}
            </Text>
            <Text
              tag="p"
              variant="textSM"
              class="text-muted-foreground mt-1 max-w-xs text-pretty"
            >
              {fact.description}
            </Text>
          </li>
        ))
      }
    </ul>
  </SectionGrid>
</section>

<section>
  <SectionGrid
    lead="Install,"
    title="set it once and macOS does the switching."
    class="py-24"
  >
    <div class="flex flex-col gap-2">
      <Text
        tag="h2"
        variant="displayMD"
        class="font-medium tracking-tight leading-tight text-pretty lg:text-balance"
      >
        Installing on macOS
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="text-muted-foreground max-w-md leading-relaxed text-pretty"
      >
        The HEIC carries both frames. Once it is set to Dynamic, macOS switches
        them together with your appearance, including Auto.
      </Text>
    </div>
    <ol
      slot="full"
      class="grid gap-4 md:grid-cols-3 lg:col-span-full lg:grid-cols-subgrid lg:gap-x-8"
      role="list"
    >
      {
        installSteps.map((step, index) => (
          <li class="bg-muted-surface flex flex-col justify-between gap-12 rounded-lg p-6 sm:p-8 lg:col-span-4">
            <Text
              tag="span"
              variant="textSM"
              class="text-muted-foreground tabular-nums"
            >
              Step {index + 1}
            </Text>
            <div>
              <Text tag="h3" variant="textBase" class="font-medium">
                {step.title}
              </Text>
              <Text
                tag="p"
                variant="textSM"
                class="text-muted-foreground mt-1 text-pretty"
              >
                {step.body}
              </Text>
            </div>
          </li>
        ))
      }
    </ol>
  </SectionGrid>
</section>
