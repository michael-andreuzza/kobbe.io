---
/**
 * Small text link with a chevron. On hover the label rolls up to a copy of
 * itself and the chevron nudges right.
 */
import { ArrowRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

interface Props {
  label: string;
  href: string;
  class?: string;
}

const { label, href, class: className = "" } = Astro.props;
const move =
  "transition-transform duration-500 ease-out motion-reduce:transition-none";
---

<a
  href={href}
  class:list={[
    "group/roll text-muted-foreground hover:text-foreground inline-flex items-center gap-0.5 text-sm leading-tight transition-colors duration-300",
    className,
  ]}
>
  <span class="relative inline-flex overflow-hidden">
    <span class:list={[move, "group-hover/roll:-translate-y-full"]}>{label}</span>
    <span
      class:list={[move, "absolute inset-0 translate-y-full group-hover/roll:translate-y-0"]}
      aria-hidden="true"
    >
      {label}
    </span>
  </span>
  <HugeiconsIcon
    icon={ArrowRight01Icon}
    size={14}
    strokeWidth={1.8}
    className={`${move} group-hover/roll:translate-x-0.5`}
    aria-hidden="true"
  />
</a>
