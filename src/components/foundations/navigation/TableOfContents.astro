---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<aside
  class={`absolute inset-y-4 right-4 z-50 hidden w-72 xl:block ${className}`.trim()}
>
  <div
    class="uninverted bg-background h-full w-full space-y-8 overflow-y-auto rounded-md p-4"
  >
    <nav aria-label="Table of contents">
      <h3 class="text-foreground text-xs font-semibold tracking-wide uppercase">
        On this page
      </h3>
      <ol data-toc-list role="list" class="mt-3 flex flex-col gap-1">
        <li data-toc-empty class="text-foreground text-sm tracking-tight">
          No sections on this page.
        </li>
      </ol>
    </nav>
  </div>
</aside>
