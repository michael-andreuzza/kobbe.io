---
/**
 * A miniature of Agent access → Create token: each scope is a switch with
 * the app's label and description, read access on, deletes off.
 */
const scopes = [
  {
    label: "Read analytics",
    description: "Traffic, sources, pages, goals, and funnels.",
    on: true,
  },
  {
    label: "Read revenue",
    description: "Revenue summaries and attribution data.",
    on: true,
  },
  {
    label: "Manage sites",
    description: "Create and update sites, goals, and funnels.",
    on: true,
  },
  {
    label: "Delete/reset sites",
    description: "Destructive actions, always confirmed.",
    on: false,
    danger: true,
  },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="border-border/60 border-b px-4 pt-3.5 pb-3">
    <span class="text-foreground text-sm font-medium">Create token</span>
  </div>
  <ul class="px-4 py-1 text-xs">
    {
      scopes.map((scope, i) => (
        <li
          class:list={[
            "flex items-center gap-3 py-2.5",
            i > 0 && "border-border/60 border-t",
          ]}
        >
          <span class="flex min-w-0 flex-1 flex-col">
            <span
              class:list={[
                "font-medium",
                scope.danger ? "text-destructive" : "text-foreground",
              ]}
            >
              {scope.label}
            </span>
            <span class="text-muted-foreground truncate">
              {scope.description}
            </span>
          </span>
          <span
            class:list={[
              "flex h-5 w-8 shrink-0 items-center rounded-full p-0.5",
              scope.on ? "bg-foreground justify-end" : "bg-border",
            ]}
          >
            <span class="bg-background size-4 rounded-full shadow-xs" />
          </span>
        </li>
      ))
    }
  </ul>
</div>
