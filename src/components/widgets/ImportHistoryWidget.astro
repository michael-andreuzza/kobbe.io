---
/**
 * A miniature of the dashboard after an import: the metric tabs with
 * Visitors picked, then the traffic chart as one continuous line across
 * imported history and live data, styled like the app's chart.
 */
const kpis = [
  { label: "Visitors", value: "48,210", hint: "+18%", active: true },
  { label: "Visits", value: "61,930", hint: "+15%", active: false },
];

const values = [
  3100, 3400, 3300, 3700, 3600, 3900, 3800, 4200, 4400, 4300, 4900, 5610,
];
const xLabels = [
  { index: 0, label: "Nov" },
  { index: 6, label: "May" },
  { index: 11, label: "Oct" },
];
const yMax = 6000;

const width = 256;
const plotWidth = width;
const top = 6;
const plotHeight = 84;
const height = top + plotHeight + 18;

const pts = values.map((value, i) => ({
  x: (i / (values.length - 1)) * plotWidth,
  y: top + plotHeight - (value / yMax) * plotHeight,
}));

// Monotone cubic interpolation, the same curve the app's chart uses.
const slopes = pts.slice(0, -1).map((p, i) => {
  const next = pts[i + 1]!;
  return (next.y - p.y) / (next.x - p.x);
});
const tangents = pts.map((_, i) => {
  if (i === 0) return slopes[0]!;
  if (i === pts.length - 1) return slopes[i - 1]!;
  const a = slopes[i - 1]!;
  const b = slopes[i]!;
  const p = (a + b) / 2;
  return (
    (Math.sign(a) + Math.sign(b)) *
    Math.min(Math.abs(a), Math.abs(b), 0.5 * Math.abs(p))
  );
});
const line = pts
  .map((p, i) => {
    if (i === 0) return `M${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
    const prev = pts[i - 1]!;
    const dx = (p.x - prev.x) / 3;
    const c1 = { x: prev.x + dx, y: prev.y + tangents[i - 1]! * dx };
    const c2 = { x: p.x - dx, y: p.y - tangents[i]! * dx };
    return `C${c1.x.toFixed(1)} ${c1.y.toFixed(1)} ${c2.x.toFixed(1)} ${c2.y.toFixed(1)} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
  })
  .join(" ");
const baseline = top + plotHeight;
const area = `${line} L${plotWidth} ${baseline} L0 ${baseline} Z`;
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="bg-muted-surface m-2 grid grid-cols-2 rounded-md p-1">
    {
      kpis.map((kpi) => (
        <div
          class:list={[
            "flex flex-col gap-1 rounded-md px-3 py-2.5",
            kpi.active && "bg-background shadow-xs",
          ]}
        >
          <div class="flex items-baseline justify-between gap-2 text-xs leading-tight font-medium">
            <span class="text-muted-foreground truncate">{kpi.label}</span>
            <span class="text-success shrink-0 tabular-nums">{kpi.hint}</span>
          </div>
          <span
            class:list={[
              "text-base leading-tight font-semibold tracking-tight tabular-nums",
              kpi.active ? "text-foreground" : "text-muted-foreground",
            ]}
          >
            {kpi.value}
          </span>
        </div>
      ))
    }
  </div>
  <div class="px-4 pt-2 pb-3.5">
    <svg
      class="w-full overflow-visible"
      viewBox={`0 0 ${width} ${height}`}
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="import-history-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--color-brand)" stop-opacity="0.1"
          ></stop>
          <stop offset="100%" stop-color="var(--color-brand)" stop-opacity="0"
          ></stop>
        </linearGradient>
      </defs>
      <line
        x1="0"
        x2={width}
        y1={baseline}
        y2={baseline}
        class="stroke-border/60"
        stroke-width="1"></line>
      <path d={area} fill="url(#import-history-fill)"></path>
      <path
        d={line}
        fill="none"
        stroke="var(--color-brand)"
        stroke-width="1.5"
        stroke-linecap="round"></path>
      {
        xLabels.map((tick) => (
          <text
            x={pts[tick.index]!.x}
            y={height - 2}
            text-anchor={
              tick.index === 0
                ? "start"
                : tick.index === values.length - 1
                  ? "end"
                  : "middle"
            }
            class="fill-muted-foreground"
            font-size="11"
          >
            {tick.label}
          </text>
        ))
      }
    </svg>
  </div>
</div>
