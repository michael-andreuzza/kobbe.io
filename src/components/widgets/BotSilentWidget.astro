---
/**
 * What a filtered bot sees versus what reaches your stats: a normal success
 * response on one side, nothing added on the other.
 */
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg p-5">
  <span class="text-muted-foreground text-xs">Request from</span>
  <span class="text-foreground mt-0.5 text-sm font-medium">python-requests</span>
  <div class="mt-5 grid grid-cols-2 gap-2 text-xs">
    <div class="bg-muted-surface flex flex-col rounded-md p-3">
      <span class="text-muted-foreground">Bot sees</span>
      <span class="text-foreground mt-1 text-base font-medium tabular-nums">
        200 OK
      </span>
    </div>
    <div class="bg-muted-surface flex flex-col rounded-md p-3">
      <span class="text-muted-foreground">Your stats</span>
      <span class="text-foreground mt-1 text-base font-medium tabular-nums">
        +0
      </span>
    </div>
  </div>
  <span class="text-muted-foreground mt-5 text-xs text-balance">
    Only the daily Automated client count goes up.
  </span>
</div>
