---
/**
 * What a filtered bot sees versus what reaches your stats: a normal success
 * response on one side, nothing added on the other.
 */
const lines = [
  { label: "Bot sees", value: "200 OK", success: true },
  { label: "Your stats", value: "+0", success: false },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="border-border/60 border-b px-4 pt-3.5 pb-3">
    <span class="text-muted-foreground block text-xs">Request from</span>
    <span class="text-foreground mt-0.5 block text-sm font-medium">
      python-requests
    </span>
  </div>
  <div class="px-4 pt-1 pb-3 text-xs">
    <ul>
      {
        lines.map((line, i) => (
          <li
            class:list={[
              "flex items-center justify-between py-2.5",
              i > 0 && "border-border/60 border-t",
            ]}
          >
            <span class="text-muted-foreground">{line.label}</span>
            <span
              class:list={[
                "flex h-6 items-center rounded-sm px-2 font-medium tabular-nums",
                line.success
                  ? "bg-success/5 text-success"
                  : "bg-muted-surface text-foreground",
              ]}
            >
              {line.value}
            </span>
          </li>
        ))
      }
    </ul>
    <span class="text-muted-foreground mt-1 block text-balance">
      Only the daily Automated client count goes up.
    </span>
  </div>
</div>
