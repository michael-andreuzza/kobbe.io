---
/**
 * A miniature of the import merge mode picker: the select open on its three
 * modes with Fill gaps only picked, and its description from the app below.
 */
import { ArrowDown01Icon, Tick02Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

const modes = [
  { name: "Fill gaps only", on: true },
  { name: "Selected date range", on: false },
  { name: "Replace date range", on: false },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="border-border/60 border-b px-4 pt-3.5 pb-3">
    <span class="text-foreground text-sm font-medium">Import history</span>
  </div>
  <div class="flex flex-col px-4 py-3.5 text-xs">
    <span
      class="border-foreground/40 text-foreground flex h-8 items-center rounded-md border px-2.5 shadow-xs"
    >
      Fill gaps only
      <HugeiconsIcon
        icon={ArrowDown01Icon}
        size={12}
        strokeWidth={1.8}
        className="text-muted-foreground ml-auto"
      />
    </span>
    <ul
      class="bg-background shadow-panel-lifted mt-1.5 flex flex-col rounded-lg p-1"
    >
      {
        modes.map((mode) => (
          <li
            class:list={[
              "text-foreground flex h-8 items-center rounded-md px-2",
              mode.on && "bg-muted-surface",
            ]}
          >
            <span class="flex-1">{mode.name}</span>
            {mode.on && (
              <HugeiconsIcon icon={Tick02Icon} size={13} strokeWidth={2} />
            )}
          </li>
        ))
      }
    </ul>
    <p class="text-muted-foreground mt-3 text-balance">
      Import history before your first pageview; skip existing days.
    </p>
  </div>
</div>
