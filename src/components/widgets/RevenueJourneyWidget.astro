---
/**
 * One sale traced back through the visit that led to it: where the visitor
 * came from, the pages on the way, and the payment at the end.
 */
const steps = [
  { label: "Came from x.com", detail: "Mon" },
  { label: "Read /blog/launch", detail: "Mon" },
  { label: "Opened /pricing", detail: "Wed" },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg p-5">
  <span class="text-muted-foreground text-xs">Pro plan, paid Wed</span>
  <span class="text-foreground mt-1 text-2xl font-medium tracking-tight tabular-nums">
    $99
  </span>
  <ol class="mt-5 flex flex-col gap-3">
    {
      steps.map((step) => (
        <li class="flex items-center gap-3 text-xs">
          <span class="bg-muted-foreground size-1.5 shrink-0 rounded-full" />
          <span class="text-foreground font-medium">{step.label}</span>
          <span class="text-muted-foreground ml-auto">{step.detail}</span>
        </li>
      ))
    }
  </ol>
  <span
    class="bg-muted-surface mt-5 flex items-center justify-between rounded-md p-3 text-xs"
  >
    <span class="text-muted-foreground">First source</span>
    <span class="text-foreground font-medium">x.com</span>
  </span>
</div>
