---
/**
 * A miniature of the JavaScript errors card once conversions are set up: its
 * description compares the conversion rate of visitors who hit an error with
 * everyone else, the same sentence the dashboard shows.
 */
const errors = [
  { message: "Cannot read properties of undefined", visitors: "41" },
  { message: "Failed to fetch", visitors: "17" },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="border-border/60 border-b px-4 pt-3.5 pb-3">
    <span class="text-foreground block text-sm font-medium">
      JavaScript errors
    </span>
    <span class="text-muted-foreground mt-0.5 block text-xs">
      Visitors who hit an error converted at 1.2%, vs 4.8% for everyone else
    </span>
  </div>
  <div class="px-4 pt-3 pb-4 text-xs">
    <div class="text-muted-foreground flex gap-3 pb-2">
      <span class="flex-1">Error</span>
      <span class="w-12 text-right">Visitors</span>
    </div>
    <ul>
      {
        errors.map((error) => (
          <li class="border-border/60 flex items-center gap-3 border-t py-2">
            <span class="text-foreground min-w-0 flex-1 truncate font-medium">
              {error.message}
            </span>
            <span class="text-foreground w-12 text-right tabular-nums">
              {error.visitors}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
