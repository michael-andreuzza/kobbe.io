---
/**
 * The JavaScript errors card once conversions are set up: its description
 * compares the conversion rate of visitors who hit an error with everyone
 * else, the same sentence the dashboard shows.
 */
const stats = [
  { label: "Hit an error", value: "1.2%" },
  { label: "Everyone else", value: "4.8%" },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg p-5">
  <span class="text-foreground text-sm font-medium">JavaScript errors</span>
  <span class="text-muted-foreground mt-0.5 text-xs">
    Visitors who hit an error converted at 1.2%, vs 4.8% for everyone else
  </span>
  <dl class="mt-5 grid grid-cols-2 gap-2 text-xs">
    {
      stats.map((stat) => (
        <div class="bg-muted-surface flex flex-col rounded-md p-3">
          <dt class="text-muted-foreground">{stat.label}</dt>
          <dd class="text-foreground mt-0.5 text-sm font-medium">{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
