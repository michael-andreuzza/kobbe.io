---
/**
 * A custom first-party collect hostname: the subdomain, its CNAME record, and
 * the verified state once DNS and SSL check out.
 */
import { Tick02Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

const checks = ["DNS", "SSL"];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg p-5">
  <div class="flex items-center justify-between gap-4">
    <span class="text-foreground text-sm font-medium">First-party collect</span>
    <span class="text-muted-foreground text-xs">Active</span>
  </div>
  <div class="bg-muted-surface mt-5 flex flex-col rounded-md p-3 text-xs">
    <span class="text-muted-foreground">CNAME</span>
    <span class="text-foreground mt-0.5 font-medium">data.example.com</span>
  </div>
  <ul class="mt-4 flex flex-col gap-2 text-xs">
    {
      checks.map((check) => (
        <li class="flex items-center gap-2">
          <span class="bg-foreground text-background flex size-4 shrink-0 items-center justify-center rounded-full">
            <HugeiconsIcon icon={Tick02Icon} size={10} strokeWidth={2.4} />
          </span>
          <span class="text-foreground font-medium">{check}</span>
          <span class="text-muted-foreground ml-auto">Verified</span>
        </li>
      ))
    }
  </ul>
</div>
