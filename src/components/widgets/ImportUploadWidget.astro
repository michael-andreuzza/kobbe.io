---
import type { ImageMetadata } from "astro";

import ImportUploadDemo from "./ImportUploadDemo";

const logos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/brands/plausible.svg",
  { eager: true },
);
const plausible = logos["/src/images/brands/plausible.svg"]!.default;
---

<ImportUploadDemo client:visible logoSrc={plausible.src} />
