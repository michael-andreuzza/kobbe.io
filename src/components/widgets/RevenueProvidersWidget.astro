---
/**
 * Revenue sources in site settings: two payment providers connected through
 * their webhooks, one more ready to connect.
 */
import type { ImageMetadata } from "astro";

import BrandLogo from "@/components/foundations/BrandLogo.astro";

const logos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/brands/*.svg",
  { eager: true },
);
const logo = (file: string) => logos[`/src/images/brands/${file}`]!.default;

const providers = [
  { label: "Stripe", file: "stripe.svg", connected: true },
  { label: "Polar", file: "polar.svg", connected: true },
  { label: "Paddle", file: "paddle.svg", connected: false },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg p-5">
  <span class="text-foreground text-sm font-medium">Revenue sources</span>
  <span class="text-muted-foreground mt-0.5 text-xs">Payment webhooks</span>
  <ul class="mt-5 flex flex-col gap-1">
    {
      providers.map((provider) => (
        <li
          class:list={[
            "flex items-center gap-3 rounded-md p-2.5",
            provider.connected && "bg-muted-surface",
          ]}
        >
          <BrandLogo
            src={logo(provider.file).src}
            alt=""
            class="size-5 rounded-sm object-contain"
            width={20}
            height={20}
          />
          <span class="text-foreground text-sm font-medium">
            {provider.label}
          </span>
          <span class="text-muted-foreground ml-auto text-xs">
            {provider.connected ? "Connected" : "Connect"}
          </span>
        </li>
      ))
    }
  </ul>
</div>
