---
/**
 * A miniature of the browser DevTools Application panel on a site running
 * the default tracker: cookies, local storage, and session storage all empty.
 */
const tabs = ["Elements", "Console", "Network", "Application"];
const stores = [
  { name: "Cookies", active: true },
  { name: "Local storage", active: false },
  { name: "Session storage", active: false },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="border-border/60 flex gap-3 border-b px-4 pt-3 text-xs">
    {
      tabs.map((tab) => (
        <span
          class:list={[
            "-mb-px border-b pb-2.5",
            tab === "Application"
              ? "border-foreground text-foreground font-medium"
              : "text-muted-foreground border-transparent",
          ]}
        >
          {tab}
        </span>
      ))
    }
  </div>
  <div class="flex text-xs">
    <ul
      class="border-border/60 flex w-28 shrink-0 flex-col gap-0.5 border-r p-2"
    >
      <li class="text-muted-foreground px-1.5 pt-0.5 pb-1">Storage</li>
      {
        stores.map((store) => (
          <li
            class:list={[
              "rounded-md px-1.5 py-1",
              store.active
                ? "bg-muted-surface text-foreground font-medium"
                : "text-muted-foreground",
            ]}
          >
            {store.name}
          </li>
        ))
      }
    </ul>
    <div class="flex min-w-0 flex-1 flex-col">
      <div
        class="border-border/60 text-muted-foreground flex border-b px-3 py-2"
      >
        <span class="flex-1">Name</span>
        <span class="w-14">Value</span>
      </div>
      <div
        class="flex flex-1 flex-col items-center justify-center px-3 py-8 text-center"
      >
        <span class="text-foreground font-medium">No cookies</span>
        <span class="text-muted-foreground mt-0.5">https://example.com</span>
      </div>
    </div>
  </div>
</div>
