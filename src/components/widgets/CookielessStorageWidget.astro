---
/**
 * What the default tracker leaves in a visitor's browser: no cookies, no
 * storage used for measurement, no fingerprinting.
 */
const items = ["Cookies", "localStorage", "sessionStorage", "Fingerprint"];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg p-5">
  <span class="text-muted-foreground text-xs">Left in the browser</span>
  <span class="text-foreground mt-1 text-2xl font-medium tracking-tight tabular-nums">
    0 items
  </span>
  <ul class="mt-5 flex flex-col gap-2 text-xs">
    {
      items.map((item) => (
        <li class="flex items-center justify-between gap-4">
          <span class="text-foreground font-medium">{item}</span>
          <span class="text-muted-foreground">None</span>
        </li>
      ))
    }
  </ul>
</div>
