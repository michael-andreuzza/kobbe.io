---
/**
 * A miniature of the revenue dashboard: the summary strip with refunds taken
 * off gross, then the Recent refunds table they came from.
 */
const kpis = [
  { label: "Gross", value: "$4,820" },
  { label: "Refunds", value: "$180" },
  { label: "Net", value: "$4,640" },
];

const refunds = [
  { date: "Oct 28", product: "Pro plan", amount: "$99" },
  { date: "Oct 21", product: "Starter plan", amount: "$81" },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <dl
    class="bg-muted-surface m-2 grid grid-cols-3 gap-2 rounded-md px-3 py-3 text-xs"
  >
    {
      kpis.map((kpi) => (
        <div class="flex flex-col">
          <dt class="text-muted-foreground">{kpi.label}</dt>
          <dd class="text-foreground mt-0.5 text-sm font-medium tabular-nums">
            {kpi.value}
          </dd>
        </div>
      ))
    }
  </dl>
  <div class="border-border/60 border-y px-4 pt-2.5 pb-2.5">
    <span class="text-foreground text-sm font-medium">Recent refunds</span>
  </div>
  <div class="px-4 pt-3 pb-4 text-xs">
    <div class="text-muted-foreground flex pb-2">
      <span class="w-14">Date</span>
      <span class="flex-1">Product</span>
      <span class="w-12 text-right">Amount</span>
    </div>
    <ul>
      {
        refunds.map((refund) => (
          <li class="border-border/60 flex items-center border-t py-2">
            <span class="text-foreground w-14">{refund.date}</span>
            <span class="text-foreground flex-1 truncate">
              {refund.product}
            </span>
            <span class="text-foreground w-12 text-right font-medium tabular-nums">
              {refund.amount}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
