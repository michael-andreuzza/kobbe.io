---
/**
 * A miniature of the app's Active conversions table: the built-in presets,
 * three switched on, tracked by the script without any extra code.
 */
const conversions = [
  { name: "Contact click", on: true },
  { name: "Messaging click", on: true },
  { name: "Outbound link", on: false },
  { name: "Form submit", on: true },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="border-border/60 border-b px-4 pt-3.5 pb-3">
    <span class="text-foreground text-sm font-medium">Active conversions</span>
  </div>
  <div class="px-4 py-3 text-xs">
    <div class="text-muted-foreground flex justify-between pb-2">
      <span>Name</span>
      <span>Enabled</span>
    </div>
    <ul class="flex flex-col">
      {
        conversions.map((conversion) => (
          <li class="border-border/60 flex items-center justify-between border-t py-2">
            <span class="text-foreground font-medium">{conversion.name}</span>
            <span
              class:list={[
                "flex h-6 items-center rounded-sm px-2",
                conversion.on
                  ? "bg-success/5 text-success"
                  : "bg-muted-surface text-muted-foreground",
              ]}
            >
              {conversion.on ? "On" : "Off"}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
