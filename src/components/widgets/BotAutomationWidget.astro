---
/**
 * A headless browser that looks like a normal visitor: everything checks out
 * except the navigator.webdriver flag the tracker reports, so it is dropped
 * as browser automation.
 */
const details = [
  { label: "Browser", value: "Chrome 141" },
  { label: "OS", value: "macOS" },
  { label: "User agent", value: "Looks normal" },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg p-5">
  <div class="flex items-center justify-between gap-4">
    <span class="text-foreground text-sm font-medium">Incoming visit</span>
    <span class="bg-foreground text-background rounded-full px-2 py-0.5 text-xs font-medium">
      Filtered
    </span>
  </div>
  <dl class="mt-5 flex flex-col gap-2 text-xs">
    {
      details.map((detail) => (
        <div class="flex items-center justify-between gap-4">
          <dt class="text-muted-foreground">{detail.label}</dt>
          <dd class="text-foreground font-medium">{detail.value}</dd>
        </div>
      ))
    }
  </dl>
  <div
    class="bg-muted-surface mt-5 flex items-center justify-between gap-4 rounded-md p-3 text-xs"
  >
    <span class="text-muted-foreground">navigator.webdriver</span>
    <span class="text-foreground font-medium">true</span>
  </div>
  <span class="text-muted-foreground mt-3 text-xs">
    Dropped as browser automation
  </span>
</div>
