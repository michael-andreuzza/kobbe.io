---
/**
 * A miniature of the dashboard's JavaScript errors card: errors grouped by
 * message and file, with where they happen most, visitors, and count.
 */
const errors = [
  {
    message: "Cannot read properties of undefined",
    detail: "checkout.js:118 on /checkout, mostly Safari",
    visitors: "41",
    count: "96",
  },
  {
    message: "Failed to fetch",
    detail: "app.js:92 on /pricing, mostly Chrome",
    visitors: "17",
    count: "23",
  },
  {
    message: "stripe is not defined",
    detail: "pay.js:12 on /checkout, mostly Firefox",
    visitors: "6",
    count: "6",
  },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="border-border/60 border-b px-4 pt-3.5 pb-3">
    <span class="text-foreground block text-sm font-medium">
      JavaScript errors
    </span>
    <span class="text-muted-foreground mt-0.5 block text-xs">
      64 visitors hit an error, last 7 days
    </span>
  </div>
  <div class="px-4 pt-3 pb-4 text-xs">
    <div class="text-muted-foreground flex gap-3 pb-2">
      <span class="flex-1">Error</span>
      <span class="w-12 text-right">Visitors</span>
      <span class="w-9 text-right">Count</span>
    </div>
    <ul>
      {
        errors.map((error) => (
          <li class="border-border/60 flex items-start gap-3 border-t py-2">
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="text-foreground truncate font-medium">
                {error.message}
              </span>
              <span class="text-muted-foreground truncate">{error.detail}</span>
            </span>
            <span class="text-foreground w-12 text-right tabular-nums">
              {error.visitors}
            </span>
            <span class="text-foreground w-9 text-right tabular-nums">
              {error.count}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
