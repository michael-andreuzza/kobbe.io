---
/**
 * How visitors are judged by where they connect from: VPN and iCloud Private
 * Relay users count, a rented cloud server does not.
 */
const visitors = [
  { label: "Safari", network: "iCloud Private Relay", counted: true },
  { label: "Firefox", network: "Consumer VPN", counted: true },
  { label: "Scraper", network: "AWS server", counted: false },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="border-border/60 border-b px-4 pt-3.5 pb-3">
    <span class="text-foreground block text-sm font-medium">Who counts</span>
    <span class="text-muted-foreground mt-0.5 block text-xs">
      By where they connect from
    </span>
  </div>
  <div class="px-4 pt-3 pb-4 text-xs">
    <div class="text-muted-foreground flex pb-2">
      <span class="flex-1">Visitor</span>
      <span>Status</span>
    </div>
    <ul>
      {
        visitors.map((visitor) => (
          <li class="border-border/60 flex items-center gap-3 border-t py-2">
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="text-foreground font-medium">{visitor.label}</span>
              <span class="text-muted-foreground truncate">
                {visitor.network}
              </span>
            </span>
            <span
              class:list={[
                "flex h-6 items-center rounded-sm px-2",
                visitor.counted
                  ? "bg-success/5 text-success"
                  : "bg-muted-surface text-muted-foreground",
              ]}
            >
              {visitor.counted ? "Counted" : "Filtered"}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
