---
/**
 * The same visitor on two days gets two unrelated anonymous hashes, because
 * the secret behind them rotates daily: uniques count, profiles never form.
 */
const days = [
  { day: "Mon, Oct 26", hash: "3f9a…c210" },
  { day: "Tue, Oct 27", hash: "b72e…04dd" },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div class="border-border/60 flex flex-col border-b px-4 pt-3.5 pb-3">
    <span class="text-foreground text-sm font-medium">Same visitor</span>
    <span class="text-muted-foreground mt-0.5 text-xs">
      Anonymous daily hash
    </span>
  </div>
  <div class="flex flex-col px-4 py-3 text-xs">
    <div class="text-muted-foreground flex pb-2">
      <span class="flex-1">Day</span>
      <span>Hash</span>
    </div>
    {
      days.map((entry) => (
        <div class="border-border/60 flex items-center border-t py-2">
          <span class="text-foreground flex-1 font-medium">{entry.day}</span>
          <span class="text-foreground tabular-nums">{entry.hash}</span>
        </div>
      ))
    }
    <div class="border-border/60 flex items-center border-t pt-2.5">
      <span class="text-muted-foreground flex-1">Daily secret</span>
      <span class="text-success font-medium">Rotated</span>
    </div>
  </div>
</div>
