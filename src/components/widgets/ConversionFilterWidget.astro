---
/**
 * A miniature of the dashboard narrowed to one conversion: the top bar's
 * conversion filter set to Form submit, then the numbers for only the
 * visitors who triggered it.
 */
import { ArrowDown01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

const stats = [
  { label: "Visitors", value: "312" },
  { label: "Top source", value: "x.com" },
  { label: "Top page", value: "/pricing" },
];
---

<div class="bg-background shadow-panel-lifted flex w-72 flex-col rounded-lg">
  <div
    class="border-border/60 flex items-center justify-between border-b px-4 py-2.5"
  >
    <span class="text-foreground text-sm font-medium">kobbe.io</span>
    <span
      class="border-border text-foreground flex h-7 items-center gap-1.5 rounded-md border px-2.5 text-xs font-medium shadow-xs"
    >
      Form submit
      <HugeiconsIcon
        icon={ArrowDown01Icon}
        size={12}
        strokeWidth={1.8}
        className="text-muted-foreground"
      />
    </span>
  </div>
  <dl class="grid grid-cols-3 gap-2 px-4 py-3.5 text-xs">
    {
      stats.map((stat) => (
        <div class="flex flex-col">
          <dt class="text-muted-foreground">{stat.label}</dt>
          <dd class="text-foreground mt-0.5 text-sm font-medium">
            {stat.value}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
