---
import { buttonVariants } from "@/components/ui/button";
import { DatePicker } from "@/components/ui/date-picker";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { cn } from "@/lib/utils";

interface Props {
  effectiveDateDefault: string;
}

const { effectiveDateDefault } = Astro.props;
---

<section class="not-prose no-print mt-8 space-y-6">
  <p class="text-muted-foreground text-sm leading-relaxed">
    Part of our <a
      href="/legal/terms"
      class="text-foreground decoration-border hover:decoration-foreground underline underline-offset-2"
      >Terms</a
    >. Using the hosted service at
    <a
      href="https://app.kobbe.io"
      class="text-foreground decoration-border hover:decoration-foreground underline underline-offset-2"
      >app.kobbe.io</a
    >
    accepts this DPA as posted here. Optionally add your details and use <strong
      >Download PDF</strong
    > → Save as PDF for records only.
  </p>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="space-y-2 sm:col-span-2">
      <Label htmlFor="dpa-in-company">Customer legal name</Label>
      <Input
        id="dpa-in-company"
        type="text"
        autoComplete="organization"
        placeholder="Example Corp Oy"
      />
    </div>
    <div class="space-y-2">
      <Label htmlFor="dpa-in-name">Signatory name</Label>
      <Input
        id="dpa-in-name"
        type="text"
        autoComplete="name"
        placeholder="Jane Doe"
      />
    </div>
    <div class="space-y-2">
      <Label htmlFor="dpa-in-title">Signatory title</Label>
      <Input
        id="dpa-in-title"
        type="text"
        autoComplete="organization-title"
        placeholder="Founder"
      />
    </div>
    <div class="space-y-2 sm:col-span-2">
      <Label htmlFor="dpa-in-country">Country / region</Label>
      <Input
        id="dpa-in-country"
        type="text"
        autoComplete="country-name"
        placeholder="Finland"
      />
    </div>
    <div class="space-y-2 sm:col-span-2">
      <Label htmlFor="dpa-in-address">Address</Label>
      <Textarea
        id="dpa-in-address"
        rows={2}
        autoComplete="street-address"
        placeholder="Street, city, postal code"
      />
    </div>
    <div class="space-y-2">
      <span class="text-foreground flex text-xs leading-none font-medium select-none"
        >Effective date</span
      >
      <DatePicker
        client:load
        id="dpa-in-date"
        defaultValue={effectiveDateDefault}
      />
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <button
      type="button"
      id="dpa-print-btn"
      class={cn(buttonVariants({ variant: "secondary", size: "xs" }))}
    >
      Download PDF
    </button>
    <p class="text-muted-foreground text-xs">
      PDF is optional (for records or procurement). Involve your counsel for
      enterprise reviews if needed.
    </p>
  </div>
</section>

<style is:global>
  @media print {
    .no-print,
    /* Site chrome: the marketing sidebar (with the mobile nav card) and the
       docs table of contents are both asides. */
    aside,
    [data-progressive-blur],
    header[class*="sticky"],
    header.sticky,
    body > footer {
      display: none !important;
    }
    main {
      display: block !important;
    }
    body,
    .inverted {
      background: white !important;
    }
    /* Descendants too: the on-screen ink classes (text-foreground/80,
       text-muted-foreground) would otherwise print washed-out gray. Covers
       the page title and description above the printable region as well. */
    .inverted,
    .inverted * {
      color: #111 !important;
    }
    #dpa-printable a {
      text-decoration: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const placeholder = "____________________________";

    function read(id) {
      var el = document.getElementById(id);
      return el && "value" in el ? String(el.value || "").trim() : "";
    }

    function setText(id, value, usePlaceholder) {
      var el = document.getElementById(id);
      if (!el) return;
      var t = value || (usePlaceholder ? placeholder : "-");
      el.textContent = t;
    }

    function sync() {
      setText("dpa-out-company", read("dpa-in-company"), true);
      setText("dpa-out-name", read("dpa-in-name"), true);
      setText("dpa-out-title", read("dpa-in-title"), true);
      setText("dpa-out-country", read("dpa-in-country"), true);
      setText("dpa-out-address", read("dpa-in-address"), true);
      var dateVal = read("dpa-in-date");
      setText("dpa-out-date", dateVal, false);
    }

    function init() {
      // Delegated: also catches the date picker's hidden input, which is
      // mounted by React after this script runs.
      document.addEventListener("input", sync);
      document.addEventListener("change", sync);
      var btn = document.getElementById("dpa-print-btn");
      if (btn)
        btn.addEventListener("click", function () {
          sync();
          window.print();
        });
      sync();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
