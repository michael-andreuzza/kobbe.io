---
import type { CollectionEntry } from "astro:content";
import { ArrowLeft01Icon, ArrowRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

interface Props {
  docs: CollectionEntry<"docs">[];
  currentId: string;
  variant?: "full" | "compact";
}

const { docs, currentId, variant = "full" } = Astro.props;
const currentIndex = docs.findIndex((doc) => doc.id === currentId);
const previousDoc = currentIndex > 0 ? docs[currentIndex - 1] : undefined;
const nextDoc =
  currentIndex >= 0 && currentIndex < docs.length - 1
    ? docs[currentIndex + 1]
    : undefined;

const getHref = (doc: CollectionEntry<"docs">) =>
  doc.id === "overview" ? "/docs" : `/docs/${doc.id}`;

/* Bottom prev/next: quiet text links. `select-none` and no dragging keep
   rapid click-through paging from stalling (see script below). */
const linkClass =
  "text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 text-sm transition-colors select-none [-webkit-user-drag:none]";

/* Top corner pager: quiet chip buttons with the soft field border (the
   default outline variant's full-ink border is too harsh here). */
const iconLinkClass = cn(
  buttonVariants({ variant: "outline", size: "icon-xs" }),
  "border-border bg-card text-muted-foreground hover:bg-card hover:text-foreground",
  "select-none [-webkit-user-drag:none]",
);
---

{
  (previousDoc || nextDoc) && (
    <nav
      aria-label="pagination"
      class={
        variant === "compact"
          ? "not-prose flex items-center gap-1"
          : "not-prose border-border mt-10 flex items-center justify-between gap-4 border-t pt-6"
      }
    >
      {previousDoc ? (
        <a
          href={getHref(previousDoc)}
          data-slot="pagination-link"
          data-astro-prefetch="viewport"
          draggable="false"
          aria-label={`Previous: ${previousDoc.data.navLabel ?? previousDoc.data.title}`}
          class={variant === "compact" ? iconLinkClass : linkClass}
        >
          <HugeiconsIcon
            icon={ArrowLeft01Icon}
            size={14}
            strokeWidth={1.8}
            aria-hidden="true"
          />
          {variant === "compact"
            ? null
            : (previousDoc.data.navLabel ?? previousDoc.data.title)}
        </a>
      ) : variant === "compact" ? (
        <span class="block size-8" aria-hidden="true" />
      ) : (
        <span />
      )}
      {nextDoc ? (
        <a
          href={getHref(nextDoc)}
          data-slot="pagination-link"
          data-astro-prefetch="viewport"
          draggable="false"
          aria-label={`Next: ${nextDoc.data.navLabel ?? nextDoc.data.title}`}
          class={variant === "compact" ? iconLinkClass : linkClass}
        >
          {variant === "compact"
            ? null
            : (nextDoc.data.navLabel ?? nextDoc.data.title)}
          <HugeiconsIcon
            icon={ArrowRight01Icon}
            size={14}
            strokeWidth={1.8}
            aria-hidden="true"
          />
        </a>
      ) : variant === "compact" ? (
        <span class="block size-8" aria-hidden="true" />
      ) : (
        <span />
      )}
    </nav>
  )
}

<script>
  // Navigate on pointerdown instead of waiting for the native click.
  // Rapid successive clicks can be swallowed by the browser (drag
  // detection, double/triple-click grouping, input suppression during
  // navigation), which made click-through paging stall; pointerdown
  // always fires, so paging keeps up no matter how fast you click.
  let navigating = false;
  document.addEventListener("pointerdown", (event) => {
    if (
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return;
    }
    const target = event.target as HTMLElement | null;
    const link = target?.closest<HTMLAnchorElement>(
      'a[data-slot="pagination-link"]',
    );
    if (!link?.href) return;
    event.preventDefault();
    // Chrome holds the old page's pixels until the next page paints, so
    // extra presses during that window would silently skip pages; only
    // the first press per document navigates.
    if (navigating) return;
    navigating = true;
    window.location.assign(link.href);
  });
</script>
