---
import type { CollectionEntry } from "astro:content";
import { ArrowLeft01Icon, ArrowRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import { cn } from "@/lib/utils";

interface Props {
  docs: CollectionEntry<"docs">[];
  currentId: string;
}

const { docs, currentId } = Astro.props;
const currentIndex = docs.findIndex((doc) => doc.id === currentId);
const previousDoc = currentIndex > 0 ? docs[currentIndex - 1] : undefined;
const nextDoc =
  currentIndex >= 0 && currentIndex < docs.length - 1
    ? docs[currentIndex + 1]
    : undefined;

const getHref = (doc: CollectionEntry<"docs">) =>
  doc.id === "overview" ? "/docs" : `/docs/${doc.id}`;

const getTitle = (doc: CollectionEntry<"docs">) =>
  doc.data.navLabel ?? doc.data.title;

/* Bottom pager: a white card previewing the next page (or the previous one
   on the last page), with a quiet Previous link beside it on a gray strip.
   `select-none` and no dragging keep rapid click-through paging from
   triggering text selection or drags. */
const card = nextDoc ?? previousDoc;
const cardIsNext = Boolean(nextDoc);
const noDrag = "select-none [-webkit-user-drag:none]";
const cardLabelClass =
  "text-foreground flex shrink-0 items-center gap-1 self-stretch text-sm font-medium";

---

{
  card && (
    <nav
      aria-label="pagination"
      class="not-prose bg-muted-surface mt-12 flex rounded-2xl p-1"
    >
      {previousDoc && nextDoc && (
        <a
          href={getHref(previousDoc)}
          data-slot="pagination-link"
          data-astro-prefetch="viewport"
          draggable="false"
          aria-label={`Previous: ${getTitle(previousDoc)}`}
          class={cn(
            "text-muted-foreground hover:text-foreground flex shrink-0 items-center gap-1 px-4 text-sm font-medium transition-colors",
            noDrag,
          )}
        >
          <HugeiconsIcon
            icon={ArrowLeft01Icon}
            size={14}
            strokeWidth={1.8}
            aria-hidden="true"
          />
          Previous
        </a>
      )}
      <a
        href={getHref(card)}
        data-slot="pagination-link"
        data-astro-prefetch="viewport"
        draggable="false"
        aria-label={`${cardIsNext ? "Next" : "Previous"}: ${getTitle(card)}`}
        class={cn(
          "border-border bg-background hover:border-muted-foreground/20 flex min-w-0 flex-1 items-center gap-4 rounded-xl border p-4 shadow-xs transition-colors",
          noDrag,
        )}
      >
        {!cardIsNext && (
          <span class={cn(cardLabelClass, "border-border border-r pr-4")}>
            <HugeiconsIcon
              icon={ArrowLeft01Icon}
              size={14}
              strokeWidth={1.8}
              aria-hidden="true"
            />
            Previous
          </span>
        )}
        <span
          class={cn(
            "flex min-w-0 flex-1 flex-col gap-0.5",
            cardIsNext && "items-end text-right",
          )}
        >
          <span class="text-foreground max-w-full truncate text-sm font-medium">
            {getTitle(card)}
          </span>
          <span class="text-muted-foreground max-w-full truncate text-sm">
            {card.data.description}
          </span>
        </span>
        {cardIsNext && (
          <span class={cn(cardLabelClass, "border-border border-l pl-4")}>
            Next
            <HugeiconsIcon
              icon={ArrowRight01Icon}
              size={14}
              strokeWidth={1.8}
              aria-hidden="true"
            />
          </span>
        )}
      </a>
    </nav>
  )
}
