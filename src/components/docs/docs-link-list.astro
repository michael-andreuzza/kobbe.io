---
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import BrandLogo from "@/components/foundations/BrandLogo.astro";

type DocsLinkListItem = {
  title: string;
  href: string;
  logo?: {
    src: string;
    alt: string;
  };
};

type DocsLinkListSection = {
  title: string;
  items: DocsLinkListItem[];
  showLogos?: boolean;
};

interface Props {
  sections: DocsLinkListSection[];
  showLogos?: boolean;
  className?: string;
}

const { sections, showLogos = false, className = "mt-8" } = Astro.props;
---

<div class:list={["not-prose space-y-12", className]}>
  {
    sections.map((section) => {
      const withLogos = showLogos || section.showLogos;
      return (
        <section>
          <h2 class="text-foreground text-base font-medium">{section.title}</h2>
          <ul class=" mt-2 grid grid-cols-1 gap-y-4 lg:grid-cols-3 lg:gap-x-8 pt-4">
            {section.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group  font-medium"
                >
                  <span
                    class:list={[
                      "min-w-0 transition-transform duration-300 group-hover:translate-x-3",
                      withLogos && item.logo && "flex items-center gap-2.5",
                    ]}
                  >
                    {withLogos && item.logo ? (
                      <span class="flex size-5 shrink-0 items-center justify-center">
                        <BrandLogo
                          src={item.logo.src}
                          alt={item.logo.alt}
                          class="size-4 rounded-xs object-contain"
                          width={16}
                          height={16}
                        />
                      </span>
                    ) : null}
                    <span class="text-foreground block min-w-0 text-sm text-pretty">
                      {item.title}
                    </span>
                  </span>
                  
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>
