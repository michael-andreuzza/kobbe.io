---
/**
 * Grouped docs links as hairline rows in two columns: a small heading per
 * group, then each link with an optional logo and a down-right arrow.
 */
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import BrandLogo from "@/components/foundations/BrandLogo.astro";

type DocsLinkListItem = {
  title: string;
  href: string;
  logo?: {
    src: string;
    alt: string;
  };
};

type DocsLinkListSection = {
  title: string;
  items: DocsLinkListItem[];
  showLogos?: boolean;
};

interface Props {
  sections: DocsLinkListSection[];
  showLogos?: boolean;
  className?: string;
}

const { sections, showLogos = false, className = "mt-8" } = Astro.props;
---

<div class:list={["not-prose space-y-12", className]}>
  {
    sections.map((section) => {
      const withLogos = showLogos || section.showLogos;
      return (
        <section>
          <h2 class="text-muted-foreground text-sm font-medium">
            {section.title}
          </h2>
          <ul class="mt-3 grid grid-cols-1 gap-x-8 sm:grid-cols-2" role="list">
            {section.items.map((item) => (
              <li class="border-border border-t">
                <a
                  href={item.href}
                  class="group text-foreground flex items-center justify-between gap-4 py-3 text-sm font-medium"
                >
                  <span class="flex min-w-0 items-center gap-2.5 transition-transform duration-300 group-hover:translate-x-1">
                    {withLogos && item.logo ? (
                      <BrandLogo
                        src={item.logo.src}
                        alt={item.logo.alt}
                        class="size-4 shrink-0 rounded-xs object-contain"
                        width={16}
                        height={16}
                      />
                    ) : null}
                    <span class="truncate">{item.title}</span>
                  </span>
                  <HugeiconsIcon
                    icon={ArrowDownRight01Icon}
                    size={16}
                    strokeWidth={1.8}
                    className="text-muted-foreground group-hover:text-foreground shrink-0 transition-colors"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }
</div>
