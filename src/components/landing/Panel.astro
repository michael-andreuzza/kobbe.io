---
/**
 * Color panel with a rounded corner cutout: a short strip plus a gap form
 * the notch, every outer corner rounded, and a concave fillet where the step
 * turns so the cut reads as one smooth shape.
 */
type PanelColor =
  | "carbon"
  | "chart-traffic"
  | "chart-revenue"
  | "chart-conversions"
  | "chart-performance";

interface Props {
  /** Color token name; sets the --panel variable the fillets paint with. */
  color: PanelColor;
  /** Which corner carries the cutout, or "none" for a plain rounded panel. */
  notch?: "tr" | "bl" | "none";
  /** Classes for the content block (padding etc.). */
  class?: string;
  /** Classes for the panel root (e.g. full-height flex for stacked cards). */
  rootClass?: string;
  id?: string;
}

// Static strings so Tailwind can see and generate each variant.
const colorClasses: Record<PanelColor, string> = {
  carbon: "[--panel:var(--carbon)]",
  "chart-traffic": "[--panel:var(--chart-traffic)]",
  "chart-revenue": "[--panel:var(--chart-revenue)]",
  "chart-conversions": "[--panel:var(--chart-conversions)]",
  "chart-performance": "[--panel:var(--chart-performance)]",
};

const { color, notch = "tr", class: className, rootClass, id } = Astro.props;
---

<section id={id} class:list={[colorClasses[color], rootClass]}>
  {
    notch === "none" ? (
      <div class:list={["bg-(--panel) rounded-3xl", className]}>
        <slot />
      </div>
    ) : notch === "tr" ? (
      <>
        <div class="flex">
          <div class="bg-(--panel) flex h-12 grow items-center rounded-t-3xl px-5 sm:h-14 sm:px-8">
            <slot name="tab" />
          </div>
          <div class="relative w-28 sm:w-44">
            <!-- Oversized by 1px toward the strip and body so the panel
                 pieces overlap instead of butt-joining (kills seam lines). -->
            <span
              class="landing-fillet-tr absolute -bottom-px -left-px size-6.25"
              aria-hidden="true"
            />
          </div>
        </div>
        <div
          class:list={[
            "bg-(--panel) -mt-px rounded-b-3xl rounded-tr-3xl",
            className,
          ]}
        >
          <slot />
        </div>
      </>
    ) : (
      <>
        <div
          class:list={[
            "bg-(--panel) rounded-t-3xl rounded-bl-3xl",
            className,
          ]}
        >
          <slot />
        </div>
        <div class="-mt-px flex">
          <div class="relative w-28 sm:w-44">
            <span
              class="landing-fillet-bl absolute -top-px -right-px size-6.25"
              aria-hidden="true"
            />
          </div>
          <div class="bg-(--panel) h-12 grow rounded-b-3xl sm:h-14" />
        </div>
      </>
    )
  }
</section>
