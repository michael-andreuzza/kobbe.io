---
/**
 * Stacked feature sections on the 12 column grid: a two-tone sentence on the
 * left 4 columns; heading, subtitle, and link on the right 8; then
 * a full width muted panel the product screenshot rises into from the bottom.
 */
import Text from "@/components/foundations/elements/Text.astro";
import ArrowLink from "@/components/foundations/elements/ArrowLink.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import ScreenshotPanel from "@/components/sections/ScreenshotPanel.astro";
import featureOverview from "@/images/assets/feature-overview.png";
import featureRevenue from "@/images/assets/feature-revenue.png";
import featureRealtime from "@/images/assets/feature-realtime.png";
import spotRobot from "@/images/illustrations/spot-robot.webp";
import spotCrabCoin from "@/images/illustrations/spot-crab-coin.webp";
import spotSeal from "@/images/illustrations/spot-seal-cookie-body.webp";
import spotSealCookie from "@/images/illustrations/spot-seal-cookie-treat.webp";

const features = [
  {
    label: "Bot filtering,",
    summary: "seven checks on every visit before it counts.",
    lead: "Bots stay out of your numbers",
    body: "Headless browsers, datacenter traffic, and referrer spam never reach your stats or your quota. VPN users still count.",
    href: "/features/bot-filtering",
    linkLabel: "How bot filtering works",
    image: featureOverview,
    imageAlt:
      "The Kobbe overview dashboard: visitor KPIs, a traffic trend chart, top pages, and top sources",
    spot: { src: spotRobot, class: "right-10 w-8 sm:w-11" },
  },
  {
    label: "Revenue attribution,",
    summary: "from the first visit to the paid checkout.",
    lead: "See what every page earns",
    body: "Gross, net, and attributed revenue for every page, source, and campaign, through Stripe, Polar, Paddle, Shopify, and more.",
    href: "/features/revenue-attribution",
    linkLabel: "How attribution works",
    image: featureRevenue,
    imageAlt:
      "The Kobbe revenue page: gross, net, and attributed revenue with a per-page attribution breakdown",
    spot: { src: spotCrabCoin, class: "left-8 w-14 sm:w-18" },
  },
  {
    label: "Cookieless analytics,",
    summary: "with no banner and no personal data stored.",
    lead: "Nothing for visitors to consent to",
    body: "Kobbe counts visits without tracking people, respects Global Privacy Control and Do Not Track, and comes with a DPA.",
    href: "/features/cookieless-analytics",
    linkLabel: "How it stays cookieless",
    image: featureRealtime,
    imageAlt:
      "The Kobbe realtime page: online visitors shown as anonymous dots on a neutral globe map",
    spot: { src: spotSeal, wobble: spotSealCookie, class: "left-8 w-16 sm:w-20" },
  },
];
---

<div id="features">
  {
    features.map((feature) => (
      <section>
        <SectionGrid lead={feature.label} title={feature.summary} class="py-24">
          <div class="flex flex-col gap-2">
            <Text
              tag="h2"
              variant="displayMD"
              class="font-medium tracking-tight leading-tight text-pretty lg:text-balance"
            >
              {feature.lead}
            </Text>
            <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
              {feature.body}
            </Text>
            <ArrowLink label={feature.linkLabel} href={feature.href} class="mt-8" />
          </div>
          <ScreenshotPanel slot="full" src={feature.image} alt={feature.imageAlt} spot={feature.spot} />
        </SectionGrid>
      </section>
    ))
  }
</div>
