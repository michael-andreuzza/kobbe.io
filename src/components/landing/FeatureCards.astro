---
/**
 * Stacked feature sections: a title, a gray subtitle, and a short fact list
 * on the left with the feature page link on the right, then a large muted panel the
 * product screenshot rises into from the bottom, cropped by the panel edge.
 */
import { Image } from "astro:assets";
import { Button } from "@/components/ui/button";
import { TwoToneHeading } from "@/components/ui/two-tone-heading";
import Wrapper from "../foundations/containers/Wrapper.astro";
import featureOverview from "@/images/assets/feature-overview.png";
import featureRevenue from "@/images/assets/feature-revenue.png";
import featureRealtime from "@/images/assets/feature-realtime.png";

const features = [
  {
    lead: "Bots stay out of your numbers.",
    body: "Headless browsers, datacenter traffic, and referrer spam never reach your stats or your quota.",
    href: "/features/bot-filtering",
    linkLabel: "Bot filtering",
    facts: [
      "7 independent checks",
      "2,300+ spam referrers blocked",
      "See what was filtered, and why",
      "VPN users still count",
    ],
    image: featureOverview,
    imageAlt:
      "The Kobbe overview dashboard: visitor KPIs, a traffic trend chart, top pages, and top sources",
  },
  {
    lead: "See what every page earns.",
    body: "Revenue traced through checkout with Stripe, Polar, Paddle, Shopify, and more.",
    href: "/features/revenue-attribution",
    linkLabel: "Revenue",
    facts: [
      "10 payment integrations",
      "Gross, net, and attributed revenue",
      "Per page, source, and campaign",
    ],
    image: featureRevenue,
    imageAlt:
      "The Kobbe revenue page: gross, net, and attributed revenue with a per-page attribution breakdown",
  },
  {
    lead: "Nothing to consent to.",
    body: "Kobbe counts visits without tracking people, and respects Global Privacy Control and Do Not Track.",
    href: "/features/cookieless-analytics",
    linkLabel: "Privacy",
    facts: ["No cookies", "No raw IPs stored", "DPA included"],
    image: featureRealtime,
    imageAlt:
      "The Kobbe realtime page: online visitors shown as anonymous dots on a neutral globe map",
  },
];
---

<Wrapper variant="default" class="py-24">
  <div id="features" class="space-y-32">
    {
      features.map((feature) => (
        <section class="relative overflow-hidden">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div class="min-w-0">
              <TwoToneHeading title={feature.lead} className="max-w-2xl">
                {feature.body}
              </TwoToneHeading>
              <ul class="mt-6 flex flex-col gap-x-8 gap-y-2 sm:flex-row sm:flex-wrap">
                {feature.facts.map((fact) => (
                  <li class="text-muted-foreground before:bg-muted-foreground flex items-center gap-2 text-sm font-medium whitespace-nowrap before:size-1 before:shrink-0 before:rounded-full before:content-['']">
                    {fact}
                  </li>
                ))}
              </ul>
            </div>
            <Button
              label={feature.linkLabel}
              href={feature.href}
              variant="outline"
              size="sm"
              arrow
              className="shrink-0"
            />
          </div>
          <div class="bg-muted-surface relative mt-8 flex h-auto items-center justify-end overflow-hidden rounded-lg p-4 pb-0 sm:h-120 lg:h-152">
            <Image
              src={feature.image}
              alt={feature.imageAlt}
              class="shadow-panel-lifted mx-auto  block w-full max-w-4xl -mb-12 rounded-t lg:rounded-t-lg"
              widths={[768, 1280, 1920, 2560]}
              sizes="(min-width: 1024px) 896px, 100vw"
              loading="lazy"
            />
            <div class="progressive-blur-edge" aria-hidden="true">
              <div />
              <div />
              <div />
              <div />
              <div />
              <div />
            </div>
          </div>
        </section>
      ))
    }
  </div>
</Wrapper>
