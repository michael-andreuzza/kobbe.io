---
/**
 * Stacked feature sections: a small uppercase eyebrow, a two-tone lead
 * (claim in ink, detail in gray), then a large muted panel the product
 * screenshot rises into from the bottom, cropped by the panel edge.
 */
import { Image } from "astro:assets";

import { TwoToneHeading } from "@/components/ui/two-tone-heading";
import Wrapper from "../foundations/containers/Wrapper.astro";
import featureOverview from "@/images/assets/feature-overview.png";
import featureRevenue from "@/images/assets/feature-revenue.png";
import featureRealtime from "@/images/assets/feature-realtime.png";
// Tall variants carry pines on the empty side of the panel so the space
// beside the screenshot is not blank. Low variants (strip-*.webp) are kept.
import sceneCoast from "@/images/illustrations/strip-coast-tall.webp";
import sceneHarbour from "@/images/illustrations/strip-harbour-tall.webp";
import sceneShore from "@/images/illustrations/strip-shore-tall.webp";

/*
 * Each panel gets its own watercolour shoreline (same hand as the footer),
 * paper knocked out to alpha, running the full panel width along the
 * bottom edge and over the lower part of the screenshot.
 */
const features = [
  {
    eyebrow: "Filter out the bots",
    lead: "Numbers you can finally trust, with every bot filtered out.",
    body: "Modern bots run real Chrome and rotate IPs, so they look exactly like people. Kobbe drops headless browsers, datacenter traffic, and referrer spam before they touch your stats or your quota. VPN users are untouched.",
    href: "/docs/bot-filtering",
    linkLabel: "How filtering works",
    image: featureOverview,
    imageAlt:
      "The Kobbe overview dashboard: visitor KPIs, a traffic trend chart, top pages, and top sources",
    scene: sceneCoast,
    // Trees and cottage sit left, so the screenshot goes right.
    imageClass: "ml-auto",
    sceneClass: "left-0",
  },
  {
    eyebrow: "Follow the money",
    lead: "See the revenue behind every page, source, and campaign.",
    body: "Attribution passes through checkout with Stripe, Polar, Paddle, Shopify, and friends, so your dashboard shows the money each page actually produced, not a guess. Traffic is a vanity metric; revenue isn't.",
    href: "/docs/revenue-attribution",
    linkLabel: "Revenue attribution",
    image: featureRevenue,
    imageAlt:
      "The Kobbe revenue page: gross, net, and attributed revenue with a per-page attribution breakdown",
    scene: sceneHarbour,
    // Boathouses sit right, so the screenshot stays left.
    imageClass: "",
    sceneClass: "right-0 left-auto",
  },
  {
    eyebrow: "Respect your visitors",
    lead: "No cookies, no consent banners, no raw IPs stored.",
    body: "Kobbe counts visits without following people around, so there is nothing to consent to and nothing to click away. Global Privacy Control and Do Not Track are honored before a single request is sent.",
    href: "/docs/privacy-and-cookieless-tracking",
    linkLabel: "Privacy and cookieless tracking",
    image: featureRealtime,
    imageAlt:
      "The Kobbe realtime page: online visitors shown as anonymous dots on a globe",
    scene: sceneShore,
    // Rocks and bench sit left, so the screenshot goes right.
    imageClass: "ml-auto",
    sceneClass: "left-0",
  },
];
---

<Wrapper variant="default" class="py-24">
  <div id="features" class="space-y-32">
    {
      features.map((feature) => (
        <section class="relative overflow-hidden">
          <TwoToneHeading eyebrow={feature.eyebrow} title={feature.lead}>
            {feature.body}{" "}
            <a
              href={feature.href}
              class="text-foreground font-medium underline decoration-1 underline-offset-4 transition-opacity hover:opacity-70"
            >
              {feature.linkLabel}
            </a>
          </TwoToneHeading>
          <div class="mt-8 h-auto sm:h-120 lg:h-152">
            <Image
              src={feature.image}
              alt={feature.imageAlt}
              class:list={[
                "shadow-panel -mb-2 block w-full max-w-4xl rounded lg:rounded-t-lg",
                feature.imageClass,
              ]}
              widths={[768, 1280, 1920, 2560]}
              sizes="(min-width: 1024px) 896px, 100vw"
              loading="lazy"
            />
            <div class="progressive-blur-edge" aria-hidden="true">
              <div />
              <div />
              <div />
              <div />
              <div />
              <div />
            </div>
          </div>
          <Image
            src={feature.scene}
            alt=""
            class:list={[
              "pointer-events-none absolute -bottom-5 hidden w-full max-w-2xl sm:block",
              feature.sceneClass,
            ]}
            widths={[768, 1280, 1920, 2560]}
            sizes="(min-width: 1280px) 1200px, 100vw"
            loading="lazy"
          />
        </section>
      ))
    }
  </div>
</Wrapper>
