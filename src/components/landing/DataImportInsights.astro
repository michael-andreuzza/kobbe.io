---
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import { AnimatedPanelReveal } from "@/components/landing/animated-panel-reveal";
import ImportInsightsPreview from "@/components/landing/dashboard/import-insights-preview";
import SectionIntro from "@/components/landing/SectionIntro.astro";
import datafastLogo from "@/images/brands/datafast.svg";
import fathomLogo from "@/images/brands/fathom.svg";
import plausibleLogo from "@/images/brands/plausible.svg";
import umamiLogo from "@/images/brands/umami.svg";

const importProviders = [
  { name: "Plausible", logo: plausibleLogo },
  { name: "Fathom", logo: fathomLogo },
  { name: "Umami", logo: umamiLogo },
  { name: "DataFast", logo: datafastLogo },
];

const importInsightsPoints = [
  {
    title: "Upload or connect",
    description:
      "Import ZIP exports from Plausible, Fathom, or Umami, or pull history from DataFast with a read-only API key.",
  },
  {
    title: "Fill gaps safely",
    description:
      "Keep live Kobbe tracking intact with merge modes that only backfill missing days or chosen ranges.",
  },
  {
    title: "See history in context",
    description:
      "Daily visitors, pageviews, sessions, and breakdown snapshots show up beside new traffic in the same dashboard.",
  },
];
---

<section id="import" class="pt-8">
  <Wrapper class="py-20">
    <div class="mx-auto max-w-4xl">
      <div class="max-w-lg lg:mx-auto lg:text-center">
        <SectionIntro
          title="Bring your analytics history with you."
          description="Switching tools should not mean starting from zero. Import historical traffic into Kobbe and keep collecting new data on the same site."
        />
        <div
          class="text-muted-foreground mt-8 flex w-fit flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium lg:mx-auto"
          aria-label="Supported import providers"
        >
          <span class="sr-only">Import from:</span>
          {
            importProviders.map((provider) => (
              <span>
                <img
                  src={provider.logo.src}
                  alt={`${provider.name} logo`}
                  class="size-6 rounded object-contain"
                  loading="lazy"
                  width="24"
                  height="24"
                />
                <span class="sr-only">{provider.name}</span>
              </span>
            ))
          }
        </div>
      </div>
    </div>
    <div class="relative mt-8">
      <AnimatedPanelReveal client:load trigger="scroll" mask={false}>
        <ImportInsightsPreview client:load />
      </AnimatedPanelReveal>
    </div>

    <div class="mt-8 grid gap-4 text-balance sm:grid-cols-3 lg:text-center">
      {
        importInsightsPoints.map((point) => (
          <div data-kobbe-stagger>
            <h3 class="text-foreground text-base font-medium">{point.title}</h3>
            <p class="text-muted-foreground mt-1 text-sm font-medium">
              {point.description}
            </p>
          </div>
        ))
      }
    </div>

    <p class="text-muted-foreground mt-8 text-center text-sm font-medium">
      <a
        href="/docs/import-analytics-data"
        class="text-foreground underline-offset-4 hover:underline"
      >
        Read the import guides
      </a>
    </p>
  </Wrapper>
</section>
