---
import { getImage } from "astro:assets";

import Wrapper from "@/components/foundations/containers/Wrapper.astro";

/**
 * The interactive pricing pair: carbon card with billing toggle, volume
 * slider, and CTA beside the "Everything included" checklist. The cards
 * carry their own #pricing anchor.
 */
import { SimplifiedPricingSection } from "@/components/sections/pricing/simplified-pricing-section";
import gullCoin from "@/images/illustrations/spot-gull-coin.webp";

// The React island cannot import astro:assets, so optimise the gull here
// and hand the plain <img> attributes over as props.
const gull = await getImage({
  src: gullCoin,
  widths: [160, 320],
  format: "webp",
});
const spotArt = {
  src: gull.src,
  srcSet: gull.srcSet.attribute,
  width: gull.attributes.width,
  height: gull.attributes.height,
};
---

<section class="mt-32">
  <Wrapper variant="default" class="py-12 ">
    <SimplifiedPricingSection client:visible spotArt={spotArt} />
  </Wrapper>
</section>
