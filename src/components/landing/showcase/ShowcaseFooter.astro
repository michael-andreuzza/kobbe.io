---
import Logo from "@/components/assets/Logo.astro";
import { landingFeatureCard } from "@/lib/landing-features";
import { marketingPaths } from "@/lib/marketing-urls";

type FooterLink = {
  href: string;
  label: string;
  target?: string;
  rel?: string;
};

type FooterLinkGroup = {
  title: string;
  links: FooterLink[];
};

/** Full feature catalog rendered as extra link columns, mostly for SEO. */
const featureGroups = landingFeatureCard.groups;

const footerLinkGroups: FooterLinkGroup[] = [
  {
    title: "Product",
    links: [
      { href: "/#benefits", label: "All features" },
      { href: "/#pricing", label: "Pricing" },
      { href: "/docs", label: "Documentation" },
      { href: "/llms.txt", label: "llms.txt" },
    ],
  },
  {
    title: "Support",
    links: [
      { href: marketingPaths.support.contact, label: "Contact" },
      { href: "/#faq", label: "FAQ" },
      { href: marketingPaths.support.charges, label: "Charges" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/legal/terms", label: "Terms" },
      { href: "/legal/privacy", label: "Privacy" },
      { href: "/legal/gdpr-compliance", label: "GDPR" },
      { href: "/legal/dpa", label: "DPA" },
    ],
  },
  {
    title: "More",
    links: [
      {
        href: "https://onmy.land",
        label: "More than link in bio",
        target: "_blank",
        rel: "noopener noreferrer",
      },
      {
        href: "http://lexingtonthemes.com/",
        label: "Premium Astro Website themes",
        target: "_blank",
        rel: "noopener noreferrer",
      },
    ],
  },
];

const year = new Date().getFullYear();
---

{/* Footer as a feed card in the mega menu's carbon style: the logo up
    top, link columns below, fine print at the bottom. */}
<footer
  class="inverted bg-card relative flex flex-col justify-between gap-10 overflow-hidden rounded-lg p-4 sm:p-6"
>
  <Logo class="text-foreground h-8 w-fit shrink-0" />
  <nav
    aria-label="Footer"
    class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4"
  >
    {
      footerLinkGroups.map((group) => (
        <div class="space-y-2.5">
          <p class="text-muted-foreground/60 text-xs">{group.title}</p>
          <ul class="space-y-1.5">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.target}
                  rel={link.rel}
                  class="text-muted-foreground hover:text-foreground text-xs transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
  {
    featureGroups.length > 0 && (
      <nav
        aria-label="All features"
        class="border-border grid grid-cols-2 gap-x-6 gap-y-8 border-t pt-8 lg:grid-cols-4"
      >
        {featureGroups.map((group) => (
          <div class="space-y-2.5">
            <p class="text-muted-foreground/60 text-xs">{group.category}</p>
            <ul class="space-y-1.5">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-muted-foreground hover:text-foreground text-xs transition-colors"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    )
  }
  <div
    class="text-muted-foreground/60 flex flex-wrap items-center justify-between gap-2 text-xs"
  >
    <p>Made in the Åland Islands</p>
    <p>&copy; {year} Kobbe. All rights reserved.</p>
  </div>
</footer>
