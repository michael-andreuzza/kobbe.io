---
import { PricingFaq } from "@/components/sections/pricing/pricing-faq";
import ShowcaseEyebrow from "@/components/landing/showcase/ShowcaseEyebrow.astro";
---

{/* No overflow-hidden here: it would keep the sticky title column from
    pinning to the viewport. */}
<section
  id="faq"
  aria-labelledby="faq-heading"
  class="bg-card relative rounded-lg p-4 shadow-sm sm:p-6"
>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-6">
    {/* Title column: pins while the accordion list scrolls past. */}
    <div class="lg:self-start lg:sticky lg:top-6">
      <div class="max-w-md space-y-1.5">
        <ShowcaseEyebrow id="faq-heading" label="FAQ" accent="neutral" />
        <p class="text-muted-foreground text-sm text-balance">
          Quick answers about privacy, plans, setup, and support.
        </p>
      </div>
    </div>
    <PricingFaq client:load headingId="faq-heading" />
  </div>
  {/* Footnote pinned to the card bottom, same tone as the opt-in note. */}
  <p class="text-muted-foreground/50 mt-10 text-xs">
    Still have questions? <a
      href="/support/contact"
      class="hover:text-foreground transition-colors">Contact support</a
    >.
  </p>
</section>
