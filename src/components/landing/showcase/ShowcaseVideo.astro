---
/**
 * The dashboard walkthrough recording, autoplaying muted on loop at the top
 * of the showcase feed. The poster reuses the dashboard screenshot so the
 * frame is meaningful before the video buffers.
 */
import dashboardShot from "@/images/assets/kobbedashb.png";
---

<section aria-label="Dashboard walkthrough video">
  <video
    class="block w-full overflow-hidden rounded-lg shadow-sm"
    src="/videos/walkthrough.mp4"
    poster={dashboardShot.src}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-label="A walkthrough of the Kobbe dashboard: traffic, sources, conversions, funnels, and revenue"
  ></video>
</section>
