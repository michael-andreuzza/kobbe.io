---
import HeroStaticChart from "@/components/landing/dashboard/hero-static-chart";
---

<section
  class="bg-card relative flex gap-12 flex-col justify-between lg:gap-8 overflow-hidden rounded-lg p-4 shadow-sm sm:p-6 lg:min-h-160"
>
  <div class="max-w-md space-y-1">
    <p class="text-foreground text-xs font-medium">Overview</p>
    <p class="text-muted-foreground text-xs text-balance">
      Visitors, sources, pages, and revenue in one dashboard, so you always
      know how the site is doing at a glance.
    </p>
  </div>
  <div class="w-full">
    <HeroStaticChart frameless />
  </div>
</section>
