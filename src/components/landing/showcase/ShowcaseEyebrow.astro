---
/**
 * Card eyebrow with a small metric-color chip, echoing the dashboard's
 * per-metric hues (traffic, revenue, performance, conversions).
 * Neutral chips use the foreground token so they invert on carbon cards.
 */
export type EyebrowAccent =
  | "traffic"
  | "revenue"
  | "performance"
  | "conversions"
  | "neutral";

interface Props {
  label: string;
  accent?: EyebrowAccent;
  id?: string;
}

const { label, accent = "neutral", id } = Astro.props;

const chipClass: Record<EyebrowAccent, string> = {
  traffic: "bg-chart-traffic",
  revenue: "bg-chart-revenue",
  performance: "bg-chart-performance",
  conversions: "bg-chart-conversions",
  neutral: "bg-foreground/80",
};
---

<p id={id} class="text-foreground flex items-center gap-2 text-sm font-medium">
  <span class={`size-2 rounded-[3px] ${chipClass[accent]}`} aria-hidden="true"
  ></span>
  {label}
</p>
