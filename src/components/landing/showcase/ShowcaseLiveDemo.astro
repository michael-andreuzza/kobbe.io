---
/**
 * Dashboard screenshot dressed as a browser window, linking out to the
 * public live demo.
 */
import dashboardShot from "@/images/assets/kobbedashb.png";

const demoUrl = "https://app.kobbe.io/demo/kobbe-studio?range=30d";
---

<section aria-label="Dashboard preview">
  <div
    class="border-border bg-background overflow-hidden rounded-lg shadow-sm"
  >
    <!-- Browser chrome -->
    <div
      class="border-border bg-muted flex items-center gap-3 border-b px-3 py-2"
    >
      <div class="flex items-center gap-1.5" aria-hidden="true">
        <span class="border-border size-2.5 rounded-full border"></span>
        <span class="border-border size-2.5 rounded-full border"></span>
        <span class="border-border size-2.5 rounded-full border"></span>
      </div>
      <p
        class="text-muted-foreground bg-background border-border mx-auto w-full max-w-xs truncate rounded-md border px-3 py-1 text-center text-[11px]"
      >
        app.kobbe.io/demo
      </p>
      <a
        href={demoUrl}
        target="_blank"
        rel="noreferrer"
        class="text-muted-foreground hover:text-foreground shrink-0 text-[11px] whitespace-nowrap transition-colors duration-200"
      >
        Live demo &rarr;
      </a>
    </div>
    <a href={demoUrl} target="_blank" rel="noreferrer" class="block">
      <img
        src={dashboardShot.src}
        alt="The Kobbe dashboard: visitors over time, pages, sources, locations, and devices"
        class="block w-full"
        width={dashboardShot.width}
        height={dashboardShot.height}
        fetchpriority="high"
      />
    </a>
  </div>
</section>
