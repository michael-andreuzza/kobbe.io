---
import {
  AnnotationsPanelMockup,
  CliLogoStrip,
  ConversionPeakPanelMockup,
  ConversionsPanelMockup,
  FunnelsPanelMockup,
  CliPanelMockup,
  ImportLogoStrip,
  ImportPanelMockup,
  PerformancePanelMockup,
  RevenueLogoStrip,
  RevenuePanelMockup,
  SearchKeywordsPanelMockup,
} from "@/components/landing/showcase/showcase-panel-mockups";
import { RealtimeGlobe } from "@/components/landing/showcase/realtime-globe";
import HeroStaticChart from "@/components/landing/dashboard/hero-static-chart";
import ShowcaseEyebrow, {
  type EyebrowAccent,
} from "@/components/landing/showcase/ShowcaseEyebrow.astro";

/* Wide cards are placed so every xl row tiles to exactly three columns:
   2+1 / 1+1+1 / 2+1 / 2+1 / 1+2. */
const mockupPanels: Array<{
  title: string;
  description: string;
  accent: EyebrowAccent;
  Mockup?: import("react").ComponentType;
  Logos?: import("react").ComponentType<{ className?: string }>;
  globe?: boolean;
  /** Rendered as the static overview chart in the template below. */
  overview?: boolean;
  /** Spans two columns on the xl three-up grid. */
  wide?: boolean;
}> = [
  {
    title: "Overview",
    description:
      "Visitors, sources, pages, and revenue in one dashboard, so you always know how the site is doing at a glance.",
    accent: "traffic",
    overview: true,
    wide: true,
  },
  {
    title: "Conversions",
    description:
      "Auto-track form submits, contact clicks, outbound links, and messaging taps, plus custom events for anything else, then filter the dashboard by goal.",
    accent: "conversions",
    Mockup: ConversionsPanelMockup,
  },
  {
    title: "Chart annotations",
    description:
      "Pin notes to specific days on your traffic chart so launches, campaigns, and incidents stay tied to the numbers.",
    accent: "performance",
    Mockup: AnnotationsPanelMockup,
  },
  {
    title: "Conversion peak",
    description:
      "See when conversions happen most, by day of week and hour of day, so you can time launches, posts, and campaigns.",
    accent: "revenue",
    Mockup: ConversionPeakPanelMockup,
  },
  {
    title: "Google search keywords",
    description:
      "Connect Search Console to see which queries bring people to your site and tie search demand back to traffic.",
    accent: "traffic",
    Mockup: SearchKeywordsPanelMockup,
  },
  {
    title: "Realtime",
    description:
      "See who is on your site right now, where they are, and what pages they are viewing as activity comes in.",
    accent: "traffic",
    // Rendered as the interactive globe island in the template below.
    globe: true,
    wide: true,
  },
  {
    title: "Performance",
    description:
      "Track Core Web Vitals with the same dashboard language: percentile trends, slow pages, and environment breakdowns.",
    accent: "performance",
    Mockup: PerformancePanelMockup,
  },
  {
    title: "Funnels",
    description:
      "Build funnels from pages and custom events, then see where visitors continue or drop off, step by step.",
    accent: "conversions",
    Mockup: FunnelsPanelMockup,
    wide: true,
  },
  {
    title: "Revenue attribution",
    description:
      "Pass attribution through checkout and see which pages, sources, and campaigns actually drive money.",
    accent: "revenue",
    Mockup: RevenuePanelMockup,
    Logos: RevenueLogoStrip,
  },
  {
    title: "Bring your history",
    description:
      "Import historical traffic from Plausible, Fathom, Umami, or DataFast and keep collecting new data on the same site.",
    accent: "neutral",
    Mockup: ImportPanelMockup,
    Logos: ImportLogoStrip,
  },
  {
    title: "CLI access, with MCP built in",
    description:
      "Inspect analytics from your terminal, then run the same package in MCP mode so editors and agents can query Kobbe for you.",
    accent: "neutral",
    Mockup: CliPanelMockup,
    Logos: CliLogoStrip,
    wide: true,
  },
];
---

<div class="grid grid-cols-1 gap-2 lg:grid-cols-2 xl:grid-cols-3">
  {
    mockupPanels.map(
      ({ title, description, accent, Mockup, Logos, globe, overview, wide }) => (
        <section
          class:list={[
            "bg-card relative flex gap-12 flex-col justify-between lg:gap-8 overflow-hidden rounded-lg p-4 shadow-sm sm:p-6 lg:min-h-160 xl:min-h-140",
            wide && "xl:col-span-2",
          ]}
        >
          <div class="max-w-md space-y-1.5">
            <ShowcaseEyebrow label={title} accent={accent} />
            <p class="text-muted-foreground text-xs text-balance">
              {description}
            </p>
            {Logos ? <Logos className="pt-3" /> : null}
          </div>
          <div class="w-full">
            {/* Dynamic tags can't take client directives or props, so the
              globe island and the overview chart are rendered explicitly. */}
            {globe ? (
              <RealtimeGlobe client:visible />
            ) : overview ? (
              <HeroStaticChart frameless />
            ) : Mockup ? (
              <Mockup />
            ) : null}
          </div>
        </section>
      ),
    )
  }
</div>
