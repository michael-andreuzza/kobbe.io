---
import { landingFeatureCard } from "@/lib/landing-features";
---

<section
  class="bg-muted relative flex flex-col justify-between gap-10 overflow-hidden rounded-lg p-4 sm:p-6"
>
  <div class="max-w-md space-y-1">
    <p class="text-foreground text-xs font-medium">
      {landingFeatureCard.title}
    </p>
    <p class="text-muted-foreground text-xs text-balance">
      {landingFeatureCard.description}
    </p>
  </div>
  <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      landingFeatureCard.groups.map((group) => (
        <div class="space-y-2.5">
          <p class="text-foreground text-xs font-medium">{group.category}</p>
          <ul class="space-y-1.5">
            {group.items.map((item) => (
              <li class="flex items-baseline gap-1.5">
                <a
                  href={item.href}
                  class="text-muted-foreground hover:text-foreground text-xs transition-colors"
                >
                  {item.label}
                </a>
                {item.optIn ? (
                  <span class="text-muted-foreground/60 text-[10px] tracking-wide uppercase">
                    Opt-in
                  </span>
                ) : null}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="text-muted-foreground/60 text-xs">
    Opt-in features use the extended tracker; everything else works with the
    default script.
  </p>
</section>
