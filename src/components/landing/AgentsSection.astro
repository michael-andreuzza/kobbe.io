---
/**
 * What an AI agent can do through the Kobbe MCP server, as one muted card
 * for the setup grid:
 * a two-tone heading, a row of agent logos, the most useful tools phrased as
 * plain outcomes, and a bare arrow link to the agent docs. Every item maps to
 * a real MCP tool.
 */
import type { ImageMetadata } from "astro";


import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import BrandLogo from "@/components/foundations/BrandLogo.astro";
import { TwoToneHeading } from "@/components/ui/two-tone-heading";

const logos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/brands/*.svg",
  { eager: true },
);
const logo = (file: string) => logos[`/src/images/brands/${file}`]!.default;

const agents = [
  { label: "Claude", file: "claude.svg" },
  { label: "Cursor", file: "cursor.svg" },
  { label: "Codex", file: "codex.svg" },
  { label: "GitHub Copilot", file: "copilot.svg" },
  { label: "Windsurf", file: "windsurf.svg" },
  { label: "Zed", file: "zed.svg" },
  { label: "OpenCode", file: "opencode.svg" },
  { label: "Roo Code", file: "roo code.svg" },
];

const abilities = [
  "See who is on your site right now",
  "Pull traffic, sources, and top pages",
  "Chart traffic over any date range",
  "Split visitors by country, device, or browser",
  "Break down revenue by page and campaign",
  "Report on your UTM campaigns",
  "Count custom events and their properties",
  "Check how your goals convert",
  "Create goals and funnels for you",
  "Add a site and check the install",
  "Rotate a site's tracker token",
  "Suggest what to fix next",
];
---

<div class="bg-muted-surface flex flex-col rounded-lg p-6 sm:p-8 lg:col-span-3">
  <TwoToneHeading title="Just ask your agent.">
    Connect Kobbe to any MCP agent, and it reads your stats and sets things
    up for you.
  </TwoToneHeading>
  <ul class="mt-6 flex flex-wrap gap-5" aria-label="Works with">
    {
      agents.map((agent) => (
        <li title={agent.label}>
          <BrandLogo
            src={logo(agent.file).src}
            alt={agent.label}
            class="size-6 rounded-sm object-contain"
            width={24}
            height={24}
          />
        </li>
      ))
    }
  </ul>
  <ul class="mt-6 grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
    {
      abilities.map((ability) => (
        <li class="text-muted-foreground before:bg-muted-foreground flex items-center gap-2 text-sm font-medium before:size-1 before:shrink-0 before:rounded-full before:content-['']">
          {ability}
        </li>
      ))
    }
  </ul>
  <div class="mt-auto pt-8">
    <a
      href="/docs/ai-agents"
      class="text-foreground inline-flex items-center gap-2 text-sm font-medium transition-opacity hover:opacity-70"
    >
      Connect your agent
      <HugeiconsIcon
        icon={ArrowDownRight01Icon}
        size={16}
        strokeWidth={1.8}
        aria-hidden="true"
      />
    </a>
  </div>
</div>
