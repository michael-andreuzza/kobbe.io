---
/**
 * Setup on the 12 column grid: a two-tone sentence and heading, then install,
 * import, payments, and agents as four 3 column cards in the Carriera add-on
 * style: a title and line of copy on top; the count, a stack of the first
 * five logos with a +N, and a link at the bottom.
 */
import type { ImageMetadata } from "astro";

import BrandLogo from "@/components/foundations/BrandLogo.astro";
import ArrowLink from "@/components/foundations/elements/ArrowLink.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";

const logos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/brands/*.{svg,png}",
  { eager: true },
);
const logo = (file: string) => logos[`/src/images/brands/${file}`]!.default;

/* The rest of the install guides are behind the "Install guides" link. */
const platforms = [
  { label: "Astro", href: "/docs/install-astro", file: "astro.svg" },
  { label: "Next.js", href: "/docs/install-nextjs", file: "nextjs.svg" },
  { label: "Shopify", href: "/docs/install-shopify", file: "shopify.svg" },
  { label: "Webflow", href: "/docs/install-webflow", file: "webflow.svg" },
  { label: "Framer", href: "/docs/install-framer", file: "framer.svg" },
  { label: "WordPress", href: "/docs/install-wordpress", file: "wordpress.svg" },
  { label: "WooCommerce", href: "/docs/install-woocommerce", file: "woo.svg" },
  { label: "Wix", href: "/docs/install-wix", file: "wix.svg" },
  { label: "Squarespace", href: "/docs/install-squarespace", file: "squarespace.svg" },
  { label: "Ghost", href: "/docs/install-ghost", file: "ghost.png" },
  { label: "Lovable", href: "/docs/install-lovable", file: "lovable.svg" },
  { label: "Vercel v0", href: "/docs/install-vercel-v0", file: "v0.svg" },
  { label: "Bolt", href: "/docs/install-bolt", file: "bolt.svg" },
  { label: "Replit", href: "/docs/install-replit", file: "replit.svg" },
  { label: "Bubble", href: "/docs/install-bubble", file: "buble.svg" },
  { label: "Vue", href: "/docs/install-vue", file: "vue.svg" },
  { label: "React Router", href: "/docs/install-react-router", file: "reactrouter.svg" },
  { label: "Django", href: "/docs/install-django", file: "django.svg" },
  { label: "Laravel", href: "/docs/install-laravel", file: "laravel.svg" },
  { label: "Google Tag Manager", href: "/docs/install-google-tag-manager", file: "gtag manager.svg" },
];

const sources = [
  { label: "Plausible", href: "/docs/import-from-plausible", file: "plausible.svg" },
  { label: "Fathom", href: "/docs/import-from-fathom", file: "fathom.svg" },
  { label: "Umami", href: "/docs/import-from-umami", file: "umami.svg" },
  { label: "DataFast", href: "/docs/import-from-datafast", file: "datafast.svg" },
  { label: "Google Analytics", href: "/docs/import-from-google-analytics", file: "googleanalytics.svg" },
  { label: "Matomo", href: "/docs/import-from-matomo", file: "matomo.svg" },
  { label: "Simple Analytics", href: "/docs/import-from-simple-analytics", file: "simpleanalytics.svg" },
  { label: "PostHog", href: "/docs/import-from-posthog", file: "posthog.svg" },
  { label: "Cloudflare", href: "/docs/import-from-cloudflare-web-analytics", file: "cloudflare.svg" },
  { label: "Pirsch", href: "/docs/import-from-pirsch", file: "pirsch.svg" },
  { label: "Rybbit", href: "/docs/import-from-rybbit", file: "rybbit.svg" },
  { label: "Vercel", href: "/docs/import-from-vercel", file: "vercel.svg" },
  { label: "Ahrefs", href: "/docs/import-from-ahrefs", file: "ahrefs.svg" },
];

const payments = [
  { label: "Stripe", href: "/docs/revenue-attribution-stripe", file: "stripe.svg" },
  { label: "Polar", href: "/docs/revenue-attribution-polar", file: "polar.svg" },
  { label: "Paddle", href: "/docs/revenue-attribution-paddle", file: "paddle.svg" },
  { label: "Creem", href: "/docs/revenue-attribution-creem", file: "creem.svg" },
  { label: "Mollie", href: "/docs/revenue-attribution-mollie", file: "mollie.svg" },
  { label: "Revolut", href: "/docs/revenue-attribution-revolut", file: "revolut.svg" },
  { label: "Whop", href: "/docs/revenue-attribution-whop", file: "whop.svg" },
  { label: "RevenueCat", href: "/docs/revenue-attribution-revenuecat", file: "revenuecat.svg" },
  { label: "Superwall", href: "/docs/revenue-attribution-superwall", file: "superwall.svg" },
  { label: "Shopify", href: "/docs/revenue-attribution-shopify", file: "shopify.svg" },
  { label: "WooCommerce", href: "/docs/revenue-attribution-woocommerce", file: "woo.svg" },
  { label: "Gumroad", href: "/docs/revenue-attribution-gumroad", file: "gumroad.svg" },
  { label: "Chargebee", href: "/docs/revenue-attribution-chargebee", file: "chargebee.svg" },
  { label: "Razorpay", href: "/docs/revenue-attribution-razorpay", file: "razorpay.svg" },
];

const agents = [
  { label: "Claude", file: "claude.svg" },
  { label: "Cursor", file: "cursor.svg" },
  { label: "Codex", file: "codex.svg" },
  { label: "GitHub Copilot", file: "copilot.svg" },
  { label: "Windsurf", file: "windsurf.svg" },
  { label: "Zed", file: "zed.svg" },
  { label: "OpenCode", file: "opencode.svg" },
  { label: "Roo Code", file: "roo code.svg" },
];

const groups = [
  {
    title: "One script tag",
    body: "About 2.5 KB, and visits show up right away.",
    link: { label: "All install guides", href: "/docs/installation-guides" },
    unit: "platforms",
    total: 22,
    items: platforms,
  },
  {
    title: "Bring your history",
    body: "Your past traffic comes with you when you switch.",
    link: { label: "How importing works", href: "/features/import" },
    unit: "tools",
    items: sources,
  },
  {
    title: "Follow the money",
    body: "See which pages lead to a sale.",
    link: { label: "How attribution works", href: "/features/revenue-attribution" },
    unit: "providers",
    items: payments,
  },
  {
    title: "Just ask your agent",
    body: "Any MCP agent can read your stats and set things up for you.",
    link: { label: "Connect your agent", href: "/features/ai-agents" },
    unit: "agents",
    items: agents,
  },
];

const stackSize = 5;
const total = (group: (typeof groups)[number]) =>
  "total" in group ? group.total : group.items.length;
---

<section>
  <SectionGrid lead="Setup," title="a few minutes from the script tag to your first visit." class="py-24">
    <Text
      tag="h2"
      variant="displayMD"
      class="font-medium tracking-tight leading-tight text-pretty lg:text-balance"
    >
      Works with the stack, the history, and the checkout you already have
    </Text>
    <ul
      slot="full"
      class="grid gap-4 sm:grid-cols-2 lg:col-span-full lg:grid-cols-subgrid lg:gap-x-8"
      role="list"
    >
      {
        groups.map((group) => (
          <li class="bg-muted-surface flex flex-col justify-between gap-12 rounded-lg p-6 sm:p-8 lg:col-span-3">
            <div>
              <Text tag="h3" variant="textBase" class="font-medium">
                {group.title}
              </Text>
              <Text tag="p" variant="textSM" class="text-muted-foreground mt-1 text-pretty">
                {group.body}
              </Text>
            </div>
            <div class="flex flex-col gap-6">
              <p class="flex items-baseline gap-2">
                <Text tag="span" variant="displaySM" class="font-medium tracking-tight tabular-nums">
                  {total(group)}
                </Text>
                <Text tag="span" variant="textSM" class="text-muted-foreground">
                  {group.unit}
                </Text>
              </p>
              <div
                class="flex items-center"
                title={group.items.map((item) => item.label).join(", ")}
              >
                {group.items.slice(0, stackSize).map((item) => (
                  <BrandLogo
                    src={logo(item.file).src}
                    alt={item.label}
                    class="ring-muted-surface -ml-1.5 size-7 rounded-md object-contain ring-2 first:ml-0"
                    width={28}
                    height={28}
                  />
                ))}
                {total(group) > stackSize && (
                  <span class="bg-background ring-muted-surface text-muted-foreground -ml-1.5 flex h-7 min-w-7 items-center justify-center rounded-md px-1.5 text-xs font-medium tabular-nums ring-2">
                    +{total(group) - stackSize}
                  </span>
                )}
              </div>
              <ArrowLink label={group.link.label} href={group.link.href} />
            </div>
          </li>
        ))
      }
    </ul>
  </SectionGrid>
</section>
