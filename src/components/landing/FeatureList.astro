---
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import ArrowLink from "@/components/foundations/elements/ArrowLink.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";

/**
 * Everything else: a full width three column list below the 12 column
 * heading, each item a hairline, a title, and a one-line description, linking
 * to its feature page, or the docs when it has none. The full catalog lives on
 * /features.
 */
const listRows = [
  {
    title: "Realtime visitors",
    description: "Who is on your site right now, and from where.",
    href: "/docs/realtime-visitors",
  },
  {
    title: "Funnels",
    description: "See where visitors continue or drop off.",
    href: "/features/funnels",
  },
  {
    title: "Core Web Vitals",
    description: "Real-user speed by page, device, and country.",
    href: "/docs/performance-web-vitals",
  },
  {
    title: "Search Console",
    description: "The queries and rankings that bring people in.",
    href: "/docs/search-console",
  },
  {
    title: "Error tracking",
    description: "JavaScript errors that cost you conversions.",
    href: "/features/error-tracking",
  },
  {
    title: "Traffic alerts",
    description: "An email when traffic spikes or drops.",
    href: "/docs/traffic-alerts",
  },
  {
    title: "Shared dashboards",
    description: "Read-only links for clients and teammates.",
    href: "/docs/shared-dashboards",
  },
  {
    title: "Data import",
    description: "Your history from Google Analytics and 12 more.",
    href: "/features/import",
  },
  {
    title: "AI agents and CLI",
    description: "Ask Cursor or Claude about your traffic.",
    href: "/features/ai-agents",
  },
];
---

<section>
  <SectionGrid lead="Every feature," title="on every plan, with no feature gates." class="py-24">
    <div class="flex flex-col gap-2">
      <Text
        tag="h2"
        variant="displayMD"
        class="font-medium tracking-tight leading-tight text-pretty lg:text-balance"
      >
        Everything you'd expect from web analytics, plus the parts others charge extra for
      </Text>
      <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
        Every plan has the same features. Only the event volume changes, and
        there is no enterprise tier.
      </Text>
      <ArrowLink label="See all features" href="/features" class="mt-8" />
    </div>
    <ul slot="full" class="col-span-full grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        listRows.map((row) => (
          <li class="border-border border-t py-4">
            <a href={row.href} class="group flex items-center justify-between gap-4">
              <div class="transition-transform duration-300 group-hover:translate-x-2">
                <Text tag="h3" variant="textBase" class="text-foreground font-medium">
                  {row.title}
                </Text>
                <Text tag="p" variant="textSM" class="text-muted-foreground mt-1 text-pretty">
                  {row.description}
                </Text>
              </div>
              <HugeiconsIcon
                icon={ArrowDownRight01Icon}
                size={16}
                strokeWidth={1.8}
                className="text-muted-foreground group-hover:text-foreground shrink-0 transition-colors"
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </SectionGrid>
</section>
