---
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import { TwoToneHeading } from "@/components/ui/two-tone-heading";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";

/**
 * Everything else: quiet hairline list rows, each one a full-row link to
 * its feature page, or the docs when it has none. The full catalog lives
 * on /features.
 */
/* Product capabilities first, migration and tooling reassurances last. */
const listRows = [
  {
    title: "Realtime: who is on your site right now",
    href: "/docs/realtime-visitors",
  },
  {
    title: "Funnels from pages and events you already collect",
    href: "/features/funnels",
  },
  {
    title: "Core Web Vitals with percentile trends",
    href: "/docs/performance-web-vitals",
  },
  {
    title: "Google Search Console queries beside your traffic",
    href: "/docs/search-console",
  },
  {
    title: "JavaScript errors, with the page and browser they hit",
    href: "/docs/error-tracking",
  },
  {
    title: "Traffic alerts when visits spike or drop",
    href: "/docs/traffic-alerts",
  },
  {
    title: "Shared dashboards and embeddable widgets",
    href: "/docs/shared-dashboards",
  },
  {
    title: "Bring your history from Google Analytics, Plausible, Matomo, and more",
    href: "/features/import",
  },
  {
    title: "Ask your AI agents through MCP, or script it with the CLI",
    href: "/features/ai-agents",
  },
];
---

<section class="mt-32">
  <Wrapper variant="default">
    <TwoToneHeading title="Every feature, on every plan." className="max-w-3xl">
      Everything you'd expect from web analytics, plus the parts others charge
      extra for. No feature gates, no enterprise tier.{" "}
      <a
        href="/features"
        class="text-foreground decoration-foreground/30 hover:decoration-foreground underline underline-offset-4 transition-colors"
      >
        See all features
      </a>
    </TwoToneHeading>
    <div class="border-border mt-8 border-t">
      {
        listRows.map((row) => (
          <a
            href={row.href}
            class="group border-border grid grid-cols-[1fr_auto] items-center gap-6 border-b py-4"
          >
            <p class="text-foreground text-base font-medium text-pretty transition-transform duration-300 group-hover:translate-x-3 sm:text-lg">
              {row.title}
            </p>
            <HugeiconsIcon
              icon={ArrowDownRight01Icon}
              size={20}
              strokeWidth={1.8}
              className="text-foreground"
              aria-hidden="true"
            />
          </a>
        ))
      }
    </div>
  </Wrapper>
</section>
