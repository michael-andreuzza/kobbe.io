---
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import Button from "./Button.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";

/**
 * Everything else: quiet hairline list rows, each one a full-row link to
 * the matching docs page. The full catalog lives on /features.
 */
/* Product capabilities first, migration and tooling reassurances last. */
const listRows = [
  {
    title: "Realtime: who is on your site right now",
    href: "/docs/realtime-visitors",
  },
  {
    title: "Funnels from pages and events you already collect",
    href: "/docs/funnels",
  },
  {
    title: "Core Web Vitals with percentile trends",
    href: "/docs/performance-web-vitals",
  },
  {
    title: "Google Search Console queries beside your traffic",
    href: "/docs/search-console",
  },
  {
    title: "Import from Plausible, Fathom, or Umami. Export anytime",
    href: "/docs/import-analytics-data",
  },
  {
    title: "A CLI, an MCP server, and a Raycast extension",
    href: "/docs/cli",
  },
];
---

<section class="mt-32">
  <Wrapper variant="default">
   
    <div class="flex items-end justify-between gap-4">
      <p class="text-foreground text-base font-medium">
        Every feature, on every plan.
      </p>
      <Button label="All features" href="/features" variant="outline" />
    </div>
    <div class="border-border mt-8 border-t">
      {
        listRows.map((row) => (
          <a
            href={row.href}
            class="group border-border grid grid-cols-[1fr_auto] items-center gap-6 border-b py-4"
          >
            <p class="text-foreground text-base text-pretty font-medium transition-transform duration-300 group-hover:translate-x-3 sm:text-lg">
              {row.title}
            </p>
            <HugeiconsIcon
              icon={ArrowDownRight01Icon}
              size={20}
              strokeWidth={1.8}
              className="text-foreground"
              aria-hidden="true"
            />
          </a>
        ))
      }
    </div>
  </Wrapper>
</section>
