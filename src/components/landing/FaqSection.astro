---
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import SectionIntro from "@/components/landing/SectionIntro.astro";
import { PricingFaq } from "@/components/sections/pricing/pricing-faq";
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section id="faq" aria-labelledby="faq-heading" class={cn("pt-8", className)}>
  <Wrapper
    variant="default"
    class="py-20"
  >
    <div class="mx-auto max-w-5xl">
      <SectionIntro
        id="faq-heading"
        title="FAQ"
        description="Quick answers about privacy, plans, setup, and support."
      />
      <PricingFaq client:load className="mt-10" headingId="faq-heading" />
    </div>
  </Wrapper>
</section>
