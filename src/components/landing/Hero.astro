---
import { Button } from "@/components/ui/button";
import StatementHero from "@/components/sections/StatementHero.astro";

const demoUrl = "https://app.kobbe.io/demo/kobbe-studio?range=30d";
---

<StatementHero
  statement="Real visitors deserve real numbers. "
  elaboration="At Kobbe, we follow the money instead of the people: traffic, conversions, and revenue in one dashboard, with no cookies, no consent banners, and no bots in your stats."
>
  <div class="mt-6 lg:hidden">
    <Button label="Live demo" href={demoUrl} variant="outline" arrow external />
  </div>
</StatementHero>
