---
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import Text from "@/components/foundations/elements/Text.astro";
import DashboardPreview from "@/components/landing/dashboard/dashboard-preview";
import { buttonVariants } from "@/components/ui/button";
---

<section>
  <Wrapper variant="default" class="pt-20 lg:pt-28">
    <div class="max-w-2xl text-balance">
      <Text
        tag="h1"
        variant="displayLG"
        class="text-foreground font-display font-medium tracking-tight"
      >
        Stop counting visitors.<br />
        Start counting revenue.
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="text-muted-foreground mt-4 font-normal"
      >
        Kobbe is privacy-first analytics that ties every page, source, and
        funnel to actual money — cookieless, GDPR-ready, live with one script
        tag.
      </Text>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="https://app.kobbe.io/demo/kobbe-studio"
          target="_blank"
          rel="noopener noreferrer"
          data-kobbe-event="Hero - see demo"
          class={buttonVariants({ variant: "brand" })}
        >
          Poke around the demo
        </a>
      </div>
      <ul
        class="text-muted-foreground mt-6 flex w-fit flex-wrap items-center  gap-x-2 gap-y-1 text-xs font-medium"
      >
        <li>No credit card required</li>
        <li aria-hidden="true">·</li>
        <li>1.8KB tracker</li>
        <li aria-hidden="true">·</li>
        <li>EU-operated</li>
        <li aria-hidden="true">·</li>
        <li>Cookieless by default</li>
        <li aria-hidden="true">·</li>
        <li>GDPR-ready</li>
        <li aria-hidden="true">·</li>
        <li>0 raw IPs stored</li>
      </ul>
    </div>
    <div class="relative mt-12">
      <DashboardPreview />
    </div>
  </Wrapper>
</section>
