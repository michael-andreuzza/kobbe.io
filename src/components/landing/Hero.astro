---
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import SectionIntro from "@/components/landing/SectionIntro.astro";
import HeroDashboardPreview from "@/components/landing/hero-dashboard-preview";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
---
<section>
  <Wrapper variant="default" class="pt-20 lg:pt-28">
    <div class="mx-auto max-w-2xl text-center">
      <SectionIntro
        title="Privacy-first web analytics with traffic and revenue in one place."
        description="Pages, sources, funnels, conversions, and revenue attribution. Private by default. Set up in seconds."
      />
      <p class="text-muted-foreground text-sm text-balance mt-4">
        No credit card required , GDPR-ready and Cookieless by default
      </p>
      <a
        href="https://app.kobbe.io/demo/kobbe-studio"
        target="_blank"
        rel="noopener noreferrer"
        data-kobbe-event="Hero - see demo"
        class={cn(buttonVariants({ variant: "outline", size: "xs" }), "flex mt-8 w-fit mx-auto")}
      >
        See the demo
      </a>
    </div>
    <div class="relative mt-12">
      <HeroDashboardPreview client:load />
    </div>
  </Wrapper>
</section>
<section>
  <Wrapper variant="default" class="py-4">
    <ul
      class="text-foreground mx-auto flex w-fit flex-wrap gap-2 text-center text-lg font-medium"
    >
      <li>1.8KB default tracker gzip</li>
      <li aria-hidden="true" class="text-muted-foreground">·</li>
      <li>EU-operated</li>
      <li aria-hidden="true" class="text-muted-foreground">·</li>
      <li>Cookieless by default</li>
      <li aria-hidden="true" class="text-muted-foreground">·</li>
      <li>GDPR-ready</li>
      <li aria-hidden="true" class="text-muted-foreground">·</li>
      <li>0 raw IPs stored</li>
    </ul>
  </Wrapper>
</section>
