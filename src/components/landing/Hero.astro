---
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import SectionIntro from "@/components/landing/SectionIntro.astro";
import HeroDashboardPreview from "@/components/landing/hero-dashboard-preview";
import { buttonVariants } from "@/components/ui/button";
---
<section>
  <Wrapper variant="default" class="pt-20 lg:pt-28">
    <div class="mx-auto max-w-xl text-center">
      <SectionIntro
        title="Know what every visit is worth."
        description="Privacy-first web analytics with traffic and revenue in one place. Pages, sources, funnels, conversions, and attribution. Set up in seconds."
      />
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="https://app.kobbe.io/demo/kobbe-studio"
          target="_blank"
          rel="noopener noreferrer"
          data-kobbe-event="Hero - see demo"
          class={buttonVariants({ variant: "outline", size: "xs" })}
        >
          See the demo
        </a>
      </div>
      <ul
        class="text-muted-foreground mx-auto mt-6 flex w-fit flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs font-medium"
      >
        <li>No credit card required</li>
        <li aria-hidden="true">·</li>
        <li>1.8KB tracker</li>
        <li aria-hidden="true">·</li>
        <li>EU-operated</li>
        <li aria-hidden="true">·</li>
        <li>Cookieless by default</li>
        <li aria-hidden="true">·</li>
        <li>GDPR-ready</li>
        <li aria-hidden="true">·</li>
        <li>0 raw IPs stored</li>
      </ul>
    </div>
    <div class="relative mt-12">
      <HeroDashboardPreview client:load />
    </div>
  </Wrapper>
</section>
