---
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import HeroFrieze from "@/components/landing/HeroFrieze.astro";
import { pricingTrialDays } from "@/components/sections/pricing/pricing-tiers";
import { Button } from "@/components/ui/button";
import { APP_DEMO_URL, APP_SIGNUP_URL } from "@/lib/site-mega-menu";
---

{/*
  The hero fills the first screenful (minus the in-flow nav bar, 3.75rem on
  both the mobile pill bar and the lg header) and the frieze is pushed to
  its bottom edge with mt-auto, so the quay always docks to the fold on any
  viewport — no per-breakpoint margin tuning.
*/}
<section class="flex min-h-[calc(100svh-3.75rem)] flex-col overflow-hidden">
  <SectionGrid
    lead="For founders and small teams,"
    title="see who visits, what they read, and what it earns."
    class="hero-statement pt-16 lg:pt-24"
  >
    <div class="flex flex-col gap-2">
      <Text
        tag="h1"
        variant="displayLG"
        class="font-medium tracking-tight leading-tight text-pretty lg:text-balance"
      >
        Privacy-first web analytics that counts people, not bots
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="text-muted-foreground max-w-md leading-relaxed text-pretty"
      >
        See which pages drive revenue, and ask your AI agents about your
        traffic. No cookies, no banners. One clear dashboard.
      </Text>
    </div>
    <div class="flex flex-wrap gap-2" data-hero-buttons>
      <Button
        label={`Start free for ${pricingTrialDays} days`}
        href={APP_SIGNUP_URL}
        variant="solid"
        arrow
        data-kobbe-event="Start trial"
        data-kobbe-event-source="hero"
      />
      <Button
        label="Live demo"
        href={`${APP_DEMO_URL}?range=30d`}
        variant="muted"
        arrow
        data-kobbe-event="Live demo"
        data-kobbe-event-source="hero"
      />
    </div>
  </SectionGrid>

  {/*
    Quay frieze under the statement: visitors passing along the quay and
    being counted. Animated cutouts, see HeroFrieze.astro. The flat versions
    (frieze-quay.webp walkers only, frieze-count.webp counting) are kept in
    src/images/illustrations.
  */}
  {/* pt = minimum clearance under the statement on short viewports (the
      frieze is scale-150 below lg and overflows its box upward). */}
  <div class="mt-auto pt-24 lg:pt-16">
    <HeroFrieze />
  </div>
</section>

{/* Hide the nav's Start free and Live demo before first paint; the script
    below brings them back once the hero buttons scroll out of view. */}
<script is:inline>
  document.documentElement.dataset.heroCta = "visible";
</script>

<script>
  let observer: IntersectionObserver | null = null;

  function watchHeroCta() {
    observer?.disconnect();
    const cta = document.querySelector("[data-hero-buttons]");
    if (!cta) return;
    observer = new IntersectionObserver(([entry]) => {
      document.documentElement.dataset.heroCta = entry.isIntersecting
        ? "visible"
        : "hidden";
    });
    observer.observe(cta);
  }

  document.addEventListener("astro:page-load", watchHeroCta);
  document.addEventListener("astro:before-swap", () => observer?.disconnect());
  watchHeroCta();
</script>

<style is:global>
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-statement {
        animation: hero-statement-lag linear both;
        animation-timeline: scroll(root);
        animation-range: 0 80svh;
      }
    }
  }

  @keyframes hero-statement-lag {
    to {
      translate: 0 6rem;
      opacity: 0.5;
    }
  }
</style>
