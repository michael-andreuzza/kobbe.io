---
/**
 * Closer in Kobbe's own voice: a quiet CTA on paper, then a muted footer
 * with the wordmark set as large as the viewport allows.
 */
import { Image } from "astro:assets";

import Logo from "@/components/assets/Logo.astro";
import village from "@/images/illustrations/watercolour-village-boatless.webp";
import boat from "@/images/illustrations/village-boat.webp";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import { APP_SIGNUP_URL } from "@/lib/site-mega-menu";
import { pricingTrialDays } from "@/components/sections/pricing/pricing-tiers";
import { Button } from "@/components/ui/button";

const columns = [
  {
    title: "Product",
    links: [
      { label: "Pricing", href: "/#pricing" },
      {
        label: "Live demo",
        href: "https://app.kobbe.io/demo/kobbe-studio?range=30d",
      },
      { label: "All features", href: "/features" },
      { label: "Changelog", href: "/changelog" },
      { label: "Wallpapers", href: "/wallpapers" },
    ],
  },
  {
    title: "Docs",
    links: [
      { label: "Get started", href: "/docs" },
      { label: "Add the tracker", href: "/docs/add-the-tracker" },
      { label: "Install guides", href: "/docs/installation-guides" },
      { label: "CLI and MCP", href: "/docs/cli" },
      { label: "Import your data", href: "/docs/import-analytics-data" },
    ],
  },
  {
    title: "Support",
    links: [
      { label: "Contact", href: "/support/contact" },
      { label: "FAQ", href: "/support/faq" },
      { label: "Charges", href: "/support/charges" },
      { label: "Billing and usage", href: "/docs/billing-and-usage-limits" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "/legal/privacy" },
      { label: "Terms", href: "/legal/terms" },
      { label: "GDPR", href: "/legal/gdpr-compliance" },
      { label: "DPA", href: "/legal/dpa" },
    ],
  },
  {
    title: "Resources",
    links: [
      {
        label: "Astro Themes",
        href: "https://lexingtonthemes.com",
        external: true,
      },
    ],
  },
];
---

<footer>
  <Wrapper variant="default" class="pt-24 pb-8">
    {/* Quiet CTA in the hero's two-tone voice */}
    <div
      class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between"
    >
      <h2
        class="max-w-2xl text-[clamp(1.5rem,2.5vw,2.25rem)] leading-tight tracking-tight text-balance"
      >
        <span class="text-foreground"
          >Find out what your traffic is actually worth.</span
        >{" "}<span class="text-muted-foreground"
          >Free for {pricingTrialDays} days, no credit card required.</span
        >
      </h2>
      <Button
        variant="solid"
        label={`Try free for ${pricingTrialDays} days`}
        href={APP_SIGNUP_URL}
      />
    </div>
  </Wrapper>

  {/*
    Muted full-bleed closer: the links sit in the blank sky of the drawing and
    the drawing runs edge to edge along the bottom of the page.
  */}
  <div class="text-foreground mt-12">
    <Wrapper variant="default" class="relative z-10 pt-12 lg:pt-16">
      {/* Logo and site links */}
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-12">
        {/* Logo and five link columns share the row on large screens. */}
        <div class="col-span-2 sm:col-span-3 lg:col-span-2">
          <a href="/" aria-label="Kobbe home">
            <Logo class="text-foreground size-8" />
          </a>
        </div>
        {
          columns.map((column) => (
            <div class="space-y-2 lg:col-span-2">
              <p class="text-foreground text-xs font-semibold">
                {column.title}
              </p>
              <ul class="space-y-0.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      {...("external" in link && link.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                      class="text-muted-foreground hover:text-foreground text-xs font-medium transition-colors"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Wrapper>

    {/*
      Åland village watercolour, full viewport width. 2560px WebP with the
      paper knocked out to alpha so it sits on the page background. Built
      with the Real-ESRGAN pipeline documented in
      scripts/footer-illustration-alpha.py. The all-red-houses variant is
      src/images/illustrations/watercolour-village.webp. The rowing boat is
      cut out as its own sprite (scripts/footer-boat-sprite.py) and overlaid
      below so it can bob on its mooring; the base image has water cloned
      over the hull.
    */}
    <div class="relative mt-8">
      <Image
        src={village}
        alt=""
        class="pointer-events-none aspect-3/1 w-full object-cover object-bottom"
        widths={[768, 1280, 1920, 2560]}
        sizes="100vw"
        loading="lazy"
      />
      {/* The moored rowing boat, bobbing gently. Position and size are the
          sprite's cutout box as percentages of the 2560x853 drawing, so it
          tracks the responsive image exactly. */}
      <Image
        src={boat}
        alt=""
        class="footer-boat pointer-events-none absolute"
        loading="lazy"
      />
      {/* Copyright overlaid on the calm water, bottom right */}
      <Wrapper
        variant="default"
        class="absolute inset-x-0 bottom-4 lg:bottom-6"
      >
        <div
          class="text-foreground ml-auto flex w-fit flex-wrap justify-end gap-x-4 gap-y-1 text-right text-xs font-medium"
        >
          <span>© 2026 Kobbe. All rights reserved.</span>
          <span>Made in Åland Islands, Finland. EU</span>
        </div>
      </Wrapper>
    </div>
  </div>
</footer>

<style>
  /* Sprite box from scripts/footer-boat-sprite.py: 290x94 at (1620,619) in
     the 2560x853 drawing. translateY percentages are of the sprite's own
     height, so the bob stays proportional at every viewport width. */
  .footer-boat {
    left: 63.28%;
    top: 72.57%;
    width: 11.33%;
    transform-origin: 50% 100%;
    animation: footer-boat-bob 4s ease-in-out infinite alternate;
  }

  @keyframes footer-boat-bob {
    from {
      transform: translateY(3%) rotate(1deg);
    }
    to {
      transform: translateY(-6%) rotate(-1.2deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-boat {
      animation: none;
    }
  }
</style>
