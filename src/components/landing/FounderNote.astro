---
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import Text from "@/components/foundations/elements/Text.astro";
import founderAvatar from "@/images/assets/michael-andreuzza.jpg";
---

<section aria-label="A note from the founder">
  <Wrapper variant="default" class="py-20">
    <div class="max-w-2xl space-y-8">
      <Text
        tag="p"
        variant="displayXS"
        class="text-foreground font-medium tracking-tight text-balance"
      >
        I make my living building websites, and I was never happy with the
        analytics behind them &mdash; they either tracked too much or told me
        too little. Kobbe is the tool I wanted for my own sites: open the
        dashboard, read it, make a decision, get back to work.
      </Text>
      <Text tag="p" variant="textBase" class="text-muted-foreground">
        I use it every day and build it in the open. If something is missing,
        tell me &mdash; there is a good chance I will ship it.
      </Text>
      <div class="flex items-center gap-3">
        <img
          src={founderAvatar.src}
          alt="Michael Andreuzza"
          class="size-10 rounded-full object-cover"
          loading="lazy"
          width="40"
          height="40"
        />
        <div>
          <Text tag="p" variant="textSM" class="text-foreground font-medium">
            Michael Andreuzza
          </Text>
          <Text tag="p" variant="textSM" class="text-muted-foreground">
            Founder &middot;{" "}
            <a
              href="https://x.com/Mike_Andreuzza"
              rel="noreferrer"
              target="_blank"
              class="hover:text-foreground transition-colors duration-200"
              >@Mike_Andreuzza</a
            >
          </Text>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
