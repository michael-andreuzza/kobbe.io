---
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import DashboardCapabilityGrid from "@/components/landing/dashboard/dashboard-capability-grid";
import FeatureGrid from "@/components/landing/FeatureGrid.astro";
import SectionIntro from "@/components/landing/SectionIntro.astro";
---

<section class="pt-8">
  <Wrapper class="py-20">
    <div class="mx-auto max-w-xl text-center">
      <SectionIntro
        title="Every view you open should answer a real question."
        description="Traffic and revenue, referrers, conversions, search keywords, custom events, realtime visitors, broken links, funnels, performance, history import, agent access, and a one-line install, all in the same dashboard."
      />
    </div>
    <div class="mt-12">
      <DashboardCapabilityGrid client:load />
      <FeatureGrid />
    </div>
  </Wrapper>
</section>
