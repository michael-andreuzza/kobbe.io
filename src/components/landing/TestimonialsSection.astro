---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import Text from "@/components/foundations/elements/Text.astro";
import eelcoAvatar from "@/images/customers/eelco.webp";
import pawelOlekAvatar from "@/images/customers/pawel-olek.webp";

type Testimonial = {
  quote: string;
  name: string;
  company: string;
  avatar: ImageMetadata;
};

const testimonials: Testimonial[] = [
  {
    quote: "Best looking analytics out there.",
    name: "Eelco",
    company: "Trevize.dev",
    avatar: eelcoAvatar,
  },
  {
    quote: "It looks really nice, clean and clear.",
    name: "Pawel Olek",
    company: "emblemo.space",
    avatar: pawelOlekAvatar,
  },
];
---

<section id="testimonials" aria-labelledby="testimonials-heading">
  <Wrapper variant="default" class="py-10">
    <Text
      tag="h2"
      variant="displayMD"
      class="text-foreground font-display text-center sr-only"
    >
      Testimonials
    </Text>
    <div
      class="mx-auto flex w-fit flex-col items-start gap-x-14 gap-y-5 md:flex-row md:items-center"
    >
      {
        testimonials.map((testimonial) => (
          <figure class="flex items-center gap-3">
            <Image
              src={testimonial.avatar}
              alt=""
              width={32}
              height={32}
              class="border-border size-8 shrink-0 rounded-full border object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="min-w-0">
              <blockquote>
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-foreground font-medium text-pretty"
                >
                  “{testimonial.quote}”
                </Text>
              </blockquote>
              <figcaption>
                <Text tag="p" variant="textSM" class="text-muted-foreground">
                  {testimonial.name} · {testimonial.company}
                </Text>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </Wrapper>
</section>
