---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import Text from "@/components/foundations/elements/Text.astro";
import eelcoAvatar from "@/images/customers/eelco.webp";
import pawelOlekAvatar from "@/images/customers/pawel-olek.webp";

type Testimonial = {
  quote: string;
  name: string;
  company: string;
  avatar: ImageMetadata;
};

const testimonials: Testimonial[] = [
  {
    quote: "Best looking analytics out there.",
    name: "Eelco",
    company: "Trevize.dev",
    avatar: eelcoAvatar,
  },
  {
    quote: "It looks really nice, clean and clear.",
    name: "Pawel Olek",
    company: "emblemo.space",
    avatar: pawelOlekAvatar,
  },
];
---

<section id="testimonials" aria-labelledby="testimonials-heading">
  <Wrapper variant="default" class="py-10">
    <Text
     
      tag="h2"
      variant="displayMD"
      class="text-foreground font-display text-center sr-only"
    >
      Testimonials
    </Text>
    <div
      class="mx-auto  grid  grid-cols-1 gap-8 md:grid-cols-2 "
    >
      {
        testimonials.map((testimonial) => (
          <figure class="flex flex-col">
            <blockquote class="flex-1">
              <Text
                tag="p"
                variant="textBase"
                class="text-foreground text-center text-pretty font-normal"
              >
                “{testimonial.quote}”
              </Text>
            </blockquote>
            <figcaption class="mt-6 flex items-center justify-center gap-3">
              <Image
                src={testimonial.avatar}
                alt=""
                width={40}
                height={40}
                class="border-border size-10 shrink-0 rounded-full border object-cover"
                loading="lazy"
                decoding="async"
              />
              <div class="text-left">
                <Text
                  tag="p"
                  variant="textSM"
                  class="text-foreground font-medium"
                >
                  {testimonial.name}
                </Text>
                <Text tag="p" variant="textSM" class="text-muted-foreground">
                  {testimonial.company}
                </Text>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Wrapper>
</section>
