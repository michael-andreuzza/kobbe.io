---
import "@/styles/blur.css";

/**
 * Progressive blur along one edge.
 *
 * `edge="bottom"` (default) is scroll-aware: it fades out once you reach
 * the end of the page. Fixed to the viewport edge by default; `contained`
 * makes it absolute inside the nearest positioned ancestor, tracking a
 * sibling scroll container marked with `data-progressive-blur-scroll`.
 *
 * `edge="top"` is a static backdrop for the sticky nav: absolute inside the
 * header, always visible, no scroll tracking.
 */
interface Props {
  class?: string;
  edge?: "top" | "bottom";
  contained?: boolean;
}

const {
  class: className = "",
  edge = "bottom",
  contained = false,
} = Astro.props;
const isBottom = edge === "bottom";
const containedClass = isBottom && contained ? "progressive-blur-contained" : "";
---

<div
  class={`progressive-blur-${edge} ${containedClass} ${className}`.trim()}
  data-progressive-blur={isBottom ? "bottom" : undefined}
  data-progressive-blur-contained={isBottom && contained ? "" : undefined}
  aria-hidden="true"
>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
  <div></div>
</div>

<script is:inline>
  (function () {
    if (window.__progressiveBlurInit) return;
    window.__progressiveBlurInit = true;

    var threshold = 8;
    var sync = function () {
      document
        .querySelectorAll("[data-progressive-blur]")
        .forEach(function (el) {
          var maxScroll;
          var y;
          if (el.hasAttribute("data-progressive-blur-contained")) {
            var source =
              el.parentElement &&
              el.parentElement.querySelector("[data-progressive-blur-scroll]");
            if (!source) return;
            maxScroll = source.scrollHeight - source.clientHeight;
            y = source.scrollTop;
          } else {
            maxScroll =
              document.documentElement.scrollHeight - window.innerHeight;
            y = window.scrollY;
          }
          var show = maxScroll > 1 && y < maxScroll - threshold;
          el.style.opacity = show ? "1" : "0";
        });
    };
    sync();
    // Capture phase so scrolls of inner containers are caught too
    // (element scroll events don't bubble).
    window.addEventListener("scroll", sync, { passive: true, capture: true });
    window.addEventListener("resize", sync, { passive: true });
    // Re-check once styles and fonts have settled; scrollability can
    // change after first paint.
    window.addEventListener("load", sync);
    // New page height after every ClientRouter swap.
    document.addEventListener("astro:page-load", sync);
  })();
</script>
