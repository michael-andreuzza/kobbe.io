---
/**
 * Global navigation, shared by the landing page and everything else.
 * Desktop: a brand pill (logo chip + Menu trigger) on the left, a matching
 * pill with Pricing, Live demo, Sign in, and Try free on the right, always
 * visible via sticky. The Menu trigger opens the mega menu panel with the
 * same link columns as the mobile side panel.
 * Mobile: plain header row opening the side panel with the same links.
 */
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import ProgressiveBlur from "@/components/global/ProgressiveBlur.astro";
import { SiteMobileMenu } from "@/components/global/site-mobile-menu";
import Logo from "@/components/assets/Logo.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import {
  APP_SIGNIN_URL,
  APP_SIGNUP_URL,
  siteMegaMenuGuideGroups,
  siteNavLinks,
} from "@/lib/site-mega-menu";

const DEMO_URL = "https://app.kobbe.io/demo/kobbe-studio?range=30d";

// Three sections: product (features, docs, changelog), docs pages, and the
// platform guide grids. Picks come from the list shared with the mobile panel;
// install and revenue index links are skipped since they get logo grids.
const featuresLink = siteNavLinks.find((link) => link.id === "features");
const raycastLink = siteNavLinks.find((link) => link.id === "raycast");
const docsPageLinks = siteNavLinks.filter(
  (link) =>
    link.id !== "features" &&
    link.id !== "raycast" &&
    link.id !== "install-guides" &&
    link.id !== "revenue-attribution",
);
---

<header class="sticky top-0 z-50 hidden py-2.5 lg:block">
  <ProgressiveBlur edge="top" />
  <Wrapper variant="nav" class="relative flex items-center justify-between">
    {
      /* Not `relative`: the panel positions against the Wrapper so it spans the whole nav. */
    }
    <div data-mega-menu>
      <div
        class="bg-muted-surface flex items-center gap-1 rounded-lg p-1 text-sm"
      >
        <a
          href="/"
          class="bg-surface flex size-8 items-center justify-center rounded-md shadow-xs"
          aria-label="Kobbe home"
        >
          <Logo class="text-foreground size-4.5" />
        </a>
        <button
          type="button"
          class="text-foreground py-1.5 pr-2.5 pl-1.5 font-medium transition-opacity hover:opacity-70"
          aria-expanded="false"
          aria-haspopup="true"
          data-mega-menu-trigger
        >
          Menu
        </button>
      </div>
      <nav
        class="bg-dark-background text-surface ring-border absolute inset-x-8 top-full mt-2 hidden overflow-hidden rounded-lg shadow-lg"
        aria-label="Primary"
        data-mega-menu-panel
      >
        <div class="divide-surface/10 grid grid-cols-4 divide-x">
          {/* Section 1: product. */}
          <div class="p-7">
            <p class="text-surface text-sm font-medium">Product</p>
            <div class="mt-5 flex flex-col gap-7">
              {
                featuresLink ? (
                  <a href={featuresLink.href} class="group block">
                    <span class="text-surface block text-sm font-medium transition-opacity group-hover:opacity-70">
                      {featuresLink.label}
                    </span>
                    <span class="text-surface/70 mt-1 block text-sm leading-snug">
                      {featuresLink.description}
                    </span>
                  </a>
                ) : null
              }
              <a href="/docs" class="group block">
                <span
                  class="text-surface flex items-center gap-1 text-sm font-medium transition-opacity group-hover:opacity-70"
                >
                  Read the docs
                  <HugeiconsIcon
                    icon={ArrowUpRight01Icon}
                    size={16}
                    strokeWidth={2}
                    aria-hidden="true"
                  />
                </span>
                <span class="text-surface/70 mt-1 block text-sm leading-snug">
                  Guides for setup, tracking, and dashboards, plus every
                  installation and revenue guide.
                </span>
              </a>
              <a href="/changelog" class="group block">
                <span
                  class="text-surface flex items-center gap-1 text-sm font-medium transition-opacity group-hover:opacity-70"
                >
                  Changelog
                  <HugeiconsIcon
                    icon={ArrowUpRight01Icon}
                    size={16}
                    strokeWidth={2}
                    aria-hidden="true"
                  />
                </span>
                <span class="text-surface/70 mt-1 block text-sm leading-snug">
                  New features and fixes as they ship.
                </span>
              </a>
              {
                raycastLink ? (
                  <a href={raycastLink.href} class="group block">
                    <span class="text-surface block text-sm font-medium transition-opacity group-hover:opacity-70">
                      {raycastLink.label}
                    </span>
                    <span class="text-surface/70 mt-1 block text-sm leading-snug">
                      {raycastLink.description}
                    </span>
                  </a>
                ) : null
              }
            </div>
          </div>

          {/* Section 2: docs pages, spanning two columns. */}
          <div class="col-span-2 p-7">
            <p class="text-surface text-sm font-medium">Docs</p>
            <ul class="mt-5 grid grid-cols-2 content-start gap-x-8 gap-y-7">
              {
                docsPageLinks.map((link) => (
                  <li>
                    <a href={link.href} class="group block">
                      <span class="text-surface block text-sm font-medium transition-opacity group-hover:opacity-70">
                        {link.label}
                      </span>
                      {link.description ? (
                        <span class="text-surface/70 mt-1 block text-sm leading-snug">
                          {link.description}
                        </span>
                      ) : null}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          {/* Section 3: featured platforms per guide family, stacked. */}
          <div class="flex flex-col gap-7 p-7">
            {
              siteMegaMenuGuideGroups.map((group) => (
                <div>
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="text-surface text-sm font-medium">
                      {group.title}
                    </p>
                    <a
                      href={group.seeAllHref}
                      class="text-surface/70 hover:text-surface shrink-0 text-xs font-medium transition-colors"
                    >
                      See all
                    </a>
                  </div>
                  <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2">
                    {group.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="text-surface/80 hover:text-surface flex items-center gap-2 text-sm transition-colors"
                        >
                          <img
                            src={link.logo.src}
                            alt=""
                            width={16}
                            height={16}
                            loading="lazy"
                            class="size-4 shrink-0 rounded-xs object-contain"
                          />
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </nav>
    </div>
    <div
      class="bg-muted-surface flex items-center gap-1 rounded-lg p-1 text-sm"
    >
      <a
        href="/#pricing"
        class="text-foreground py-1.5 pr-1.5 pl-2.5 font-medium transition-opacity hover:opacity-70"
      >
        Pricing
      </a>
      <a
        href={DEMO_URL}
        class="text-foreground px-1.5 py-1.5 font-medium transition-opacity hover:opacity-70"
      >
        Live demo
      </a>
      <a
        href={APP_SIGNIN_URL}
        class="text-foreground px-1.5 py-1.5 font-medium transition-opacity hover:opacity-70"
      >
        Sign in
      </a>
      <a
        href={APP_SIGNUP_URL}
        class="bg-dark-background text-surface hover:bg-dark-background/85 rounded-md px-3 py-1.5 font-medium transition-colors"
      >
        Try free for 15 days
      </a>
    </div>
  </Wrapper>
</header>

<header class="sticky top-0 z-40 lg:hidden">
  <ProgressiveBlur edge="top" />
  <Wrapper variant="nav" class="relative">
    <SiteMobileMenu client:load>
      <Logo class="text-foreground size-4.5" />
    </SiteMobileMenu>
  </Wrapper>
</header>

<script>
  // Mega menu behavior: toggle on click, close on outside click, Escape,
  // or picking a link.
  function bindMenu() {
    const root = document.querySelector<HTMLElement>("[data-mega-menu]");
    const trigger = root?.querySelector<HTMLButtonElement>(
      "[data-mega-menu-trigger]",
    );
    const panel = root?.querySelector<HTMLElement>("[data-mega-menu-panel]");
    if (!root || !trigger || !panel || root.dataset.bound) return;
    root.dataset.bound = "true";

    const setOpen = (open: boolean) => {
      panel.classList.toggle("hidden", !open);
      panel.classList.toggle("block", open);
      trigger.setAttribute("aria-expanded", String(open));
    };

    trigger.addEventListener("click", () => {
      setOpen(panel.classList.contains("hidden"));
    });
    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }

  // Re-bind on every swap; the ClientRouter replaces the document.
  document.addEventListener("astro:page-load", bindMenu);
  bindMenu();
</script>
