---
/**
 * Global navigation, shared by the landing page and everything else.
 * Desktop: a brand pill (logo chip + Menu trigger) on the left, a matching
 * pill with Pricing, Live demo, Sign in, and Start free on the right, always
 * visible via sticky. The Menu trigger opens the mega menu panel with the
 * same link columns as the mobile side panel.
 * Mobile: plain header row opening the side panel with the same links.
 */
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import ProgressiveBlur from "@/components/global/ProgressiveBlur.astro";
import { SiteMobileMenu } from "@/components/global/site-mobile-menu";
import Logo from "@/components/assets/Logo.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import {
  APP_SIGNIN_URL,
  APP_SIGNUP_URL,
  siteMegaMenuGuideGroups,
  siteNavLinks,
} from "@/lib/site-mega-menu";

interface Props {
  /** Render the desktop header. The docs shell has its own. */
  desktop?: boolean;
}

const { desktop = true } = Astro.props;

const DEMO_URL = "https://app.kobbe.io/demo/kobbe-studio?range=30d";

// Five columns of plain lists, all styled alike. Picks come from the list
// shared with the mobile panel; install and revenue index links are skipped
// since their guide groups carry a "See all" arrow instead.
type MenuSection = {
  title: string;
  seeAllHref?: string;
  links: { href: string; label: string; logo?: { src: string } }[];
};

const productIds = ["features", "ai-agents", "compare"];
const pick = (id: string) => siteNavLinks.find((link) => link.id === id);
const productLinks = [
  pick("features"),
  { href: "/docs", label: "Docs" },
  { href: "/changelog", label: "Changelog" },
  pick("ai-agents"),
  pick("compare"),
].filter((link) => link != null);
const docsPageLinks = siteNavLinks.filter(
  (link) =>
    !productIds.includes(link.id) &&
    link.id !== "install-guides" &&
    link.id !== "revenue-attribution",
);
const guideGroup = (id: string) =>
  siteMegaMenuGuideGroups.find((group) => group.id === id);
const installGroup = guideGroup("install");
const revenueGroup = guideGroup("revenue");
const importGroup = guideGroup("import");

const menuColumns: MenuSection[] = [
  { title: "Product", links: productLinks },
  { title: "Docs", seeAllHref: "/docs", links: docsPageLinks },
  installGroup,
  revenueGroup,
  importGroup,
].filter((section) => section != null);
---

{desktop && (
<header class="sticky top-0 z-50 hidden py-2.5 lg:block">
  <ProgressiveBlur edge="top" />
  <Wrapper variant="nav" class="relative flex items-center justify-between">
    {
      /* Not `relative`: the panel positions against the Wrapper so it spans the whole nav. */
    }
    <div data-mega-menu>
      <div
        class="bg-muted-surface flex items-center gap-1 rounded-lg p-1 text-sm"
      >
        <a
          href="/"
          class="bg-surface flex size-8 items-center justify-center rounded-md shadow-xs"
          aria-label="Kobbe home"
        >
          <Logo class="text-foreground size-4.5" />
        </a>
        <button
          type="button"
          class="text-foreground py-1.5 pr-2.5 pl-1.5 font-medium transition-opacity hover:opacity-70"
          aria-expanded="false"
          aria-haspopup="true"
          data-mega-menu-trigger
        >
          Menu
        </button>
      </div>
      <nav
        class="bg-dark-background text-surface ring-border absolute inset-x-8 top-full mt-2 hidden overflow-hidden rounded-lg shadow-lg"
        aria-label="Primary"
        data-mega-menu-panel
      >
        <div class="divide-surface/10 grid grid-cols-5 divide-x">
          {
            menuColumns.map((section) => (
              <div class="p-7">
                {section.seeAllHref ? (
                  <a
                    href={section.seeAllHref}
                    class="group text-surface flex items-center justify-between gap-3 text-sm font-medium"
                    aria-label={`See all ${section.title.toLowerCase()}`}
                  >
                    {section.title}
                    <HugeiconsIcon
                      icon={ArrowDownRight01Icon}
                      size={16}
                      strokeWidth={2}
                      className="text-surface/70 group-hover:text-surface shrink-0 transition-colors"
                      aria-hidden="true"
                    />
                  </a>
                ) : (
                  <p class="text-surface text-sm font-medium">
                    {section.title}
                  </p>
                )}
                <ul class="mt-4 flex flex-col gap-2.5">
                  {section.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="text-surface/80 hover:text-surface flex items-center gap-2 text-sm transition-colors"
                      >
                        {link.logo ? (
                          <img
                            src={link.logo.src}
                            alt=""
                            width={16}
                            height={16}
                            loading="lazy"
                            class="size-4 shrink-0 rounded-xs object-contain"
                          />
                        ) : null}
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </nav>
    </div>
    <div
      class="bg-muted-surface flex items-center gap-1 rounded-lg p-1 text-sm"
    >
      <a
        href="/#pricing"
        class="text-foreground py-1.5 pr-1.5 pl-2.5 font-medium transition-opacity hover:opacity-70"
      >
        Pricing
      </a>
      <a
        href={DEMO_URL}
        class="text-foreground px-1.5 py-1.5 font-medium transition-opacity hover:opacity-70"
        data-nav-cta
        data-kobbe-event="Live demo"
        data-kobbe-event-source="nav"
      >
        Live demo
      </a>
      <a
        href={APP_SIGNIN_URL}
        class="text-foreground px-1.5 py-1.5 font-medium transition-opacity hover:opacity-70"
      >
        Sign in
      </a>
      <a
        href={APP_SIGNUP_URL}
        class="bg-dark-background text-surface hover:bg-dark-background/85 rounded-md px-3 py-1.5 font-medium transition-colors"
        data-nav-cta
        data-kobbe-event="Start trial"
        data-kobbe-event-source="nav"
      >
        Start free for 15 days
      </a>
    </div>
  </Wrapper>
</header>
)}

<header class="sticky top-0 z-40 lg:hidden">
  <ProgressiveBlur edge="top" />
  <Wrapper variant="nav" class="relative">
    <SiteMobileMenu client:load>
      <Logo class="text-foreground size-4.5" />
    </SiteMobileMenu>
  </Wrapper>
</header>

<style is:global>
  /* On the homepage the hero carries these buttons; they join the nav
     once the hero's copies scroll away. Other pages never set the flag. */
  [data-nav-cta] {
    max-width: 14rem;
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease 0.1s,
      visibility 0s;
  }
  /* Collapsed items still sit in the pill's flex gap; the negative margin
     cancels it so the pill matches its two-link width exactly. */
  html[data-hero-cta="visible"] [data-nav-cta] {
    max-width: 0;
    padding-inline: 0;
    margin-inline-start: -0.25rem;
    opacity: 0;
    visibility: hidden;
    transition:
      max-width 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.15s ease,
      visibility 0s 0.35s;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-nav-cta],
    html[data-hero-cta="visible"] [data-nav-cta] {
      transition: none;
    }
  }
</style>

<script>
  // Mega menu behavior: toggle on click, close on outside click, Escape,
  // or picking a link.
  function bindMenu() {
    const root = document.querySelector<HTMLElement>("[data-mega-menu]");
    const trigger = root?.querySelector<HTMLButtonElement>(
      "[data-mega-menu-trigger]",
    );
    const panel = root?.querySelector<HTMLElement>("[data-mega-menu-panel]");
    if (!root || !trigger || !panel || root.dataset.bound) return;
    root.dataset.bound = "true";

    const setOpen = (open: boolean) => {
      panel.classList.toggle("hidden", !open);
      panel.classList.toggle("block", open);
      trigger.setAttribute("aria-expanded", String(open));
    };

    trigger.addEventListener("click", () => {
      setOpen(panel.classList.contains("hidden"));
    });
    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("click", (event) => {
      if (!root.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }

  // Re-bind on every swap; the ClientRouter replaces the document.
  document.addEventListener("astro:page-load", bindMenu);
  bindMenu();
</script>
