---
import SiteHeaderNav from "@/components/global/site-header-nav";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";

interface Props {
  docsNavGroups?: {
    category: string;
    items: {
      href: string;
      label: string;
      isActive: boolean;
    }[];
  }[];
}

const { docsNavGroups } = Astro.props;
---

<header
  data-site-header
  class="bg-background sticky top-0 z-40 overflow-visible"
>
  <Wrapper variant="nav" class="overflow-visible">
    <SiteHeaderNav client:load docsNavGroups={docsNavGroups} />
  </Wrapper>
</header>
