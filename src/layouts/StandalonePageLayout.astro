---
/**
 * Legal and support pages in the changelog permalink layout: section line,
 * sans title, prose body, then the sibling pages in the same hairline rows.
 */
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";

interface Props {
  section: string;
  navLabel: string;
  title: string;
  description: string;
  path: string;
  othersTitle: string;
  others: { href: string; title: string }[];
}

const { section, navLabel, title, description, path, othersTitle, others } =
  Astro.props;
---

<BaseLayout
  title={`${title}: Kobbe`}
  description={description}
  jsonLdBreadcrumbs={[{ name: title, item: path }]}
>
  <section class="pt-24 pb-32">
    <Wrapper variant="default">
      <div class="mx-auto max-w-2xl">
        <article>
          <p class="text-muted-foreground text-sm">
            {section} <span aria-hidden="true">/</span> {navLabel}
          </p>
          <h1
            class="text-foreground mt-4 text-2xl leading-tight font-medium tracking-tight text-balance sm:text-3xl"
          >
            {title}
          </h1>
          <div class="mt-10">
            <Wrapper variant="prose">
              <slot />
            </Wrapper>
          </div>
        </article>

        <aside class="mt-32">
          <h2 class="text-foreground text-lg font-medium text-pretty">
            {othersTitle}
          </h2>
          <div class="border-border mt-8 border-t">
            {
              others.map((other) => (
                <a
                  href={other.href}
                  class="group border-border grid grid-cols-[1fr_auto] items-center gap-6 border-b py-5"
                >
                  <span class="text-foreground block text-base font-medium text-pretty transition-transform duration-300 group-hover:translate-x-3">
                    {other.title}
                  </span>
                  <HugeiconsIcon
                    icon={ArrowDownRight01Icon}
                    size={20}
                    strokeWidth={1.8}
                    className="text-foreground"
                    aria-hidden="true"
                  />
                </a>
              ))
            }
          </div>
        </aside>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
