---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navigation from "@/components/global/Navigation.astro";
import Footer from "@/components/landing/Footer.astro";
import ProgressiveBlur from "@/components/global/ProgressiveBlur.astro";

import SiteSeo from "@/components/foundations/head/SiteSeo.astro";
import type { JsonLdBreadcrumb } from "@/lib/seo/json-ld";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageHeight?: number;
  ogImageWidth?: number;
  twitterImage?: string;
  ogType?: string;
  noindex?: boolean;
  nofollow?: boolean;
  jsonLdBreadcrumbs?: JsonLdBreadcrumb[];
  jsonLdExtra?: Record<string, unknown>[];
  /** Extra classes for the bottom progressive blur. */
  blurClass?: string;
  /** Render the site navigation. Defaults to true. */
  nav?: boolean;
  /** Render the CTA + site footer. Docs and the 404 page turn it off. */
  footer?: boolean;
}

const {
  title = "Kobbe: Web analytics that respect your visitors",
  description = "Privacy-friendly, cookie-free website analytics. See your traffic, top pages, referrers, locations, and devices in a clean dashboard.",
  canonical,
  ogImage,
  ogImageAlt,
  ogImageHeight,
  ogImageWidth,
  twitterImage,
  ogType,
  noindex,
  nofollow,
  jsonLdBreadcrumbs,
  jsonLdExtra,
  blurClass,
  nav = true,
  footer = true,
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    {
      /* Inter is the only font above the fold on most pages; preload it so
         the browser fetches it in parallel with CSS instead of waiting for
         fonts.css to parse. Geist Mono stays on-demand for code blocks. */
    }
    <link
      rel="preload"
      href="/fonts/Inter/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SiteSeo
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageHeight={ogImageHeight}
      ogImageWidth={ogImageWidth}
      twitterImage={twitterImage}
      ogType={ogType}
      noindex={noindex}
      nofollow={nofollow}
      jsonLdBreadcrumbs={jsonLdBreadcrumbs}
      jsonLdExtra={jsonLdExtra}
    />
    <script
      is:inline
      src="https://app.kobbe.io/tracker.full.js"
      data-token="996f51cb.0EZHVIaNsKiNLpfqBR_RmtZ0jj_obT4O"
      data-campaigns="true"
      data-performance="true"
      data-revenue-attribution="true"
      defer></script>
    {
      /* Hand the tracker's attribution ID to app.kobbe.io so our own Polar
        checkout attributes back to the marketing pages that led to it. Links
        are decorated at load (keyboard, middle-click, copy-link all work) and
        again on pointerdown for anchors that rendered before the tracker
        finished loading. */
    }
    <script is:inline>
      (function () {
        var PARAM = "kobbe_attribution_id";
        function attributionId() {
          var k = window.kobbe;
          if (!k || typeof k.getAttributionId !== "function") return null;
          return k.getAttributionId() || null;
        }
        function decorate(anchor, id) {
          var raw = anchor.getAttribute("href");
          if (!raw) return;
          var url;
          try {
            url = new URL(raw, window.location.href);
          } catch (_) {
            return;
          }
          if (url.hostname !== "app.kobbe.io") return;
          if (url.pathname.indexOf("/demo") === 0) return;
          if (url.searchParams.get(PARAM) === id) return;
          url.searchParams.set(PARAM, id);
          anchor.setAttribute("href", url.toString());
        }
        function decorateAll() {
          var id = attributionId();
          if (!id) return false;
          var anchors = document.querySelectorAll('a[href*="app.kobbe.io"]');
          for (var i = 0; i < anchors.length; i++) decorate(anchors[i], id);
          return true;
        }
        function decorateWhenReady() {
          var attempts = 0;
          (function tick() {
            if (decorateAll() || attempts++ > 40) return;
            setTimeout(tick, 250);
          })();
        }
        document.addEventListener("astro:page-load", decorateWhenReady);
        document.addEventListener(
          "pointerdown",
          function (event) {
            var target = event.target;
            var anchor =
              target && target.closest ? target.closest("a[href]") : null;
            if (!anchor) return;
            var id = attributionId();
            if (id) decorate(anchor, id);
          },
          true,
        );
      })();
    </script>
    {
      /* SPA-style navigation: pages swap in-place instead of full document
        loads. This sidesteps Chrome's input suppression during cross-document
        paint holding, which was eating rapid clicks on the docs pagination.
        Inline scripts re-initialize on the astro:page-load event. */
    }
    <ClientRouter />
  </head>
  <body class="bg-background flex min-h-svh min-w-0 flex-col antialiased">
    {nav && <Navigation />}
    {
      /* No `isolate` here: it would trap the page's fixed UI (mobile nav card,
        floating mega menu) in main's stacking context, painting it below the
        body-level progressive blur. */
    }
    <main class="min-w-0 grow">
      <slot />
      {footer && <Footer />}
    </main>
    <ProgressiveBlur class={blurClass} />
  </body>
</html>
