---
import BaseLayout from "./BaseLayout.astro";
import SiteSidebar from "@/components/global/SiteSidebar.astro";
import type { JsonLdBreadcrumb } from "@/lib/seo/json-ld";

/**
 * Marketing shell with the fixed showcase sidebar instead of the top
 * navigation. The mega menu stays reachable through the sidebar's Explore
 * entry; content renders as rounded panels in the feed area.
 */
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  jsonLdBreadcrumbs?: JsonLdBreadcrumb[];
  docsNavGroups?: {
    category: string;
    items: { href: string; label: string; isActive: boolean }[];
  }[];
}

const {
  title,
  description,
  canonical,
  noindex,
  nofollow,
  jsonLdBreadcrumbs,
  docsNavGroups,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  nofollow={nofollow}
  jsonLdBreadcrumbs={jsonLdBreadcrumbs}
  blurClass="lg:[--progressive-blur-left:20rem]"
>
  <div class="min-h-svh lg:pl-80">
    <SiteSidebar compactMobile docsNavGroups={docsNavGroups} />
    <div class="flex flex-col gap-2 p-2 lg:py-2 lg:pr-2 lg:pl-0">
      <slot />
    </div>
  </div>
</BaseLayout>
