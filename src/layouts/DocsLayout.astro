---
import Text from "@/components/foundations/elements/Text.astro";
import SidebarLayout from "./SidebarLayout.astro";
import ProgressiveBlur from "@/components/global/ProgressiveBlur.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import ToCScript from "@/components/foundations/scripts/ToCScript.astro";
import TableOfContents from "@/components/foundations/navigation/TableOfContents.astro";
import { DocsCommandSearch } from "@/components/docs/docs-command-search";
import type { JsonLdBreadcrumb } from "@/lib/seo/json-ld";
import { buildDocsNavLinks, groupDocsNavLinks } from "@/lib/docs-navigation";
import { buildSiteSearchItems } from "@/lib/site-search";

interface Props {
  title?: string;
  description?: string;
  pageTitle?: string;
  navItems: CollectionEntry<"docs">[];
}

const { title, description, pageTitle, navItems } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const displayTitle = pageTitle ?? title?.replace(/\s+: Kobbe$/, "");
// Legal and support docs are included: they render on their own routes but
// still show as sidebar groups.
const resolvedNavLinks = buildDocsNavLinks(navItems, currentPath);
const groupedNavLinks = groupDocsNavLinks(resolvedNavLinks);
const currentNavLink = resolvedNavLinks.find((item) => item.isActive);
const jsonLdBreadcrumbs: JsonLdBreadcrumb[] =
  currentPath === "/docs"
    ? [{ name: "Docs", item: "/docs" }]
    : [
        { name: "Docs", item: "/docs" },
        {
          name: currentNavLink?.label ?? displayTitle ?? "Docs",
          item: currentNavLink?.href ?? currentPath,
        },
      ];

/** Stable sidebar order so Dashboard stats sits under Get started (not after long guide groups). */
const NAV_GROUP_ORDER = [
  "Get started",
  "Dashboard stats",
  "Installation guides",
  "Tracking",
  "Analyze",
  "Data",
  "Sharing",
  "Revenue attribution",
  "Manage",
  "Reports and alerts",
  "Support",
  "Legal",
  "Docs",
] as const;

groupedNavLinks.sort((a, b) => {
  const ai = NAV_GROUP_ORDER.indexOf(
    a.category as (typeof NAV_GROUP_ORDER)[number],
  );
  const bi = NAV_GROUP_ORDER.indexOf(
    b.category as (typeof NAV_GROUP_ORDER)[number],
  );
  const ar = ai === -1 ? NAV_GROUP_ORDER.length : ai;
  const br = bi === -1 ? NAV_GROUP_ORDER.length : bi;
  return ar - br || a.category.localeCompare(b.category);
});
const allDocs = await getCollection("docs");
const siteSearchItems = buildSiteSearchItems(allDocs);
---

<SidebarLayout
  title={title}
  description={description}
  jsonLdBreadcrumbs={jsonLdBreadcrumbs}
  docsNavGroups={groupedNavLinks}
>
  <section
    class="inverted bg-card relative min-h-svh overflow-hidden rounded-lg lg:h-[calc(100svh-1rem)] lg:min-h-0"
  >
    <div
      class="p-4 lg:h-full lg:overflow-y-auto lg:p-6 lg:pr-4"
      data-progressive-blur-scroll
    >
    {/* Right padding reserves room for the floating full-height ToC. */}
    <div class="w-full xl:pr-80">
      <div class="relative mx-auto w-full max-w-4xl min-w-0">
        {/* Pinned to the article corner so the prev/next buttons sit at the
            exact same spot on every page, letting you click through without
            moving the cursor (in-flow they shift with the header height). */}
        <div class="absolute top-0 right-0 z-10">
          <slot name="header-actions" />
        </div>
        <Wrapper
          variant="prose"
          id="markdown-content"
          class="w-full max-w-none min-w-0"
        >
        {
          displayTitle && (
            <header class="not-prose flex w-full items-start justify-between gap-4 pr-20">
              <div class="min-w-0">
                <Text
                  tag="h1"
                  variant="displaySM"
                  class="text-foreground font-display font-medium tracking-tight text-balance"
                >
                  {displayTitle}
                </Text>
                {description && (
                  <Text
                    tag="h1"
                    variant="displaySubtitle"
                    class="text-muted-foreground mt-2"
                  >
                    {description}
                  </Text>
                )}
              </div>
            </header>
          )
        }
          <slot />
        </Wrapper>
      </div>
    </div>
    </div>
    <TableOfContents />
    <ProgressiveBlur contained />
  </section>
  <DocsCommandSearch client:load hideTrigger items={siteSearchItems} />
  <ToCScript />
</SidebarLayout>
