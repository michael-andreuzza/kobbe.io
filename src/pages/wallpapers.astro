---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WallpapersHero from "@/components/wallpapers/WallpapersHero.astro";
import WallpapersGallery from "@/components/wallpapers/WallpapersGallery.astro";
import WallpapersDetails from "@/components/wallpapers/WallpapersDetails.astro";

const title = "Kobbe wallpapers: four Åland scenes for your desktop";
const description =
  "Free 5K wallpapers from the Kobbe illustrations: the quay, the coast, the harbour, and the village. Dynamic HEICs that follow macOS light and dark mode, plus PNGs.";
---

<BaseLayout
  title={title}
  description={description}
  jsonLdBreadcrumbs={[{ name: "Wallpapers", item: "/wallpapers" }]}
>
  <WallpapersHero />
  <WallpapersGallery />
  <WallpapersDetails />
</BaseLayout>
