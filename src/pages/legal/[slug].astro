---
import { getCollection, render } from "astro:content";

import StandalonePageLayout from "@/layouts/StandalonePageLayout.astro";
import DpaControls from "@/components/docs/dpa-controls.astro";
import DpaSummary from "@/components/docs/dpa-summary.astro";

export async function getStaticPaths() {
  const entries = await getCollection("legal");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isDpa = entry.id === "dpa";
const effectiveDateDefault = new Date().toISOString().slice(0, 10);

const others = (await getCollection("legal"))
  .filter((other) => other.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .map((other) => ({ href: `/legal/${other.id}`, title: other.data.title }));
---

<StandalonePageLayout
  section="Legal"
  navLabel={entry.data.navLabel}
  title={entry.data.title}
  description={entry.data.description}
  path={`/legal/${entry.id}`}
  othersTitle="Other legal pages"
  othersSummary="terms, privacy, and data processing."
  others={others}
>
  {
    isDpa ? (
      <>
        <DpaControls effectiveDateDefault={effectiveDateDefault} />
        <div id="dpa-printable">
          <DpaSummary effectiveDateDefault={effectiveDateDefault} />
          <Content />
        </div>
      </>
    ) : (
      <Content />
    )
  }
</StandalonePageLayout>
