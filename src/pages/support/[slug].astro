---
import { getCollection, render } from "astro:content";

import StandalonePageLayout from "@/layouts/StandalonePageLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("support");
  return entries
    .filter((entry) => entry.id !== "faq")
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const others = (await getCollection("support"))
  .filter((other) => other.id !== entry.id)
  .sort((a, b) => a.data.order - b.data.order)
  .map((other) => ({ href: `/support/${other.id}`, title: other.data.title }));
---

<StandalonePageLayout
  section="Support"
  navLabel={entry.data.navLabel}
  title={entry.data.title}
  description={entry.data.description}
  path={`/support/${entry.id}`}
  othersTitle="More help"
  othersSummary="for setup, billing, and charges."
  others={others}
>
  <Content />
</StandalonePageLayout>
