---
/**
 * FAQ on the 12 column grid: one section per topic with a sticky two-tone
 * sentence on the left and the questions as collapsible hairline rows on the
 * right. Ends with the other support pages.
 */
import { getCollection } from "astro:content";
import {
  ArrowDownRight01Icon,
  PlusSignIcon,
} from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import BaseLayout from "@/layouts/BaseLayout.astro";
import GridHero from "@/components/sections/GridHero.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import {
  pricingFaqItems,
  type PricingFaqItem,
} from "@/components/sections/pricing/pricing-faq-items";

type FaqId = (typeof pricingFaqItems)[number]["id"];

const groups: { lead: string; blurb: string; ids: FaqId[] }[] = [
  {
    lead: "Pricing and limits,",
    blurb: "you pay for monthly events, not features.",
    ids: ["event-pricing", "events", "over-limit", "over-25m"],
  },
  {
    lead: "Plans and billing,",
    blurb: "a cardless trial, then monthly or yearly.",
    ids: ["trial", "yearly", "features", "charges"],
  },
  {
    lead: "Privacy and data,",
    blurb: "cookieless by default, kept for three years.",
    ids: ["cookie-banner", "gdpr", "retention"],
  },
];

const byId = new Map<string, PricingFaqItem>(
  pricingFaqItems.map((item) => [item.id, item]),
);
const faqGroups = groups.map((group) => ({
  ...group,
  items: group.ids.flatMap((id) => byId.get(id) ?? []),
}));

const moreHelp = (await getCollection("support"))
  .filter((entry) => entry.id !== "faq")
  .sort((a, b) => a.data.order - b.data.order);

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: pricingFaqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title="Kobbe FAQ: pricing, trials, billing and privacy"
  description="Answers about Kobbe pricing, trials, billing, privacy, GDPR, and features."
  jsonLdBreadcrumbs={[{ name: "FAQ", item: "/support/faq" }]}
  jsonLdExtra={[jsonLdFaq]}
>
  <GridHero
    lead="FAQ,"
    title="pricing, trials, billing, and privacy."
    heading="Questions, answered"
    subtitle="Anything else, email support@kobbe.io and we reply as soon as we can."
  />

  {
    faqGroups.map((group) => (
      <section>
        <SectionGrid lead={group.lead} title={group.blurb} sticky class="pb-24">
          <ul class="border-border border-t" role="list">
            {group.items.map((item) => (
              <li class="border-border border-b">
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                    <h3 class="text-foreground text-base font-medium text-pretty">
                      {item.question}
                    </h3>
                    <HugeiconsIcon
                      icon={PlusSignIcon}
                      strokeWidth={1.5}
                      className="text-muted-foreground size-4 shrink-0 transition-transform duration-300 group-open:rotate-45 motion-reduce:transition-none"
                      aria-hidden="true"
                    />
                  </summary>
                  <p class="text-muted-foreground max-w-xl pb-6 text-base leading-relaxed text-pretty">
                    {item.answer}
                  </p>
                </details>
              </li>
            ))}
          </ul>
        </SectionGrid>
      </section>
    ))
  }

  <section>
    <SectionGrid
      lead="Still have a question?"
      title="Email support, or check a charge on your statement."
      class="pb-24"
    >
      <ul class="border-border border-t" role="list">
        {
          moreHelp.map((entry) => (
            <li>
              <a
                href={`/support/${entry.id}`}
                class="group border-border grid grid-cols-[1fr_auto] items-center gap-6 border-b py-5"
              >
                <span class="text-foreground text-base font-medium text-pretty transition-transform duration-300 group-hover:translate-x-2 sm:text-lg">
                  {entry.data.title}
                </span>
                <HugeiconsIcon
                  icon={ArrowDownRight01Icon}
                  size={18}
                  strokeWidth={1.8}
                  className="text-muted-foreground group-hover:text-foreground transition-colors"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </SectionGrid>
  </section>
</BaseLayout>
