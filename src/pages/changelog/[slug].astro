---
/**
 * Permalink page for a single changelog entry: breadcrumb, sans title,
 * prose body, then a short "More entries" list in the same hairline rows
 * as /changelog.
 */
import { getCollection, render } from "astro:content";
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import Button from "@/components/landing/Button.astro";
import Footer from "@/components/landing/Footer.astro";
import { changelogDateFormatter, changelogSlug } from "@/lib/changelog";

export async function getStaticPaths() {
  const entries = await getCollection("changelog");
  return entries.map((entry) => ({
    params: { slug: changelogSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const otherEntries = (await getCollection("changelog"))
  .filter((other) => other.id !== entry.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<BaseLayout
  title={`${entry.data.title}: Kobbe changelog`}
  description={entry.data.description}
  jsonLdBreadcrumbs={[
    { name: "Changelog", item: "/changelog" },
    { name: entry.data.title, item: `/changelog/${changelogSlug(entry.id)}` },
  ]}
>
  <section class="pt-24 pb-32 lg:pt-42">
    <Wrapper variant="default">
      <div class="mx-auto max-w-2xl">
        <article>
          <p class="text-muted-foreground text-xs font-medium uppercase">
            <a
              href="/changelog"
              class="hover:text-foreground transition-colors"
            >
              Changelog
            </a>
            <span aria-hidden="true"> / </span>
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>
              {changelogDateFormatter.format(entry.data.date)}
            </time>
          </p>
          <h1
            class="text-foreground mt-4 text-2xl leading-tight font-medium tracking-tight text-balance sm:text-3xl"
          >
            {entry.data.title}
          </h1>
          <div class="mt-10">
            <Wrapper variant="prose">
              <Content />
            </Wrapper>
          </div>
        </article>

        <aside class="mt-32">
          <div class="flex items-end justify-between gap-6">
            <p class="text-muted-foreground text-xs font-medium uppercase">
              More entries
            </p>
            <Button label="All entries" href="/changelog" variant="outline" />
          </div>
          <div class="border-border mt-8 border-t">
            {
              otherEntries.map((other) => (
                <a
                  href={`/changelog/${changelogSlug(other.id)}`}
                  class="group border-border grid grid-cols-[1fr_auto] items-center gap-6 border-b py-5"
                >
                  <span class="min-w-0">
                    <time
                      datetime={other.data.date.toISOString().slice(0, 10)}
                      class="text-muted-foreground block text-sm"
                    >
                      {changelogDateFormatter.format(other.data.date)}
                    </time>
                    <span class="text-foreground mt-1 block text-base text-pretty transition-transform duration-300 group-hover:translate-x-3">
                      {other.data.title}
                    </span>
                  </span>
                  <HugeiconsIcon
                    icon={ArrowDownRight01Icon}
                    size={20}
                    strokeWidth={1.8}
                    className="text-foreground"
                    aria-hidden="true"
                  />
                </a>
              ))
            }
          </div>
        </aside>
      </div>
    </Wrapper>
  </section>

  <Footer />
</BaseLayout>
