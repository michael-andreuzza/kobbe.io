---
import { getCollection } from "astro:content";
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import BaseLayout from "@/layouts/BaseLayout.astro";
import GridHero from "@/components/sections/GridHero.astro";

const entries = (await getCollection("compare")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title="Kobbe compared with other web analytics tools"
  description="How Kobbe compares with other privacy-first web analytics on privacy, bot filtering, revenue attribution, and AI agent access."
  jsonLdBreadcrumbs={[{ name: "Compare", item: "/compare" }]}
>
  <GridHero
    lead="Compare,"
    title="including where another tool is the better pick."
    heading="How Kobbe compares"
    subtitle="Side by side with other web analytics tools, including where they are the better pick."
  >
    <ul
      slot="full"
      class="border-border border-t lg:col-span-full lg:grid lg:grid-cols-subgrid"
      role="list"
    >
      {
        entries.map((entry) => (
          <li class="lg:col-span-full lg:grid lg:grid-cols-subgrid">
            <a
              href={`/compare/${entry.id}`}
              class="group border-border grid grid-cols-[1fr_auto] items-baseline gap-x-8 gap-y-1 border-b py-5 lg:col-span-full lg:grid-cols-subgrid"
            >
              <span class="text-foreground text-base font-medium text-pretty transition-transform duration-300 group-hover:translate-x-2 sm:text-lg lg:col-span-11">
                {entry.data.title}
              </span>
              <HugeiconsIcon
                icon={ArrowDownRight01Icon}
                size={18}
                strokeWidth={1.8}
                className="text-muted-foreground group-hover:text-foreground self-center justify-self-end transition-colors lg:col-span-1"
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </GridHero>
</BaseLayout>
