---
/**
 * Changelog index in the landing language: two-tone statement, then
 * hairline rows with date, title, and a trailing arrow. Entry bodies live
 * on their /changelog/[slug] permalink pages.
 */
import { getCollection } from "astro:content";
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import Footer from "@/components/landing/Footer.astro";
import { changelogDateFormatter, changelogSlug } from "@/lib/changelog";

const title = "Kobbe changelog: what shipped and when";
const description =
  "Every improvement to Kobbe, newest first. New features, fixes, and performance work as it ships.";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title={title}
  description={description}
  jsonLdBreadcrumbs={[{ name: "Changelog", item: "/changelog" }]}
>
  <section class="pt-24 lg:pt-42">
    <Wrapper variant="default">
      <h1
        class="max-w-5xl text-[clamp(1.5rem,2.5vw,2.25rem)] leading-tight tracking-tight text-balance"
      >
        <span class="text-foreground">What shipped, and when.</span>{" "}<span
          class="text-muted-foreground"
          >Every improvement to Kobbe, newest first. Features, fixes, and
          performance work as it ships.</span
        >
      </h1>
    </Wrapper>
  </section>

  <section class="mt-32 pb-32">
    <Wrapper variant="default">
      <p class="text-muted-foreground text-xs font-medium uppercase">
        All entries
      </p>
      <div class="border-border mt-8 border-t">
        {
          entries.map((entry) => (
            <a
              href={`/changelog/${changelogSlug(entry.id)}`}
              class="group border-border grid grid-cols-[1fr_auto] items-center gap-6 border-b py-5"
            >
              <span class="min-w-0 sm:flex sm:items-baseline sm:gap-10">
                <time
                  datetime={entry.data.date.toISOString().slice(0, 10)}
                  class="text-muted-foreground block text-sm sm:w-28 sm:shrink-0"
                >
                  {changelogDateFormatter.format(entry.data.date)}
                </time>
                <span class="text-foreground mt-1 block text-base text-pretty transition-transform duration-300 group-hover:translate-x-3 sm:mt-0 sm:text-lg">
                  {entry.data.title}
                </span>
              </span>
              <HugeiconsIcon
                icon={ArrowDownRight01Icon}
                size={20}
                strokeWidth={1.8}
                className="text-foreground"
                aria-hidden="true"
              />
            </a>
          ))
        }
      </div>
    </Wrapper>
  </section>

  <Footer />
</BaseLayout>
