---
/**
 * Changelog index: the grid hero with the entries below it as full width
 * rows on the 12 column subgrid, the date in the left 4 columns and the title and a
 * trailing arrow on the right. Entry bodies live on their /changelog/[slug]
 * permalink pages.
 */
import { getCollection } from "astro:content";
import { ArrowDownRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import BaseLayout from "@/layouts/BaseLayout.astro";
import GridHero from "@/components/sections/GridHero.astro";
import { changelogDateFormatter, changelogSlug } from "@/lib/changelog";

const title = "Kobbe changelog: what shipped and when";
const description =
  "Every improvement to Kobbe, newest first. New features, fixes, and performance work as it ships.";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title={title}
  description={description}
  jsonLdBreadcrumbs={[{ name: "Changelog", item: "/changelog" }]}
>
  <GridHero
    lead="Changelog,"
    title="every release, in one place."
    heading="What shipped, and when"
    subtitle="Every improvement to Kobbe, newest first. Features, fixes, and performance work as it ships."
  >
    <ul
      slot="full"
      class="border-border border-t lg:col-span-full lg:grid lg:grid-cols-subgrid"
      role="list"
    >
      {
        entries.map((entry) => (
          <li class="lg:col-span-full lg:grid lg:grid-cols-subgrid">
            <a
              href={`/changelog/${changelogSlug(entry.id)}`}
              class="group border-border grid grid-cols-[1fr_auto] items-baseline gap-x-8 gap-y-1 border-b py-5 lg:col-span-full lg:grid-cols-subgrid"
            >
              <time
                datetime={entry.data.date.toISOString().slice(0, 10)}
                class="text-muted-foreground col-span-full text-sm tabular-nums lg:col-span-4"
              >
                {changelogDateFormatter.format(entry.data.date)}
              </time>
              <span class="text-foreground text-base font-medium text-pretty transition-transform duration-300 group-hover:translate-x-2 sm:text-lg lg:col-span-7">
                {entry.data.title}
              </span>
              <HugeiconsIcon
                icon={ArrowDownRight01Icon}
                size={18}
                strokeWidth={1.8}
                className="text-muted-foreground group-hover:text-foreground self-center justify-self-end transition-colors lg:col-span-1"
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </GridHero>

</BaseLayout>
