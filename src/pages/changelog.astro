---
/**
 * Changelog index in the landing's list-row language: thick foreground
 * dividers, serif titles, full-row links with a trailing arrow. Entry
 * bodies live on their /changelog/[slug] permalink pages.
 */
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/foundations/containers/Wrapper.astro";
import Footer from "@/components/landing/Footer.astro";
import { changelogDateFormatter, changelogSlug } from "@/lib/changelog";

const title = "Kobbe changelog: what shipped and when";
const description =
  "Every improvement to Kobbe, newest first. New features, fixes, and performance work as it ships.";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title={title}
  description={description}
  jsonLdBreadcrumbs={[{ name: "Changelog", item: "/changelog" }]}
>
  <section class="pt-24 lg:pt-40">
    <Wrapper variant="default">
      <h1
        class="landing-serif text-foreground max-w-3xl text-[clamp(2.2rem,4vw,3.6rem)] leading-[1.08] text-balance"
      >
        What shipped, <em>and when.</em>
      </h1>
      <p class="text-muted-foreground mt-8 max-w-md text-base text-pretty">
        Every improvement to Kobbe, newest first. Features, fixes, and
        performance work as it ships.
      </p>
    </Wrapper>
  </section>

  <section class="pt-16 pb-24 lg:pt-24">
    <Wrapper variant="default">
      <div class="border-foreground border-t-2">
        {
          entries.map((entry) => (
            <a
              href={`/changelog/${changelogSlug(entry.id)}`}
              class="group border-foreground flex items-center justify-between gap-6 border-b-2 py-6"
            >
              <div class="min-w-0 sm:flex sm:items-baseline sm:gap-10">
                <time
                  datetime={entry.data.date.toISOString().slice(0, 10)}
                  class="text-muted-foreground block text-sm sm:w-28 sm:shrink-0"
                >
                  {changelogDateFormatter.format(entry.data.date)}
                </time>
                <p class="landing-serif text-foreground mt-1 text-2xl text-pretty transition-transform duration-300 group-hover:translate-x-3 sm:mt-0 sm:text-3xl">
                  {entry.data.title}
                </p>
              </div>
              <span
                class="text-foreground text-2xl sm:text-3xl"
                aria-hidden="true"
              >
                ↘
              </span>
            </a>
          ))
        }
      </div>
    </Wrapper>
  </section>

  <Footer />
</BaseLayout>
