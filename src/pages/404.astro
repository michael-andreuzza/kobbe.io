---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Not found: Kobbe" noindex nofollow>
  <section
    class="flex min-h-[60svh] flex-col items-center justify-center p-6 text-center"
    data-kobbe-not-found
  >
    <p class="text-foreground text-6xl font-semibold">404</p>
    <p class="text-muted-foreground mt-4">
      The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="text-foreground hover:text-muted-foreground mt-8 text-sm font-medium underline underline-offset-4"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
