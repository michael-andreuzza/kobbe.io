---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SchematicOverviewChart } from "@/components/landing/schematic-overview-chart";
import {
  pricingTiers,
  pricingTrialDays,
} from "@/components/sections/pricing/pricing-tiers";
import { APP_SIGNUP_URL } from "@/lib/site-mega-menu";

// Private design study: the whole Overview dashboard re-drawn in a
// schematic/technical language. Not linked from anywhere, noindexed.

const referrers = [
  { label: "google.com", value: 9204 },
  { label: "direct / none", value: 7112 },
  { label: "x.com", value: 3481 },
  { label: "github.com", value: 2240 },
  { label: "producthunt.com", value: 1102 },
];

const pages = [
  { label: "/", value: 11930 },
  { label: "/pricing", value: 6204 },
  { label: "/docs/install", value: 3377 },
  { label: "/blog/launch", value: 2981 },
  { label: "/changelog", value: 1204 },
];

const countries = [
  { label: "United States", value: 8412 },
  { label: "Germany", value: 3204 },
  { label: "United Kingdom", value: 2981 },
  { label: "Sweden", value: 2240 },
  { label: "France", value: 1873 },
];

const devices = [
  { label: "Desktop", share: 61 },
  { label: "Mobile", share: 33 },
  { label: "Tablet", share: 6 },
];

const DEVICE_DOTS = 24;

const includedFeatures = [
  "Up to 30 websites",
  "Cookieless, privacy-first",
  "3 years data retention",
  "Realtime visitors globe",
  "Funnels & conversions",
  "Custom events",
  "Revenue attribution",
  "UTM & channel reports",
  "Web Vitals insights",
  "Team access, API & CLI",
];

const maxOf = (rows: { value: number }[]) =>
  Math.max(...rows.map((r) => r.value));
const refMax = maxOf(referrers);
const pageMax = maxOf(pages);
const countryMax = maxOf(countries);
const fmt = (n: number) => n.toLocaleString("en-US");
---

<BaseLayout
  title="Kobbe: Overview, schematic study"
  description="A design study of the Kobbe overview dashboard."
  noindex
  nofollow
>
  <section
    class="sch w-full text-(--sch-ink)"
    style="--sch-paper: #f6f5f2; --sch-ink: #171717; --sch-hairline: rgb(23 23 23 / 0.16);"
  >
    <div class="mx-auto w-full max-w-5xl px-4 pt-20 pb-16 sm:px-6">
      <!-- Sheet header -->
      <div class="flex items-baseline justify-between gap-4 text-[10px] tracking-[0.14em] uppercase opacity-70">
        <span>Kobbe — Overview</span>
        <span>Sheet 01 / Last 90 days</span>
      </div>

      <!-- FIG. 01 — traffic chart plate -->
      <p class="sch-fig mt-8">Fig. 01 / Visitors over time</p>
      <div class="sch-plate relative mt-2 border border-(--sch-hairline)">
        <div class="px-4 pt-8 pb-6 sm:px-8">
          <SchematicOverviewChart client:load />
        </div>

        <!-- KPI strip: plain mono text separated by hairlines -->
        <div class="grid grid-cols-2 border-t border-(--sch-hairline) sm:grid-cols-4">
          <div class="border-r border-(--sch-hairline) px-4 py-3 sm:px-6">
            <div class="text-[9px] tracking-[0.14em] uppercase opacity-55">Visitors</div>
            <div class="mt-1 text-sm tabular-nums">28,412</div>
          </div>
          <div class="px-4 py-3 sm:border-r sm:border-(--sch-hairline) sm:px-6">
            <div class="text-[9px] tracking-[0.14em] uppercase opacity-55">Revenue</div>
            <div class="mt-1 text-sm tabular-nums">$46,930</div>
          </div>
          <div class="border-t border-r border-(--sch-hairline) px-4 py-3 sm:border-t-0 sm:px-6">
            <div class="text-[9px] tracking-[0.14em] uppercase opacity-55">Bounce</div>
            <div class="mt-1 text-sm tabular-nums">41%</div>
          </div>
          <div class="border-t border-(--sch-hairline) px-4 py-3 sm:border-t-0 sm:px-6">
            <div class="text-[9px] tracking-[0.14em] uppercase opacity-55">Avg visit</div>
            <div class="mt-1 text-sm tabular-nums">1m 42s</div>
          </div>
        </div>
      </div>

      <!-- Live strip -->
      <div class="sch-plate relative mt-6 border border-(--sch-hairline)">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-1 px-4 py-3 text-[10px] tracking-[0.14em] uppercase sm:px-6">
          <span class="inline-flex items-center gap-2">
            <span class="sch-pulse inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
            Live — 12 online
          </span>
          <span class="opacity-55">Last event 6s ago</span>
          <span class="opacity-55">/pricing — Stockholm, SE</span>
        </div>
      </div>

      <!-- Breakdown plates -->
      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2">
        <div>
          <p class="sch-fig">Fig. 02 / Top referrers</p>
          <div class="sch-plate relative mt-2 border border-(--sch-hairline)">
            {referrers.map((row, index) => (
              <div class:list={["flex items-center gap-3 px-4 py-2.5 sm:px-5", index > 0 && "border-t border-(--sch-hairline)"]}>
                <span class="w-5 shrink-0 text-[9px] tabular-nums opacity-45">{String(index + 1).padStart(2, "0")}</span>
                <span class="w-28 shrink-0 truncate text-[11px] sm:w-32">{row.label}</span>
                <span
                  class:list={["sch-tape h-2 min-w-0 flex-1", index === 0 && "sch-tape-accent"]}
                  style={`--tape: ${Math.round((row.value / refMax) * 100)}%;`}
                  aria-hidden="true"></span>
                <span class="w-14 shrink-0 text-right text-[11px] tabular-nums">{fmt(row.value)}</span>
              </div>
            ))}
          </div>
        </div>

        <div>
          <p class="sch-fig">Fig. 03 / Top pages</p>
          <div class="sch-plate relative mt-2 border border-(--sch-hairline)">
            {pages.map((row, index) => (
              <div class:list={["flex items-center gap-3 px-4 py-2.5 sm:px-5", index > 0 && "border-t border-(--sch-hairline)"]}>
                <span class="w-5 shrink-0 text-[9px] tabular-nums opacity-45">{String(index + 1).padStart(2, "0")}</span>
                <span class="w-28 shrink-0 truncate text-[11px] sm:w-32">{row.label}</span>
                <span
                  class:list={["sch-tape h-2 min-w-0 flex-1", index === 0 && "sch-tape-accent"]}
                  style={`--tape: ${Math.round((row.value / pageMax) * 100)}%;`}
                  aria-hidden="true"></span>
                <span class="w-14 shrink-0 text-right text-[11px] tabular-nums">{fmt(row.value)}</span>
              </div>
            ))}
          </div>
        </div>

        <div>
          <p class="sch-fig">Fig. 04 / Devices</p>
          <div class="sch-plate relative mt-2 border border-(--sch-hairline)">
            {devices.map((row, index) => {
              const filled = Math.max(1, Math.round((row.share / 100) * DEVICE_DOTS));
              return (
                <div class:list={["flex items-center gap-3 px-4 py-3 sm:px-5", index > 0 && "border-t border-(--sch-hairline)"]}>
                  <span class="w-28 shrink-0 text-[11px] sm:w-32">{row.label}</span>
                  <span class="flex min-w-0 flex-1 flex-wrap items-center gap-[5px]" aria-hidden="true">
                    {Array.from({ length: DEVICE_DOTS }).map((_, dot) => (
                      <span
                        class:list={[
                          "h-[3px] w-[3px] rounded-full",
                          dot < filled
                            ? index === 0
                              ? "bg-brand"
                              : "bg-(--sch-ink)"
                            : "bg-(--sch-ink) opacity-20",
                        ]}></span>
                    ))}
                  </span>
                  <span class="w-14 shrink-0 text-right text-[11px] tabular-nums">{row.share}%</span>
                </div>
              );
            })}
          </div>
        </div>

        <div>
          <p class="sch-fig">Fig. 05 / Countries</p>
          <div class="sch-plate relative mt-2 border border-(--sch-hairline)">
            {countries.map((row, index) => (
              <div class:list={["flex items-center gap-3 px-4 py-2.5 sm:px-5", index > 0 && "border-t border-(--sch-hairline)"]}>
                <span class="w-5 shrink-0 text-[9px] tabular-nums opacity-45">{String(index + 1).padStart(2, "0")}</span>
                <span class="w-28 shrink-0 truncate text-[11px] sm:w-32">{row.label}</span>
                <span
                  class:list={["sch-tape h-2 min-w-0 flex-1", index === 0 && "sch-tape-accent"]}
                  style={`--tape: ${Math.round((row.value / countryMax) * 100)}%;`}
                  aria-hidden="true"></span>
                <span class="w-14 shrink-0 text-right text-[11px] tabular-nums">{fmt(row.value)}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Pricing plates -->
      <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2">
        <div>
          <p class="sch-fig">Fig. 06 / Rates</p>
          <div class="sch-plate relative mt-2 border border-(--sch-hairline)">
            <div class="flex items-baseline gap-3 px-4 py-2 text-[9px] tracking-[0.14em] uppercase opacity-55 sm:px-5">
              <span class="w-5 shrink-0"></span>
              <span class="min-w-0 flex-1">Events / mo</span>
              <span class="w-12 shrink-0 text-right">Monthly</span>
              <span class="w-14 shrink-0 text-right">Yearly</span>
            </div>
            {pricingTiers.map((tier, index) => (
              <div class="flex items-baseline gap-3 border-t border-(--sch-hairline) px-4 py-2.5 sm:px-5">
                <span class="w-5 shrink-0 text-[9px] tabular-nums opacity-45">{String(index + 1).padStart(2, "0")}</span>
                <span class="w-20 shrink-0 text-[11px]">{tier.events} events</span>
                <span class="sch-leader min-w-0 flex-1 self-center" aria-hidden="true"></span>
                <span class:list={["w-12 shrink-0 text-right text-[11px] tabular-nums", index === 0 && "text-brand"]}>${tier.monthly}</span>
                <span class="w-14 shrink-0 text-right text-[11px] tabular-nums opacity-50">${tier.yearlyMonthly}/mo</span>
              </div>
            ))}
            <div class="border-t border-(--sch-hairline) px-4 py-2.5 text-[9px] tracking-[0.14em] uppercase opacity-55 sm:px-5">
              Same features on every tier — yearly billing: 2 months free
            </div>
          </div>
        </div>

        <div>
          <p class="sch-fig">Fig. 07 / Included — all tiers</p>
          <div class="sch-plate relative mt-2 border border-(--sch-hairline)">
            <div class="grid grid-cols-1 sm:grid-cols-2">
              {includedFeatures.map((feature, index) => (
                <div
                  class:list={[
                    "flex items-center gap-3 px-4 py-2.5 sm:px-5",
                    index > 0 && "border-t border-(--sch-hairline)",
                    index === 1 && "sm:border-t-0",
                    index % 2 === 0 && "sm:border-r sm:border-(--sch-hairline)",
                  ]}
                >
                  <span class="h-[3px] w-[3px] shrink-0 rounded-full bg-(--sch-ink)" aria-hidden="true"></span>
                  <span class="truncate text-[11px]">{feature}</span>
                </div>
              ))}
            </div>
            <div class="border-t border-(--sch-hairline) px-4 py-2.5 text-[9px] tracking-[0.14em] uppercase opacity-55 sm:px-5">
              No feature gates — volume is the only variable
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA: full-bleed register rule -->
    <div class="pb-24">
      <div class="mx-auto w-full max-w-5xl px-4 sm:px-6">
        <p class="sch-fig">Fig. 08 / Start</p>
        <p class="mt-3 text-sm leading-relaxed">
          Free for {pricingTrialDays} days. No credit card required.
        </p>
      </div>
      <div class="relative mt-8">
        <div class="h-px w-full bg-brand"></div>
        <div class="pointer-events-none absolute inset-0 flex items-center">
          <div class="mx-auto flex w-full max-w-5xl justify-end px-4 sm:px-6">
            <a
              href={APP_SIGNUP_URL}
              class="pointer-events-auto border border-brand bg-(--sch-paper) px-4 py-2 text-[10px] tracking-[0.14em] text-brand uppercase transition-colors hover:bg-brand hover:text-(--sch-paper)"
              data-kobbe-event="Index-two CTA - start free trial"
            >
              Start free trial
            </a>
          </div>
        </div>
      </div>

      <!-- Sheet footnote -->
      <div class="mx-auto w-full max-w-5xl px-4 sm:px-6">
        <p class="mt-12 text-[10px] tracking-[0.14em] uppercase opacity-45">
          Schematic study — generated data, not live
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .sch {
    font-family:
      ui-monospace, "SF Mono", "Cascadia Mono", "Roboto Mono", Menlo,
      monospace;
  }

  /* Corner ticks: top-left and bottom-right L marks on every plate. */
  .sch-plate::before,
  .sch-plate::after {
    content: "";
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
  }
  .sch-plate::before {
    top: -1px;
    left: -1px;
    border-top: 1px solid var(--sch-ink);
    border-left: 1px solid var(--sch-ink);
  }
  .sch-plate::after {
    right: -1px;
    bottom: -1px;
    border-right: 1px solid var(--sch-ink);
    border-bottom: 1px solid var(--sch-ink);
  }

  .sch-fig {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* Barcode tape: proportional share bar drawn as 2px dashes. */
  .sch-tape {
    display: inline-block;
    background-image: repeating-linear-gradient(
      90deg,
      var(--sch-ink) 0 2px,
      transparent 2px 4px
    );
    background-size: var(--tape, 0%) 100%;
    background-repeat: no-repeat;
    opacity: 0.85;
  }
  .sch-tape-accent {
    background-image: repeating-linear-gradient(
      90deg,
      var(--brand) 0 2px,
      transparent 2px 4px
    );
    opacity: 1;
  }

  /* Dotted leader between a label and its price, like a rate-card index. */
  .sch-leader {
    height: 1px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--sch-ink) 0 1px,
      transparent 1px 4px
    );
    opacity: 0.35;
  }

  .sch-pulse {
    background: var(--brand);
    animation: sch-pulse 2.4s ease-in-out infinite;
  }
  @keyframes sch-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand) 45%, transparent);
    }
    50% {
      box-shadow: 0 0 0 5px transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sch-pulse {
      animation: none;
    }
  }
</style>
