---
/**
 * Feature page for funnels and goals: a grid hero with a real funnel
 * attached, three widget tiles for building funnels and tracking goals, and
 * common flows as plain rows. Every claim maps to
 * /docs/funnels and /docs/conversions.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import GridHero from "@/components/sections/GridHero.astro";
import ScreenshotPanel from "@/components/sections/ScreenshotPanel.astro";
import ConversionFilterWidget from "@/components/widgets/ConversionFilterWidget.astro";
import ConversionPresetsWidget from "@/components/widgets/ConversionPresetsWidget.astro";
import FunnelBuilderWidget from "@/components/widgets/FunnelBuilderWidget.astro";
import { Button } from "@/components/ui/button";
import funnels from "@/images/features/funnels.png";

const features = [
  {
    lead: "Pages or events, in order",
    body: "Each step is a page path or a custom event, so a funnel can follow any flow on your site.",
    widget: FunnelBuilderWidget,
  },
  {
    lead: "Goals without code",
    body: "Turn on presets for contact links, messaging apps, outbound links, and form submits.",
    widget: ConversionPresetsWidget,
  },
  {
    lead: "Focus on one goal",
    body: "Pick a conversion and every KPI, chart, and breakdown narrows to the visitors who hit it.",
    widget: ConversionFilterWidget,
  },
];

const flows = [
  "Marketing page to signup",
  "Pricing page to checkout",
  "Trial start to activation",
  "Product page to purchase",
  "Docs page to install",
  "Blog post to newsletter",
];
---

<BaseLayout
  title="Funnels and goals: see where visitors drop off"
  description="Build funnels from page paths and custom events, track goals like form submits and contact clicks without code, and see conversion and drop-off for every step."
  jsonLdBreadcrumbs={[
    { name: "Features", item: "/features" },
    { name: "Funnels", item: "/features/funnels" },
  ]}
>
  <GridHero
    lead="Funnels and goals,"
    title="from the pages and events you already collect."
    heading="See where visitors drop off"
    subtitle="Build funnels from pages and events, track goals without code, and see how many visitors make it through every step."
  >
    <div class="mt-8">
      <Button
        label="Create a funnel"
        href="/docs/funnels"
        variant="muted"
        arrow
      />
    </div>
    <ScreenshotPanel
      slot="full"
      src={funnels}
      alt="A four-step Kobbe funnel from the homepage to signup, with visitors, conversion, and drop-off for each step"
    />
  </GridHero>

  <section>
    <SectionGrid lead="How it works," title="funnels for the flow, goals for the actions inside it." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          Funnels and goals together
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
          Measure the flow, and the actions that matter inside it.
        </Text>
      </div>
      <ul
        slot="full"
        class="grid gap-x-8 gap-y-12 md:grid-cols-3 lg:col-span-full lg:grid-cols-subgrid"
        role="list"
      >
        {
          features.map((feature) => (
            <li class="lg:col-span-4">
              <div class="bg-muted-surface flex h-96 items-center justify-center rounded-lg p-6">
                <feature.widget />
              </div>
              <Text tag="h3" variant="textBase" class="mt-6 font-medium">
                {feature.lead}
              </Text>
              <Text tag="p" variant="textSM" class="text-muted-foreground mt-1 max-w-sm text-pretty">
                {feature.body}
              </Text>
            </li>
          ))
        }
      </ul>
    </SectionGrid>
  </section>

  <section>
    <SectionGrid lead="Common flows," title="wherever the order of steps matters." class="py-24">
      <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
        A funnel for any flow
      </Text>
      <ul class="mt-6 grid gap-x-8 sm:grid-cols-2" role="list">
        {
          flows.map((flow) => (
            <li class="border-border text-foreground border-t py-4 text-base font-medium">
              {flow}
            </li>
          ))
        }
      </ul>
    </SectionGrid>
  </section>
</BaseLayout>
