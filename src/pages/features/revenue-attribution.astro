---
/**
 * Feature page for revenue attribution on the 12 column grid: the hero with
 * the payment providers linking to their setup guides and the revenue page
 * screenshot below it, three widget tiles for what a screenshot can't show,
 * and the dashboard ranked by revenue.
 */
import type { ImageMetadata } from "astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandLogo from "@/components/foundations/BrandLogo.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import GridHero from "@/components/sections/GridHero.astro";
import ScreenshotPanel from "@/components/sections/ScreenshotPanel.astro";
import RevenueJourneyWidget from "@/components/widgets/RevenueJourneyWidget.astro";
import RevenueProvidersWidget from "@/components/widgets/RevenueProvidersWidget.astro";
import RevenueRefundsWidget from "@/components/widgets/RevenueRefundsWidget.astro";
import SalePingWidget from "@/components/widgets/SalePingWidget.astro";
import { Button } from "@/components/ui/button";
import revenuePage from "@/images/features/revenue-page.png";
import revenueMode from "@/images/features/revenue-mode.png";
const logos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/brands/*.svg",
  { eager: true },
);
const logo = (file: string) => logos[`/src/images/brands/${file}`]!.default;

const providers: { label: string; slug: string; file?: string }[] = [
  { label: "Stripe", slug: "stripe" },
  { label: "Polar", slug: "polar" },
  { label: "Paddle", slug: "paddle" },
  { label: "Shopify", slug: "shopify" },
  { label: "Creem", slug: "creem" },
  { label: "Mollie", slug: "mollie" },
  { label: "RevenueCat", slug: "revenuecat" },
  { label: "Revolut", slug: "revolut" },
  { label: "Superwall", slug: "superwall" },
  { label: "Whop", slug: "whop" },
  { label: "WooCommerce", slug: "woocommerce", file: "woo" },
  { label: "Gumroad", slug: "gumroad" },
  { label: "Chargebee", slug: "chargebee" },
  { label: "Razorpay", slug: "razorpay" },
];

const features = [
  {
    lead: "Connect your checkout",
    body: "Stripe, Polar, Paddle, Shopify, and ten more send each payment to Kobbe through a webhook.",
    widget: RevenueProvidersWidget,
  },
  {
    lead: "Follow every sale back",
    body: "Each payment is tied to the visit that led to it, so you see where it came from and the pages on the way.",
    widget: RevenueJourneyWidget,
  },
  {
    lead: "Refunds come off",
    body: "Refunds arrive through the same webhooks, so net revenue stays accurate.",
    widget: RevenueRefundsWidget,
  },
];
---

<BaseLayout
  title="Revenue attribution: see what every page earns"
  description="Connect Stripe, Polar, Paddle, Shopify, or ten more providers, and Kobbe traces each sale back to the page, source, and campaign that brought it in."
  jsonLdBreadcrumbs={[
    { name: "Features", item: "/features" },
    { name: "Revenue attribution", item: "/features/revenue-attribution" },
  ]}
>
  <GridHero
    lead="Revenue attribution,"
    title="from the first visit to the paid checkout."
    heading="See what every page earns"
    subtitle="Connect your payment provider, and Kobbe traces each sale back to the page, source, and campaign that brought it in."
  >
    <ul class="flex flex-wrap gap-5" aria-label="Works with">
      {
        providers.map((provider) => (
          <li class="group relative">
            <a
              href={`/docs/revenue-attribution-${provider.slug}`}
              aria-label={provider.label}
              class="block transition-opacity hover:opacity-70"
            >
              <BrandLogo
                src={logo(`${provider.file ?? provider.slug}.svg`).src}
                class="size-6 rounded-sm object-contain"
                width={24}
                height={24}
              />
            </a>
            <span
              aria-hidden="true"
              class="pointer-events-none absolute top-full left-1/2 z-10 mt-2 -translate-x-1/2 rounded-sm bg-foreground px-2 py-1 text-xs font-medium whitespace-nowrap text-background opacity-0 transition-opacity group-hover:opacity-100 group-has-focus-visible:opacity-100"
            >
              {provider.label}
            </span>
          </li>
        ))
      }
    </ul>
    <div class="mt-10">
      <Button
        label="Set up revenue"
        href="/docs/revenue-attribution"
        variant="muted"
        arrow
      />
    </div>
    <ScreenshotPanel slot="full" src={revenuePage} alt="The Kobbe revenue page: gross, refunds, net and attributed revenue, attribution coverage, and revenue per landing page" />
  </GridHero>

  <section>
    <SectionGrid lead="How it works," title="from the webhook to the visit that led to the sale." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          From checkout to page
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
          Payments arrive through webhooks and land on the visit that led to
          them.
        </Text>
      </div>
      <ul
        slot="full"
        class="grid gap-x-8 gap-y-12 md:grid-cols-3 lg:col-span-full lg:grid-cols-subgrid"
        role="list"
      >
        {
          features.map((feature) => (
            <li class="lg:col-span-4">
              <div class="bg-muted-surface flex h-96 items-center justify-center rounded-lg p-6">
                <feature.widget />
              </div>
              <Text tag="h3" variant="textBase" class="mt-6 font-medium">
                {feature.lead}
              </Text>
              <Text tag="p" variant="textSM" class="text-muted-foreground mt-1 max-w-sm text-pretty">
                {feature.body}
              </Text>
            </li>
          ))
        }
      </ul>
    </SectionGrid>
  </section>

  <section>
    <SectionGrid lead="Revenue mode," title="one click on the revenue tile." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          Rank the dashboard by revenue
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
          Click the revenue tile at the top, and every panel sorts by what it
          earned, with visitor counts and revenue per visitor on every row.
        </Text>
      </div>
      <ScreenshotPanel
        slot="full"
        src={revenueMode}
        alt="The Kobbe dashboard ranked by revenue: pages and referrers sorted by what they earned, each with its visitor count"
      />
    </SectionGrid>
  </section>

  <section>
    <SectionGrid lead="Sale pings," title="every sale in Slack or Discord." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          Hear about every sale
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
          Paste a Slack or Discord webhook, and each new sale posts to your
          channel with its source and the pages the buyer saw.
        </Text>
      </div>
      <div slot="full" class="bg-muted-surface flex h-96 items-center justify-center rounded-lg p-6 lg:col-span-full">
        <SalePingWidget />
      </div>
    </SectionGrid>
  </section>
</BaseLayout>
