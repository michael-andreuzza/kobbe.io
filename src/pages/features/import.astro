---
/**
 * Feature page for importing analytics history on the 12 column grid: the
 * hero with the sources linking to their guides and three widget tiles below
 * it, then what carries over beside what starts fresh. Every claim maps to
 * /docs/import-analytics-data and the per-provider guides.
 */
import type { ImageMetadata } from "astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandLogo from "@/components/foundations/BrandLogo.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import GridHero from "@/components/sections/GridHero.astro";
import ImportHistoryWidget from "@/components/widgets/ImportHistoryWidget.astro";
import ImportMergeWidget from "@/components/widgets/ImportMergeWidget.astro";
import ImportUploadWidget from "@/components/widgets/ImportUploadWidget.astro";
import { Button } from "@/components/ui/button";

const logos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/brands/*.svg",
  { eager: true },
);
const logo = (file: string) => logos[`/src/images/brands/${file}`]!.default;

const sources: { label: string; slug: string; file?: string }[] = [
  { label: "Plausible", slug: "plausible" },
  { label: "Fathom", slug: "fathom" },
  { label: "Umami", slug: "umami" },
  { label: "DataFast", slug: "datafast" },
  { label: "Google Analytics", slug: "google-analytics", file: "googleanalytics" },
  { label: "Matomo", slug: "matomo" },
  { label: "Simple Analytics", slug: "simple-analytics", file: "simpleanalytics" },
  { label: "PostHog", slug: "posthog" },
  { label: "Cloudflare", slug: "cloudflare-web-analytics", file: "cloudflare" },
  { label: "Pirsch", slug: "pirsch" },
];

const features = [
  {
    lead: "Upload and done",
    body: "Upload a full export ZIP, connect Google Analytics, or paste an API key. Kobbe imports in the background.",
    widget: ImportUploadWidget,
  },
  {
    lead: "Live data stays safe",
    body: "Fill gaps only imports the days before your first Kobbe pageview, so nothing live is overwritten.",
    widget: ImportMergeWidget,
  },
  {
    lead: "One continuous history",
    body: "Old traffic shows in the same charts and breakdowns as everything Kobbe collects from now on.",
    widget: ImportHistoryWidget,
  },
];

const lists = [
  {
    label: "Comes with you",
    items: [
      "Visitors, visits, and pageviews by day",
      "Bounces and session duration",
      "Pages and referrers",
      "Countries, regions, and cities",
      "Devices, browsers, and OS",
      "Daily custom event totals",
    ],
  },
  {
    label: "Starts fresh in Kobbe",
    items: [
      "Hourly and realtime history",
      "Funnels and visitor journeys",
      "Revenue attribution",
      "Goals, re-enabled in Conversions",
    ],
  },
];
---

<BaseLayout
  title="Import your analytics: bring your Google Analytics, Plausible, Matomo, and other history"
  description="Move your history from Google Analytics, Plausible, PostHog, Fathom, Umami, Matomo, Cloudflare, Pirsch, Simple Analytics, or DataFast into Kobbe. Old traffic sits next to new data, and live days are never overwritten."
  jsonLdBreadcrumbs={[
    { name: "Features", item: "/features" },
    { name: "Import", item: "/features/import" },
  ]}
>
  <GridHero
    lead="Data import,"
    title="from ten analytics tools, with your history intact."
    heading="Switch without losing history"
    subtitle="Bring your traffic from Google Analytics, Plausible, Matomo, Fathom, and more, and see it next to everything Kobbe collects from day one."
  >
    <ul class="flex flex-wrap gap-5" aria-label="Import from">
      {
        sources.map((source) => (
          <li>
            <a
              href={`/docs/import-from-${source.slug}`}
              title={source.label}
              aria-label={source.label}
              class="block transition-opacity hover:opacity-70"
            >
              <BrandLogo
                src={logo(`${source.file ?? source.slug}.svg`).src}
                class="size-6 rounded-sm object-contain"
                width={24}
                height={24}
              />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-10">
      <Button
        label="How importing works"
        href="#how-it-works"
        variant="muted"
        arrow
      />
    </div>
    <ul
      slot="full"
      id="how-it-works"
      class="grid scroll-mt-24 gap-x-8 gap-y-12 md:grid-cols-3 lg:col-span-full lg:grid-cols-subgrid"
      role="list"
    >
      {
        features.map((feature) => (
          <li class="lg:col-span-4">
            <div class="bg-muted-surface flex h-96 items-center justify-center rounded-lg p-6">
              <feature.widget />
            </div>
            <Text tag="h3" variant="textBase" class="mt-6 font-medium">
              {feature.lead}
            </Text>
            <Text tag="p" variant="textSM" class="text-muted-foreground mt-1 max-w-sm text-pretty">
              {feature.body}
            </Text>
          </li>
        ))
      }
    </ul>
  </GridHero>

  <section>
    <SectionGrid lead="Your history," title="what carries over, and what starts fresh." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          What comes with you
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
          Imports bring daily totals, so reports work right away. From Umami,
          only the daily totals come over for now.
        </Text>
      </div>
      <div class="mt-6 grid gap-x-8 gap-y-12 sm:grid-cols-2">
        {
          lists.map((list) => (
            <div>
              <Text tag="h3" variant="textSM" class="text-muted-foreground">
                {list.label}
              </Text>
              <ul class="mt-3" role="list">
                {list.items.map((item) => (
                  <li class="border-border text-foreground border-t py-4 text-base font-medium">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </SectionGrid>
  </section>
</BaseLayout>
