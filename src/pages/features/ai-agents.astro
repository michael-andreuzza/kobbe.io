---
/**
 * Feature page for the Kobbe MCP on the 12 column grid: the hero with the
 * agents it works with and three widget tiles below it, the full list of
 * abilities, and the three setup steps as cards. Every claim maps to a real MCP tool or token scope in
 * /docs/ai-agents.
 */
import type { ImageMetadata } from "astro";

import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandLogo from "@/components/foundations/BrandLogo.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import GridHero from "@/components/sections/GridHero.astro";
import AgentAnswerWidget from "@/components/widgets/AgentAnswerWidget.astro";
import AgentFunnelWidget from "@/components/widgets/AgentFunnelWidget.astro";
import AgentScopesWidget from "@/components/widgets/AgentScopesWidget.astro";
import { Button } from "@/components/ui/button";

const logos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/brands/*.svg",
  { eager: true },
);
const logo = (file: string) => logos[`/src/images/brands/${file}`]!.default;

const agents = [
  { label: "Claude", file: "claude.svg" },
  { label: "Cursor", file: "cursor.svg" },
  { label: "Codex", file: "codex.svg" },
  { label: "GitHub Copilot", file: "copilot.svg" },
  { label: "Windsurf", file: "windsurf.svg" },
  { label: "Zed", file: "zed.svg" },
  { label: "OpenCode", file: "opencode.svg" },
  { label: "Roo Code", file: "roo code.svg" },
];

const features = [
  {
    lead: "Ask in plain English",
    body: "Your agent reads your traffic, sources, pages, and revenue, and answers with your own numbers.",
    widget: AgentAnswerWidget,
  },
  {
    lead: "It sets things up, too",
    body: "Ask for a goal or a funnel and it creates it. It can also add a site and check the install.",
    widget: AgentFunnelWidget,
  },
  {
    lead: "You decide what it can touch",
    body: "Tokens are scoped and revocable, and deleting anything always asks for typed confirmation.",
    widget: AgentScopesWidget,
  },
];

const abilities = [
  "See who is on your site right now",
  "Pull traffic, sources, and top pages",
  "Chart traffic over any date range",
  "Split visitors by country, device, or browser",
  "Break down revenue by page and campaign",
  "Report on your UTM campaigns",
  "Count custom events and their properties",
  "Check how your goals convert",
  "Create goals and funnels for you",
  "Add a site and check the install",
  "Rotate a site's tracker token",
  "Suggest what to fix next",
];

const steps = [
  {
    title: "Create a token",
    body: "Profile menu → Agent access. Pick the scopes it needs.",
  },
  {
    title: "Log in with the CLI",
    body: "Run kobbe login with your token, or set KOBBE_TOKEN.",
  },
  {
    title: "Add it to your agent",
    body: "Point any MCP client at kobbe mcp, and start asking.",
  },
];
---

<BaseLayout
  title="Kobbe for AI agents: ask your analytics in plain English"
  description="Connect Kobbe to Claude, Cursor, Codex, or any MCP agent. Ask about traffic and revenue in plain English, and let it set up goals and funnels for you."
  jsonLdBreadcrumbs={[
    { name: "Features", item: "/features" },
    { name: "AI agents", item: "/features/ai-agents" },
  ]}
>
  <GridHero
    lead="AI agents,"
    title="through MCP, in Claude, Cursor, and more."
    heading="Just ask your agent"
    subtitle="Ask about your traffic and revenue in plain English, and let it set up goals and funnels for you."
  >
    <ul class="flex flex-wrap gap-5" aria-label="Works with">
      {
        agents.map((agent) => (
          <li title={agent.label}>
            <BrandLogo
              src={logo(agent.file).src}
              alt={agent.label}
              class="size-6 rounded-sm object-contain"
              width={24}
              height={24}
            />
          </li>
        ))
      }
    </ul>
    <div class="mt-10">
      <Button
        label="Connect your agent"
        href="/docs/ai-agents"
        variant="muted"
        arrow
      />
    </div>
    <ul
      slot="full"
      class="grid gap-x-8 gap-y-12 md:grid-cols-3 lg:col-span-full lg:grid-cols-subgrid"
      role="list"
    >
      {
        features.map((feature) => (
          <li class="lg:col-span-4">
            <div class="bg-muted-surface flex h-96 items-center justify-center rounded-lg p-6">
              <feature.widget />
            </div>
            <Text tag="h3" variant="textBase" class="mt-6 font-medium">
              {feature.lead}
            </Text>
            <Text tag="p" variant="textSM" class="text-muted-foreground mt-1 max-w-sm text-pretty">
              {feature.body}
            </Text>
          </li>
        ))
      }
    </ul>
  </GridHero>

  <section>
    <SectionGrid lead="Every tool," title="each one a real tool in the Kobbe MCP." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          Everything it can do
        </Text>
      </div>
      <ul class="mt-6 grid gap-x-8 sm:grid-cols-2" role="list">
        {
          abilities.map((ability) => (
            <li class="border-border text-foreground border-t py-4 text-base font-medium">
              {ability}
            </li>
          ))
        }
      </ul>
    </SectionGrid>
  </section>

  <section>
    <SectionGrid lead="Setup," title="works with any MCP client." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          Set up in three steps
        </Text>
      </div>
      <div>
        <Button
          label="Read the setup guide"
          href="/docs/ai-agents#mcp-setup"
          variant="muted"
          arrow
        />
      </div>
      <ol
        slot="full"
        class="grid gap-4 md:grid-cols-3 lg:col-span-full lg:grid-cols-subgrid lg:gap-x-8"
        role="list"
      >
        {
          steps.map((step, index) => (
            <li class="bg-muted-surface flex flex-col justify-between gap-12 rounded-lg p-6 sm:p-8 lg:col-span-4">
              <Text tag="span" variant="textSM" class="text-muted-foreground tabular-nums">
                Step {index + 1}
              </Text>
              <div>
                <Text tag="h3" variant="textBase" class="font-medium">
                  {step.title}
                </Text>
                <Text tag="p" variant="textSM" class="text-muted-foreground mt-1 text-pretty">
                  {step.body}
                </Text>
              </div>
            </li>
          ))
        }
      </ol>
    </SectionGrid>
  </section>
</BaseLayout>
