---
/**
 * Feature page for cookieless analytics on the 12 column grid: the hero with
 * three widget tiles below it, then what Kobbe never collects beside what
 * still works.
 * Every claim maps to
 * /docs/privacy-and-cookieless-tracking and
 * /docs/first-party-collect.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import GridHero from "@/components/sections/GridHero.astro";
import CollectHostWidget from "@/components/widgets/CollectHostWidget.astro";
import CookielessHashWidget from "@/components/widgets/CookielessHashWidget.astro";
import CookielessStorageWidget from "@/components/widgets/CookielessStorageWidget.astro";
import { Button } from "@/components/ui/button";

const features = [
  {
    lead: "Nothing in the browser",
    body: "The default tracker sets no cookies, uses no browser storage to measure, and never fingerprints.",
    widget: CookielessStorageWidget,
  },
  {
    lead: "Uniques without profiles",
    body: "Same-day visitors are counted with an anonymous hash whose secret rotates every day.",
    widget: CookielessHashWidget,
  },
  {
    lead: "Collect on your own domain",
    body: "Serve the tracker from a subdomain you control, like data.example.com. Included on every plan.",
    widget: CollectHostWidget,
  },
];

const lists = [
  {
    label: "Never collected",
    items: [
      "Analytics cookies",
      "Raw IP addresses",
      "Query strings",
      "Browser fingerprints",
      "Names or emails",
      "Visits with GPC or DNT on",
      "One browser across weeks",
    ],
  },
  {
    label: "Still works",
    items: [
      "Visits and unique visitors",
      "Pages, sources, and campaigns",
      "Locations, devices, and browsers",
      "Events, goals, and funnels",
    ],
  },
];
---

<BaseLayout
  title="Cookieless analytics: no cookies, no profiles"
  description="Kobbe counts visits, sources, and conversions without cookies, browser storage, or fingerprinting. No raw IPs, no profiles, and first-party collect on your own domain."
  jsonLdBreadcrumbs={[
    { name: "Features", item: "/features" },
    { name: "Cookieless analytics", item: "/features/cookieless-analytics" },
  ]}
>
  <GridHero
    lead="Cookieless analytics,"
    title="with no banner and no personal data stored."
    heading="Analytics without cookies"
    subtitle="Kobbe counts visits, sources, and conversions without cookies, browser storage, or fingerprinting, and never builds visitor profiles."
  >
    <div class="mt-8 flex flex-wrap gap-2">
      <Button
        label="How it works"
        href="#how-it-works"
        variant="muted"
        arrow
      />
      <Button
        label="Read the docs"
        href="/docs/privacy-and-cookieless-tracking"
        variant="ghost"
        arrow
      />
    </div>
    <ul
      slot="full"
      id="how-it-works"
      class="grid scroll-mt-24 gap-x-8 gap-y-12 md:grid-cols-3 lg:col-span-full lg:grid-cols-subgrid"
      role="list"
    >
      {
        features.map((feature) => (
          <li class="lg:col-span-4">
            <div class="bg-muted-surface flex h-96 items-center justify-center rounded-lg p-6">
              <feature.widget />
            </div>
            <Text tag="h3" variant="textBase" class="mt-6 font-medium">
              {feature.lead}
            </Text>
            <Text tag="p" variant="textSM" class="text-muted-foreground mt-1 max-w-sm text-pretty">
              {feature.body}
            </Text>
          </li>
        ))
      }
    </ul>
  </GridHero>

  <section>
    <SectionGrid lead="Your data," title="what is collected, and what never is." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          What Kobbe never collects
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
          Built for aggregate analytics, not tracking people. You give up
          following one browser across weeks, and that is the point.
        </Text>
      </div>
      <div class="mt-6 grid gap-x-8 gap-y-12 sm:grid-cols-2">
        {
          lists.map((list) => (
            <div>
              <Text tag="h3" variant="textSM" class="text-muted-foreground">
                {list.label}
              </Text>
              <ul class="mt-3" role="list">
                {list.items.map((item) => (
                  <li class="border-border text-foreground border-t py-4 text-base font-medium">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </SectionGrid>
  </section>
</BaseLayout>
