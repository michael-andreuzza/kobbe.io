---
/**
 * Feature page for bot filtering on the 12 column grid: the hero with the
 * dashboard's Bots tab below it, three widget tiles for how the filtering
 * behaves, and every check a request has to pass. Every claim maps to /docs/bot-filtering.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionGrid from "@/components/foundations/containers/SectionGrid.astro";
import Text from "@/components/foundations/elements/Text.astro";
import GridHero from "@/components/sections/GridHero.astro";
import ScreenshotPanel from "@/components/sections/ScreenshotPanel.astro";
import BotAutomationWidget from "@/components/widgets/BotAutomationWidget.astro";
import BotPeopleWidget from "@/components/widgets/BotPeopleWidget.astro";
import BotSilentWidget from "@/components/widgets/BotSilentWidget.astro";
import { Button } from "@/components/ui/button";
import botFiltering from "@/images/features/bot-filtering.png";

const features = [
  {
    lead: "Caught by how they behave",
    body: "Headless Chrome with a normal user agent still reports navigator.webdriver, and Kobbe drops it.",
    widget: BotAutomationWidget,
  },
  {
    lead: "Real people always count",
    body: "VPN and iCloud Private Relay users count normally. Rented cloud servers don't.",
    widget: BotPeopleWidget,
  },
  {
    lead: "Bots get no signal",
    body: "Filtered requests still get a success response, so there is nothing to adapt to.",
    widget: BotSilentWidget,
  },
];

const checks = [
  "Verified crawlers",
  "Known bot signatures",
  "HTTP tools like curl",
  "Browser automation",
  "Datacenter traffic",
  "Referrer spam",
  "Missing user agent",
];
---

<BaseLayout
  title="Bot filtering: keep bots out of your analytics"
  description="Kobbe checks every request for bot signals before anything is stored. Crawlers, scrapers, and headless browsers never reach your stats or your quota."
  jsonLdBreadcrumbs={[
    { name: "Features", item: "/features" },
    { name: "Bot filtering", item: "/features/bot-filtering" },
  ]}
>
  <GridHero
    lead="Bot filtering,"
    title="on every request, with nothing to set up."
    heading="Only people in your stats"
    subtitle="Kobbe checks every request for bot signals before anything is stored. Crawlers, scrapers, and headless browsers never count, and there is nothing to set up."
  >
    <div class="mt-8 flex flex-wrap gap-2">
      <Button
        label="How it works"
        href="#how-it-works"
        variant="muted"
        arrow
      />
      <Button
        label="Read the docs"
        href="/docs/bot-filtering"
        variant="ghost"
        arrow
      />
    </div>
    <ScreenshotPanel slot="full" src={botFiltering} alt="The Bots tab on the Kobbe dashboard: hits kept out of your stats, their share of requests, and the count for each filter reason" />
  </GridHero>

  <section id="how-it-works">
    <SectionGrid lead="How it works," title="by how and where a request runs." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          Built for modern scrapers
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
          They run real browsers and rotate IPs, so Kobbe checks how and where
          they run.
        </Text>
      </div>
      <ul
        slot="full"
        class="grid gap-x-8 gap-y-12 md:grid-cols-3 lg:col-span-full lg:grid-cols-subgrid"
        role="list"
      >
        {
          features.map((feature) => (
            <li class="lg:col-span-4">
              <div class="bg-muted-surface flex h-96 items-center justify-center rounded-lg p-6">
                <feature.widget />
              </div>
              <Text tag="h3" variant="textBase" class="mt-6 font-medium">
                {feature.lead}
              </Text>
              <Text tag="p" variant="textSM" class="text-muted-foreground mt-1 max-w-sm text-pretty">
                {feature.body}
              </Text>
            </li>
          ))
        }
      </ul>
    </SectionGrid>
  </section>

  <section>
    <SectionGrid lead="Every check," title="and a hit only counts when it passes all of them." class="py-24">
      <div class="flex flex-col gap-2">
        <Text tag="h2" variant="displayMD" class="font-medium tracking-tight leading-tight text-pretty lg:text-balance">
          Every request, every check
        </Text>
        <Text tag="p" variant="textBase" class="text-muted-foreground max-w-md leading-relaxed text-pretty">
          Filtered hits are dropped before anything is stored, and never touch
          your quota.
        </Text>
      </div>
      <ul class="mt-6 grid gap-x-8 sm:grid-cols-2" role="list">
        {
          checks.map((check) => (
            <li class="border-border text-foreground border-t py-4 text-base font-medium">
              {check}
            </li>
          ))
        }
      </ul>
    </SectionGrid>
  </section>
</BaseLayout>
